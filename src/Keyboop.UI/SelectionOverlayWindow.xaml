<Window x:Class="Keyboop.UI.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Исправить раскладку"
        Width="540"
        SizeToContent="Height"
        MaxHeight="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown">
    <Border Background="#F3131A25"
            BorderBrush="#465779"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="8"
                              Opacity="0.5"
                              Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Исправить раскладку"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Выберите вариант — текст изменится только после подтверждения"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="Esc — отмена"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Margin="0,18,0,14"
                    Padding="12"
                    CornerRadius="8"
                    Background="#0D131E"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Исходный текст"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="SourceTextBlock"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               MaxHeight="90"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <ListBox x:Name="CandidateList"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Candidates}"
                     SelectionChanged="CandidateList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2B2448" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14"
                                CornerRadius="10"
                                Background="#1B2535"
                                BorderBrush="#32415C"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="7"
                                        Background="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Number}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="15" />
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,2,0,7"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               MaxHeight="76"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="↑ ↓ — выбор    Enter — применить    1/2 — быстрый выбор"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
