<Window x:Class="Keyboop.UI.DictationIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboop — диктовка"
        Width="112"
        Height="42"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Topmost="True">
    <Grid>
        <Border x:Name="Pill"
                Background="Transparent"
                BorderBrush="#FF2C2F31"
                BorderThickness="1.25"
                CornerRadius="10"
                SnapsToDevicePixels="True" />

        <Border x:Name="Body"
                Margin="3"
                Background="#FF272727"
                CornerRadius="7"
                Padding="9.4,0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Waveform"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border x:Name="Bar0" Width="2" Height="4" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar1" Width="2" Height="6" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar2" Width="2" Height="9" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar3" Width="2" Height="12" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar4" Width="2" Height="15" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar5" Width="2" Height="15" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar6" Width="2" Height="12" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar7" Width="2" Height="9" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar8" Width="2" Height="6" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                    <Border x:Name="Bar9" Width="2" Height="4" Margin="1.5,0" CornerRadius="1" Background="#FFFFD400" VerticalAlignment="Center" />
                </StackPanel>

                <Border x:Name="StopDisc"
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        Margin="10,0,0,0"
                        CornerRadius="6"
                        Background="#FFFFD400"
                        VerticalAlignment="Center">
                    <Border x:Name="StatusGlyph"
                            Width="7"
                            Height="7"
                            CornerRadius="2"
                            Background="#FF111214"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
