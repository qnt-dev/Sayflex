{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sayflex.dev/schemas/smoke-evidence-v1.json",
  "title": "SayFlex witnessed smoke evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "git_commit",
    "installer_sha256",
    "witnessed_utc",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "SayFlex" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "installer_sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "witnessed_utc": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dictation_editor": { "$ref": "#/$defs/result" },
        "dictation_browser": { "$ref": "#/$defs/result" },
        "dictation_terminal": { "$ref": "#/$defs/result" },
        "clipboard_delayed_image_firefox": { "$ref": "#/$defs/result" },
        "clipboard_delayed_image_telegram": { "$ref": "#/$defs/result" },
        "translation_popup": { "$ref": "#/$defs/result" },
        "translation_orig": { "$ref": "#/$defs/result" },
        "translation_dual": { "$ref": "#/$defs/result" },
        "translation_pin_resize": { "$ref": "#/$defs/result" },
        "translation_multi_pin": { "$ref": "#/$defs/result" },
        "translation_click_away": { "$ref": "#/$defs/result" },
        "translation_quota_fallback": { "$ref": "#/$defs/result" },
        "translation_bad_key": { "$ref": "#/$defs/result" },
        "translation_no_providers": { "$ref": "#/$defs/result" },
        "translation_timeout": { "$ref": "#/$defs/result" },
        "translation_unsupported_pair": { "$ref": "#/$defs/result" },
        "translation_empty_source": { "$ref": "#/$defs/result" },
        "translation_ctrl_enter": { "$ref": "#/$defs/result" },
        "translation_copy": { "$ref": "#/$defs/result" },
        "translation_swap": { "$ref": "#/$defs/result" },
        "microphone_switch": { "$ref": "#/$defs/result" },
        "provider_fallback": { "$ref": "#/$defs/result" },
        "settings_wheel_touchpad_rail": { "$ref": "#/$defs/result" },
        "recording_visuals": { "$ref": "#/$defs/result" },
        "screen_translation_capture": { "$ref": "#/$defs/result" },
        "screen_translation_orig_dual": { "$ref": "#/$defs/result" },
        "screen_translation_on_image": { "$ref": "#/$defs/result" },
        "screen_translation_edit_save_retry": { "$ref": "#/$defs/result" },
        "screen_translation_glossary_rules": { "$ref": "#/$defs/result" },
        "screen_translation_context_fallback": { "$ref": "#/$defs/result" },
        "screen_translation_retention": { "$ref": "#/$defs/result" },
        "screen_translation_monitor_dpi": { "$ref": "#/$defs/result" },
        "screen_translation_ocr_restart": { "$ref": "#/$defs/result" },
        "resource_release_reload": { "$ref": "#/$defs/result" },
        "resource_game_budget": { "$ref": "#/$defs/result" },
        "gpu_counters_localized": { "$ref": "#/$defs/result" },
        "fresh_install": { "$ref": "#/$defs/result" },
        "upgrade_install": { "$ref": "#/$defs/result" }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
