import { AboutSlint, ListView, TextEdit } from "std-widgets.slint";

// The settings window is a document and is drawn as one; the overlays below sit
// on top of other people's applications and keep their own material. Splitting
// them apart is what lets each be judged on its own terms.
import { SettingsWindow } from "settings.slint";
import { ModelRow, ProviderRow, HistoryRow, HotkeyRow } from "rows.slint";
import { Fact } from "parts.slint";
import { MenuOption } from "controls.slint";

export { SettingsWindow, ModelRow, ProviderRow, HistoryRow, HotkeyRow, Fact, MenuOption }

export struct SlateLine {
    x: float,
    width: float,
    y: float,
    opacity: float,
    glow: float,
    color-index: int,
}

export struct TranslationPair {
    source: string,
    translation: string,
}

global Theme {
    out property <brush> ink: #101114;
    out property <brush> sidebar: #0c0d10;
    out property <brush> panel: #16181c;
    out property <brush> panel-raised: #1d2025;
    out property <brush> line: #2b2e34;
    out property <brush> line-soft: #22252a;
    out property <brush> text: #f3f3f4;
    out property <brush> text-muted: #a3a6ad;
    out property <brush> text-faint: #747881;
    out property <brush> orange: #e39952;
    out property <brush> orange-soft: #e399521c;
    out property <brush> red: #d85c5c;
    out property <brush> red-soft: #d85c5c1c;
    out property <brush> acrylic: #101114e8;
    out property <brush> glass: #0c0e12c4;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    border-radius: 6px;
    border-width: 1px;
    border-color: root.accent
        ? Theme.orange
        : root.danger
            ? Theme.red
            : Theme.line;
    opacity: root.enabled ? 1 : 0.42;
    background: touch.pressed
        ? (root.accent
            ? #c98242
            : root.danger
                ? #c6423d
                : #242b33)
        : touch.has-hover
            ? (root.accent
                ? #eda866
                : root.danger
                    ? #e66b6b
                    : Theme.panel-raised)
            : (root.accent
                ? Theme.orange
                : root.danger
                    ? Theme.red
                    : Theme.panel);

    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.label;
        color: root.accent || root.danger ? Theme.ink : Theme.text;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component Eyebrow inherits Text {
    color: Theme.orange;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.8px;
    vertical-alignment: center;
}

export component RecordingIndicator inherits Window {
    in property <string> indicator-title: "SayFlex Recording Indicator";
    title: root.indicator-title;
    icon: @image-url("../assets/tray-icon.svg");
    width: root.visualizer-style == 6
        ? 128px
        : root.visualizer-style == 5
            ? 116px
            : root.visualizer-style == 4
                ? 92px
                : 118px;
    height: root.visualizer-style == 6
        ? 154px
        : root.visualizer-style == 5
            ? 116px
            : root.visualizer-style == 4
                ? 92px
                : 42px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <[float]> bar-heights;
    in property <[float]> spectrum-heights;
    in property <int> visualizer-style: 0;
    in property <int> circular-palette: 0;
    in property <image> flow-sphere-frame;
    in property <[SlateLine]> slate-lines;
    in property <int> writing-slate-surface: 0;
    property <bool> writing-slate-blue-glass: root.writing-slate-surface == 2;
    in property <image> writing-slate-glass-backdrop;
    in property <bool> processing: false;
    in property <float> signal-opacity: 0.54;
    in property <float> disc-opacity: 1;
    in property <float> orb-size: 12;
    in property <float> orb-glow: 0.24;
    in property <float> ribbon-y1: 9.5;
    in property <float> ribbon-y2: 9.5;
    in property <float> ribbon-y3: 9.5;
    in property <float> ribbon-y4: 9.5;
    in property <float> mic-edge-height: 5;
    in property <float> mic-outer-height: 7;
    in property <float> mic-middle-height: 9;
    in property <float> mic-inner-height: 6;
    in property <float> mic-near-height: 7;
    in property <float> visual-scale: 1;
    in property <float> visual-opacity: 1;
    in-out property <bool> prepared: false;

    Rectangle {
        border-radius: root.visualizer-style >= 4 ? 18px : 10px;
        background: root.visualizer-style >= 4 ? transparent : #2c2f31;
        opacity: root.prepared ? root.visual-opacity : 0;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.visual-scale;

        Rectangle {
            x: root.visualizer-style >= 4 ? 0px : 3px;
            y: root.visualizer-style >= 4 ? 0px : 3px;
            width: parent.width - (root.visualizer-style >= 4 ? 0px : 6px);
            height: parent.height - (root.visualizer-style >= 4 ? 0px : 6px);
            border-radius: root.visualizer-style >= 4 ? 16px : 7px;
            background: root.visualizer-style >= 4 ? transparent : #272727;

            if root.visualizer-style == 5 : Image {
                source: root.flow-sphere-frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }

            if root.visualizer-style == 6 : Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Rectangle {
                    x: root.writing-slate-surface != 0 ? 0px : 2px;
                    y: root.writing-slate-surface != 0 ? 0px : 4px;
                    width: root.writing-slate-surface != 0 ? parent.width : parent.width - 4px;
                    height: root.writing-slate-surface != 0 ? parent.height : parent.height - 5px;
                    border-radius: 7px;
                    background: #000000;
                    opacity: root.writing-slate-surface != 0 ? 0 : 0.28;
                }

                Rectangle {
                    x: root.writing-slate-surface != 0 ? 0px : 3px;
                    y: root.writing-slate-surface != 0 ? 0px : 3px;
                    width: root.writing-slate-surface != 0 ? parent.width : parent.width - 6px;
                    height: root.writing-slate-surface != 0 ? parent.height : parent.height - 6px;
                    border-radius: 6px;
                    border-width: 0px;
                    background: root.writing-slate-blue-glass
                        ? @linear-gradient(145deg,
                            rgba(84, 188, 235, 0.055) 0%,
                            rgba(8, 30, 51, 0.012) 46%,
                            rgba(77, 191, 238, 0.042) 100%)
                        : root.writing-slate-surface == 1 ? #73777e4d : #181b21f5;

                    Rectangle {
                        x: root.writing-slate-blue-glass ? 0px : root.writing-slate-surface == 1 ? 0px : 3px;
                        y: root.writing-slate-blue-glass ? 0px : root.writing-slate-surface == 1 ? 0px : 3px;
                        width: root.writing-slate-blue-glass
                            ? parent.width
                            : root.writing-slate-surface == 1 ? parent.width : parent.width - 6px;
                        height: root.writing-slate-blue-glass
                            ? parent.height
                            : root.writing-slate-surface == 1 ? parent.height : parent.height - 6px;
                        border-radius: root.writing-slate-blue-glass
                            ? 6px
                            : root.writing-slate-surface == 1 ? 6px : 4px;
                        background: root.writing-slate-blue-glass
                            ? transparent
                            : root.writing-slate-surface == 1 ? transparent : #0b0e13f5;
                        border-width: 0px;
                        clip: true;

                        if root.writing-slate-blue-glass : Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.writing-slate-glass-backdrop;
                            image-fit: fill;
                        }

                        if root.writing-slate-blue-glass : Image {
                            width: parent.width;
                            height: parent.height;
                            source: @image-url("../assets/slate-blue-glass-wash.svg");
                            image-fit: fill;
                            opacity: 0.25;
                        }

                        if root.writing-slate-surface != 0 : Image {
                            width: parent.width;
                            height: parent.height;
                            source: @image-url("../assets/slate-matte-grain.svg");
                            image-fit: fill;
                            opacity: root.writing-slate-blue-glass ? 0.10 : 1;
                        }

                        for line in root.slate-lines : Rectangle {
                            x: 11px + line.x * 1px;
                            y: 11px + line.y * 1px;
                            width: line.width * 1px + 2px;
                            height: 5.5px;
                            border-radius: 2px;
                            background: line.color-index == 0
                                ? #ef5048
                                : line.color-index == 1
                                    ? #ffd24a
                                    : #ece9e1;
                            opacity: line.glow * 0.2;
                        }

                        for line in root.slate-lines : Rectangle {
                            x: 12px + line.x * 1px;
                            y: 12px + line.y * 1px;
                            width: line.width * 1px;
                            height: 3.5px;
                            border-radius: 1px;
                            background: line.color-index == 0
                                ? #ef5048
                                : line.color-index == 1
                                    ? #ffd24a
                                    : #ece9e1;
                            opacity: line.opacity;
                        }
                    }
                }
            }

            HorizontalLayout {
                visible: root.visualizer-style != 5 && root.visualizer-style != 6;
                y: (parent.height - self.height) / 2;
                height: root.visualizer-style == 4 ? 88px : 19px;
                padding-left: root.visualizer-style >= 4 ? 0px : 9px;
                padding-right: root.visualizer-style >= 4 ? 0px : 7px;
                alignment: center;
                spacing: 3px;

                if root.visualizer-style == 0 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    Rectangle {
                        width: root.orb-size * 1px + 9px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: #ffd400;
                        opacity: root.orb-glow * 0.34;
                    }

                    Rectangle {
                        width: root.orb-size * 1px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: #ffd400;
                        opacity: root.signal-opacity;

                        Rectangle {
                            width: parent.width * 0.28;
                            height: self.width;
                            x: parent.width * 0.24;
                            y: parent.height * 0.18;
                            border-radius: self.width / 2;
                            background: #fff4a3;
                            opacity: 0.52;
                        }
                    }
                }

                if root.visualizer-style == 1 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 3px;
                        alignment: center;

                        for bar-height in root.bar-heights : Rectangle {
                            width: 2px;
                            height: 19px;
                            background: transparent;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 2px;
                                height: bar-height * 1px;
                                border-radius: 1px;
                                background: #ffd400;
                                opacity: root.signal-opacity;
                            }
                        }
                    }
                }

                if root.visualizer-style == 2 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 56;
                        viewbox-height: 19;
                        fill: transparent;
                        stroke: #ffd400;
                        stroke-width: 2.2px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        opacity: root.signal-opacity;
                        MoveTo { x: 0; y: root.ribbon-y1; }
                        CubicTo {
                            control-1-x: 5; control-1-y: root.ribbon-y1;
                            control-2-x: 10; control-2-y: root.ribbon-y2;
                            x: 17; y: root.ribbon-y2;
                        }
                        CubicTo {
                            control-1-x: 23; control-1-y: root.ribbon-y2;
                            control-2-x: 27; control-2-y: root.ribbon-y3;
                            x: 35; y: root.ribbon-y3;
                        }
                        CubicTo {
                            control-1-x: 42; control-1-y: root.ribbon-y3;
                            control-2-x: 49; control-2-y: root.ribbon-y4;
                            x: 56; y: root.ribbon-y4;
                        }
                    }
                }

                if root.visualizer-style == 3 : Rectangle {
                    width: 78px;
                    height: 19px;
                    background: transparent;

                    // Five voice-reactive lines on each side. The heights are
                    // mirrored so the tiny surface stays calm and legible.
                    Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-edge-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.58;
                    }
                    Rectangle {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-outer-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.72;
                    }
                    Rectangle {
                        x: 12px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-middle-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.86;
                    }
                    Rectangle {
                        x: 18px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-inner-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity;
                    }
                    Rectangle {
                        x: 24px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-near-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.94;
                    }

                    Rectangle {
                        x: 52px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-near-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.94;
                    }
                    Rectangle {
                        x: 58px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-inner-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity;
                    }
                    Rectangle {
                        x: 64px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-middle-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.86;
                    }
                    Rectangle {
                        x: 70px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-outer-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.72;
                    }
                    Rectangle {
                        x: 76px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-edge-height * 1px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: root.signal-opacity * 0.58;
                    }

                    // Capsule and short stem only: the reference's stand and
                    // horizontal base deliberately do not belong in the overlay.
                    Rectangle {
                        x: 33px;
                        y: 0px;
                        width: 12px;
                        height: 15px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #ffd400;
                        background: #171819;

                        Rectangle {
                            x: 3px;
                            y: 4px;
                            width: 6px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: #ffd400;
                            opacity: 0.78;
                        }
                        Rectangle {
                            x: 3px;
                            y: 7px;
                            width: 6px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: #ffd400;
                            opacity: 0.78;
                        }
                        Rectangle {
                            x: 3px;
                            y: 10px;
                            width: 6px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: #ffd400;
                            opacity: 0.78;
                        }
                    }
                    Rectangle {
                        x: 38px;
                        y: 15px;
                        width: 2px;
                        height: 4px;
                        border-radius: 1px;
                        background: #ffd400;
                        opacity: 0.92;
                    }
                }

                if root.visualizer-style == 4 : Rectangle {
                    width: 88px;
                    height: 88px;
                    background: transparent;

                    // A restrained native glow approximates the reference without
                    // embedding video, shaders, or a blur pass.
                    // Soft duplicate bars provide a low-cost halo.
                    for band-height[index] in root.spectrum-heights : Rectangle {
                        width: 4px;
                        height: band-height * 1px + 3px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - 22.5px - self.height;
                        border-radius: self.width / 2;
                        background: root.circular-palette == 1
                            ? index < 4 ? #7df5ff
                                : index < 9 ? #35d9ff
                                : index < 14 ? #1590ff
                                : index < 20 ? #315dff
                                : index < 26 ? #1578ff
                                : #49d7ff
                            : root.circular-palette == 2
                                ? #323940
                                : index < 3 ? #ffad21
                                    : index < 7 ? #ff6220
                                    : index < 12 ? #ff16b7
                                    : index < 18 ? #ff087b
                                    : index < 24 ? #ff1847
                                    : index < 28 ? #ff361b
                                    : #ff7c12;
                        opacity: root.circular-palette == 2
                            ? 0.18 + root.signal-opacity * 0.18
                            : root.signal-opacity * 0.18;
                        transform-origin: {
                            x: self.width / 2,
                            y: parent.height / 2 - self.y,
                        };
                        transform-rotation: index * 11.25deg;
                    }

                    for band-height[index] in root.spectrum-heights : Rectangle {
                        width: 2.2px;
                        height: band-height * 1px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - 22.5px - self.height;
                        border-radius: self.width / 2;
                        background: root.circular-palette == 1
                            ? index < 4 ? #7df5ff
                                : index < 9 ? #35d9ff
                                : index < 14 ? #1590ff
                                : index < 20 ? #315dff
                                : index < 26 ? #1578ff
                                : #49d7ff
                            : root.circular-palette == 2
                                ? Math.mod(index, 7) == 0 ? #f4f6f8
                                    : Math.mod(index, 7) == 1 ? #89939e
                                    : Math.mod(index, 7) == 2 ? #56616d
                                    : Math.mod(index, 7) == 3 ? #aeb6bf
                                    : Math.mod(index, 7) == 4 ? #69747f
                                    : Math.mod(index, 7) == 5 ? #5b6671
                                    : #d8dde2
                                : index < 3 ? #ffad21
                                    : index < 7 ? #ff6220
                                    : index < 12 ? #ff16b7
                                    : index < 18 ? #ff087b
                                    : index < 24 ? #ff1847
                                    : index < 28 ? #ff361b
                                    : #ff7c12;
                        opacity: 0.72 + root.signal-opacity * 0.28;
                        transform-origin: {
                            x: self.width / 2,
                            y: parent.height / 2 - self.y,
                        };
                        transform-rotation: index * 11.25deg;
                    }
                }

                if root.visualizer-style < 3 : Rectangle {
                    width: 4px;
                    height: 19px;
                    background: transparent;
                }

                if root.visualizer-style < 3 : Rectangle {
                    width: 18px;
                    height: 19px;
                    background: transparent;

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 6px;
                        background: #ffd400;
                        opacity: root.disc-opacity;

                        Rectangle {
                            width: root.processing ? 5px : 7px;
                            height: root.processing ? 5px : 7px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: root.processing ? 2.5px : 2px;
                            background: #111214;
                        }
                    }
                }
            }
        }
    }
}

export component SelectionChooser inherits Window {
    title: "Correct keyboard layout";
    width: 590px;
    height: 117px + root.source-panel-height * 1px + root.candidate-labels.length * 61px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <string> source-text;
    in-out property <bool> prepared: false;
    in-out property <float> source-panel-height: 52;
    in property <[string]> candidate-labels;
    in property <[string]> candidate-texts;
    callback choose-candidate(int);
    callback cancel();

    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.acrylic;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 18px;
            spacing: 9px;

            HorizontalLayout {
                height: 24px;
                vertical-stretch: 0;
                Text {
                    text: "Correct keyboard layout";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 720;
                }
                Rectangle { horizontal-stretch: 1; }
                Eyebrow { text: "SELECT A RESULT"; }
            }

            Rectangle {
                height: root.source-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    height: parent.height - 14px;
                    text: root.source-text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            for label[index] in root.candidate-labels : Rectangle {
                height: 52px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: option-touch.has-hover ? Theme.orange : Theme.line;
                background: option-touch.has-hover ? Theme.orange-soft : Theme.panel;

                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: label;
                            color: Theme.orange;
                            font-size: 9px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.candidate-texts[index];
                            color: Theme.text;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: "ENTER";
                        color: Theme.text-faint;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                option-touch := TouchArea {
                    clicked => {
                        root.choose-candidate(index);
                    }
                }
            }

            HorizontalLayout {
                height: 30px;
                vertical-stretch: 0;
                Text {
                    text: "Original selection remains active";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    width: 80px;
                    height: 30px;
                    label: "CANCEL";
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
    }
}

export component ActionPalette inherits Window {
    title: "Text actions";
    icon: @image-url("../assets/tray-icon.svg");
    width: 520px;
    height: 115px + root.source-panel-height * 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <string> source-text;
    in-out property <bool> prepared: false;
    in-out property <float> source-panel-height: 54;
    in property <bool> translation-enabled: false;
    in property <bool> layout-enabled: true;
    callback translate();
    callback correct-layout();
    callback cancel();

    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.acrylic;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 17px;
            spacing: 9px;

            HorizontalLayout {
                height: 23px;
                vertical-stretch: 0;
                Text {
                    text: "Text actions";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 720;
                }
                Rectangle { horizontal-stretch: 1; }
                Eyebrow { text: "CTRL + ALT + T"; }
            }

            Rectangle {
                height: root.source-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    height: parent.height - 14px;
                    text: root.source-text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                height: 40px;
                vertical-stretch: 0;
                spacing: 7px;
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "TRANSLATE";
                    accent: true;
                    enabled: root.translation-enabled;
                    clicked => { root.translate(); }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "CORRECT LAYOUT";
                    enabled: root.layout-enabled;
                    clicked => { root.correct-layout(); }
                }
                ActionButton {
                    width: 74px;
                    height: 40px;
                    label: "CANCEL";
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}

export component TranslationPreview inherits Window {
    // Kept for diagnostics and accessibility only. The window is frameless, so
    // no title or chrome is rendered to the user.
    title: "Translation preview";
    preferred-width: root.card-width * 1px;
    preferred-height: root.main-card-height * 1px
        + (root.view-mode == 1 ? root.original-card-height * 1px + 18px : 0px);
    min-width: 252px;
    min-height: root.preferred-height;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in-out property <string> request-id;
    in-out property <bool> prepared: false;
    in-out property <string> source-text;
    in-out property <string> translated-text;
    in-out property <[TranslationPair]> dual-pairs;
    // 0 = translated result, 1 = original companion card, 2 = interleaved.
    in-out property <int> view-mode: 0;
    in-out property <bool> pinned: false;
    in-out property <bool> live-glass: false;
    in-out property <bool> dark-text: false;
    in-out property <int> blur-radius: 3;
    in-out property <float> card-width: 252;
    in property <image> glass-backdrop;
    in-out property <float> original-card-height: 96;
    out property <float> dual-content-height:
        max(20px, dual-stack.preferred-height + 4px) / 1px;
    out property <float> result-content-height:
        root.view-mode == 2
            ? root.dual-content-height
            : max(20px, result-text.preferred-height + 4px) / 1px;
    out property <float> result-panel-height:
        min(252px, root.result-content-height * 1px) / 1px;
    out property <bool> result-scrollable:
        root.result-content-height * 1px > result-scroll.height + 0.5px;
    out property <float> result-scroll-offset: -result-scroll.viewport-y / 1px;
    out property <float> result-viewport-height: result-scroll.height / 1px;
    out property <float> main-card-height: 50 + root.result-panel-height;
    callback begin-drag();
    callback begin-resize(int);
    callback pin-state-changed(bool);
    callback view-mode-changed(int);
    callback reset-scroll();
    callback scroll-by(float);
    reset-scroll => {
        result-scroll.viewport-y = 0px;
    }
    scroll-by(delta) => {
        if (root.result-scrollable) {
            result-scroll.viewport-y = max(
                result-scroll.height - result-scroll.viewport-height,
                min(0px, result-scroll.viewport-y + (delta / 120) * 48px)
            );
        }
    }

    if root.view-mode == 1: original-card := Rectangle {
        x: 5px;
        y: 6px;
        width: parent.width - 10px;
        height: root.original-card-height * 1px;
        border-radius: 9px;
        border-width: 0px;
        clip: true;
        opacity: root.prepared ? 1 : 0;
        background: @linear-gradient(145deg,
            rgba(65, 150, 196, 0.065) 0%,
            rgba(8, 24, 39, 0.14) 48%,
            rgba(58, 148, 195, 0.05) 100%);

        Image {
            width: parent.width;
            height: parent.height;
            source: root.glass-backdrop;
            image-fit: fill;
            opacity: root.live-glass ? 0 : 1;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(145deg,
                rgba(65, 150, 196, 0.065) 0%,
                rgba(8, 24, 39, 0.14) 48%,
                rgba(58, 148, 195, 0.05) 100%);
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-blue-glass-wash.svg");
            image-fit: fill;
            opacity: 0.14;
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-matte-grain.svg");
            image-fit: fill;
            opacity: 0.06;
        }
        original-text := Text {
            x: 14px;
            y: 19px;
            width: parent.width - 28px;
            height: parent.height - 32px;
            text: root.source-text;
            color: root.dark-text ? #111820 : #f5f3ef;
            font-size: 13px;
            font-weight: 460;
            wrap: word-wrap;
            vertical-alignment: top;
        }

        TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.begin-drag();
                }
            }
        }
    }

    main-card := Rectangle {
        x: root.view-mode == 1 ? 5px : 0px;
        y: root.view-mode == 1 ? root.original-card-height * 1px + 18px : 0px;
        width: parent.width - (root.view-mode == 1 ? 10px : 0px);
        height: parent.height - self.y - (root.view-mode == 1 ? 6px : 0px);
        border-radius: 9px;
        border-width: 0px;
        background: @linear-gradient(145deg,
            rgba(65, 150, 196, 0.075) 0%,
            rgba(8, 24, 39, 0.16) 48%,
            rgba(58, 148, 195, 0.06) 100%);
        clip: true;
        opacity: root.prepared ? 1 : 0;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.glass-backdrop;
            image-fit: fill;
            opacity: root.live-glass ? 0 : 1;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(145deg,
                rgba(65, 150, 196, 0.075) 0%,
                rgba(8, 24, 39, 0.16) 48%,
                rgba(58, 148, 195, 0.06) 100%);
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-blue-glass-wash.svg");
            image-fit: fill;
            opacity: 0.16;
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-matte-grain.svg");
            image-fit: fill;
            opacity: 0.07;
        }

        orig-button := Rectangle {
            x: 14px;
            y: 7px;
            width: 44px;
            height: 24px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.view-mode == 1
                ? Theme.red
                : root.dark-text ? #10182070 : #d7d3cc48;
            background: root.view-mode == 1
                ? Theme.red
                : orig-touch.has-hover
                    ? Theme.red-soft
                    : root.dark-text ? #ffffff42 : #0c0f1450;

            Text {
                text: "ORIG";
                color: root.view-mode == 1 ? #0b0e13 : root.dark-text ? #111820 : #dedad3;
                opacity: root.view-mode == 1 ? 1 : (orig-touch.has-hover ? 0.92 : 0.62);
                font-size: 9px;
                font-weight: 680;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            orig-touch := TouchArea {
                clicked => {
                    root.view-mode = root.view-mode == 1 ? 0 : 1;
                    root.reset-scroll();
                    root.view-mode-changed(root.view-mode);
                }
            }
        }

        dual-button := Rectangle {
            x: 64px;
            y: 7px;
            width: 44px;
            height: 24px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.view-mode == 2
                ? Theme.red
                : root.dark-text ? #10182070 : #d7d3cc48;
            background: root.view-mode == 2
                ? Theme.red
                : dual-touch.has-hover
                    ? Theme.red-soft
                    : root.dark-text ? #ffffff42 : #0c0f1450;

            Text {
                text: "DUAL";
                color: root.view-mode == 2 ? #0b0e13 : root.dark-text ? #111820 : #dedad3;
                opacity: root.view-mode == 2 ? 1 : (dual-touch.has-hover ? 0.92 : 0.62);
                font-size: 9px;
                font-weight: 680;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            dual-touch := TouchArea {
                clicked => {
                    root.view-mode = root.view-mode == 2 ? 0 : 2;
                    root.reset-scroll();
                    root.view-mode-changed(root.view-mode);
                }
            }
        }

        result-scroll := Flickable {
            x: 14px;
            y: 38px;
            // Always reserve the scrollbar gutter. Changing the width when the
            // scrollbar appears would reflow the text and create a
            // height/scroll feedback loop while a streamed result grows.
            width: parent.width - self.x - 20px;
            height: parent.height - self.y - 12px;
            viewport-width: self.width;
            viewport-height: root.result-content-height * 1px;

            result-text := Text {
                visible: root.view-mode != 2;
                width: result-scroll.width;
                height: root.result-content-height * 1px;
                text: root.translated-text;
                color: root.dark-text ? #111820 : #f5f3ef;
                font-size: 14px;
                font-weight: 470;
                wrap: word-wrap;
                vertical-alignment: top;
            }

            dual-stack := VerticalLayout {
                visible: root.view-mode == 2;
                width: result-scroll.width;
                spacing: 0px;

                for pair[index] in root.dual-pairs: VerticalLayout {
                    width: parent.width;
                    spacing: 5px;
                    padding-bottom: index + 1 < root.dual-pairs.length ? 10px : 0px;

                    Text {
                        width: parent.width;
                        text: pair.source;
                        color: root.dark-text ? #111820 : #f5f3ef;
                        font-size: 13px;
                        font-weight: 610;
                        wrap: word-wrap;
                    }
                    Text {
                        width: parent.width;
                        text: pair.translation;
                        color: root.dark-text ? #27333f : #d7dbe0;
                        font-size: 14px;
                        font-weight: 450;
                        wrap: word-wrap;
                    }
                    if index + 1 < root.dual-pairs.length: Rectangle {
                        width: parent.width;
                        height: 1px;
                        background: transparent;

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            width: 96px;
                            height: 1px;
                            background: Theme.red;
                            opacity: 0.62;
                        }
                    }
                }
            }
        }

        if root.result-scrollable: Rectangle {
            x: parent.width - 8px;
            y: 38px;
            width: 2px;
            height: root.result-panel-height * 1px;
            border-radius: 1px;
            background: root.dark-text ? #f4f6f880 : #080a0d80;

            Rectangle {
                width: 2px;
                height: parent.height * (result-scroll.height / result-scroll.viewport-height) < 20px
                    ? 20px
                    : parent.height * (result-scroll.height / result-scroll.viewport-height);
                y: (-result-scroll.viewport-y / (result-scroll.viewport-height - result-scroll.height))
                    * (parent.height - self.height);
                border-radius: 1px;
                background: Theme.red;
                opacity: 0.7;
            }
        }

        // The header is also the drag handle. It sits above the text so the
        // first press is never consumed by the content layer; the pin remains
        // outside this exact hit area.
        drag-area := TouchArea {
            x: 114px;
            y: 0;
            width: parent.width - self.x - 54px;
            height: 36px;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.begin-drag();
                }
            }
        }

        pin-button := Rectangle {
            x: parent.width - 52px;
            y: 7px;
            width: 44px;
            height: 24px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.pinned
                ? Theme.red
                : root.dark-text ? #10182070 : #d7d3cc48;
            background: root.pinned
                ? Theme.red
                : pin-touch.has-hover
                    ? Theme.red-soft
                    : root.dark-text ? #ffffff42 : #0c0f1450;

            Text {
                text: "PIN";
                color: root.pinned ? #0b0e13 : root.dark-text ? #111820 : #dedad3;
                opacity: root.pinned ? 1 : (pin-touch.has-hover ? 0.92 : 0.62);
                font-size: 10px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            pin-touch := TouchArea {
                clicked => {
                    root.pinned = !root.pinned;
                    root.pin-state-changed(root.pinned);
                }
            }
        }
    }

    if root.pinned: TouchArea {
        x: 0;
        y: 7px;
        width: 7px;
        height: parent.height - 14px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(0);
            }
        }
    }
    if root.pinned: TouchArea {
        x: parent.width - 7px;
        y: 7px;
        width: 7px;
        height: parent.height - 14px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(1);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 7px;
        y: 0;
        width: parent.width - 14px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(2);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 7px;
        y: parent.height - 7px;
        width: parent.width - 14px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(3);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 0;
        y: 0;
        width: 7px;
        height: 7px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(4);
            }
        }
    }
    if root.pinned: TouchArea {
        x: parent.width - 7px;
        y: 0;
        width: 7px;
        height: 7px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(5);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 0;
        y: parent.height - 7px;
        width: 7px;
        height: 7px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(6);
            }
        }
    }
    if root.pinned: TouchArea {
        x: parent.width - 7px;
        y: parent.height - 7px;
        width: 7px;
        height: 7px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(7);
            }
        }
    }
}

export component TranslatorWindow inherits Window {
    title: "Local translator";
    icon: @image-url("../assets/tray-icon.svg");
    width: 740px;
    height: 590px;
    background: Theme.ink;
    default-font-family: "Segoe UI Variable Text";

    in-out property <string> source-text;
    in-out property <string> result-text;
    in-out property <string> status-text: "Choose a translation model in Settings.";
    in-out property <bool> processing: false;
    callback translate();
    callback copy-result();
    callback swap-text();

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 22px;
        spacing: 10px;

        HorizontalLayout {
            height: 48px;
            vertical-stretch: 0;
            VerticalLayout {
                spacing: 1px;
                Eyebrow { height: 13px; text: "LOCAL TRANSLATOR"; }
                Text {
                    text: "English ↔ Russian";
                    color: Theme.text;
                    font-size: 21px;
                    font-weight: 740;
                }
                Text {
                    text: "Direction is detected automatically";
                    color: Theme.text-muted;
                    font-size: 9px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton {
                width: 104px;
                height: 32px;
                label: "SWAP TEXT";
                clicked => { root.swap-text(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            TextEdit {
                x: 11px;
                y: 9px;
                width: parent.width - 22px;
                height: parent.height - 18px;
                text <=> root.source-text;
                wrap: word-wrap;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.processing ? Theme.line : Theme.orange;
            background: root.processing ? Theme.panel : Theme.orange-soft;
            Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                text: root.processing ? "Translating locally…" : root.result-text;
                color: root.processing ? Theme.text-muted : Theme.text;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            height: 36px;
            vertical-stretch: 0;
            spacing: 7px;
            Text {
                text: root.status-text;
                color: Theme.text-muted;
                font-size: 9px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton {
                width: 104px;
                label: "COPY RESULT";
                enabled: !root.processing && root.result-text != "";
                clicked => { root.copy-result(); }
            }
            ActionButton {
                width: 110px;
                label: "TRANSLATE";
                accent: true;
                enabled: !root.processing;
                clicked => { root.translate(); }
            }
        }
    }

}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray-icon.svg");
    tooltip: "SayFlex";

    callback open-settings();
    callback open-translator();
    callback copy-last();
    callback quit-requested();

    clicked => {
        root.open-settings();
    }

    Menu {
        MenuItem {
            title: "Open settings";
            activated => {
                root.open-settings();
            }
        }
        MenuItem {
            title: "Open translator";
            activated => {
                root.open-translator();
            }
        }
        MenuItem {
            title: "Copy latest transcript";
            activated => {
                root.copy-last();
            }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => {
                root.quit-requested();
            }
        }
    }
}
