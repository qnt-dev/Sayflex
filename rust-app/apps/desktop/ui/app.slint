import { AboutSlint, ListView, TextEdit } from "std-widgets.slint";

export struct ModelRow {
    title: string,
    detail: string,
    state: string,
    selected: bool,
}

export struct HistoryRow {
    text: string,
    detail: string,
}

global Theme {
    out property <brush> ink: #101114;
    out property <brush> sidebar: #0c0d10;
    out property <brush> panel: #16181c;
    out property <brush> panel-raised: #1d2025;
    out property <brush> line: #2b2e34;
    out property <brush> line-soft: #22252a;
    out property <brush> text: #f3f3f4;
    out property <brush> text-muted: #a3a6ad;
    out property <brush> text-faint: #747881;
    out property <brush> orange: #e39952;
    out property <brush> orange-soft: #e399521c;
    out property <brush> red: #d85c5c;
    out property <brush> red-soft: #d85c5c1c;
    out property <brush> acrylic: #101114e8;
    out property <brush> glass: #0c0e12c4;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    border-radius: 6px;
    border-width: 1px;
    border-color: root.accent
        ? Theme.orange
        : root.danger
            ? Theme.red
            : Theme.line;
    opacity: root.enabled ? 1 : 0.42;
    background: touch.pressed
        ? (root.accent
            ? #c98242
            : root.danger
                ? #c6423d
                : #242b33)
        : touch.has-hover
            ? (root.accent
                ? #eda866
                : root.danger
                    ? #e66b6b
                    : Theme.panel-raised)
            : (root.accent
                ? Theme.orange
                : root.danger
                    ? Theme.red
                    : Theme.panel);

    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.label;
        color: root.accent || root.danger ? Theme.ink : Theme.text;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 16px;
    font-weight: 650;
    vertical-alignment: center;
}

component Eyebrow inherits Text {
    color: Theme.orange;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.8px;
    vertical-alignment: center;
}

component StatusDot inherits Rectangle {
    in property <bool> active: false;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: root.active ? Theme.orange : Theme.red;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 42px;
    border-radius: 7px;
    background: root.active
        ? Theme.panel-raised
        : touch.has-hover
            ? Theme.panel
            : #00000000;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 0;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: root.active ? Theme.orange : #00000000;
    }

    Text {
        x: 16px;
        width: parent.width - 28px;
        text: root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 13px;
        font-weight: root.active ? 620 : 500;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> action;
    in property <bool> active: false;
    callback clicked();

    height: 68px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.line-soft;
    background: touch.has-hover ? Theme.panel-raised : Theme.ink;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 18px;

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: root.detail;
                color: Theme.text-faint;
                font-size: 10px;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: action-text.preferred-width + 24px;
            height: 30px;
            border-radius: 5px;
            border-width: 1px;
            border-color: root.active ? Theme.orange : Theme.line;
            background: root.active ? Theme.orange-soft : Theme.panel;

            action-text := Text {
                x: 10px;
                width: parent.width - 20px;
                text: root.action;
                color: root.active ? Theme.orange : Theme.text-muted;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    title: "Rust Voice";
    icon: @image-url("../assets/tray-icon.svg");
    width: 1000px;
    height: 720px;
    background: Theme.ink;
    default-font-family: "Segoe UI Variable Text";

    in-out property <int> active-page: 0;
    in-out property <string> runtime-status: "Starting workers…";
    in-out property <string> indicator-status: "Idle";
    in-out property <string> output-mode-label: "Output: original language";
    in-out property <string> release-optimization-label: "Release optimization: fastest";
    in-out property <string> visualizer-label: "Visualizer: Voice Orb";
    in property <[ModelRow]> model-rows;
    in property <[ModelRow]> translation-model-rows;
    in property <[HistoryRow]> history-rows;
    in-out property <string> translation-enabled-label: "Translation: disabled";
    in-out property <string> layout-enabled-label: "Layout correction: enabled";
    in-out property <string> text-action-mode-label: "Ctrl+Alt+T: adaptive";
    in-out property <string> translation-delivery-label: "Translation result: preview";
    in-out property <string> translation-warm-label: "Warm engine: on (fastest)";
    in-out property <string> history-enabled-label: "History: enabled";
    in-out property <bool> translation-ready: false;

    callback select-model(int);
    callback select-translation-model(int);
    callback refresh-history();
    callback copy-history(int);
    callback toggle-output-mode();
    callback toggle-release-optimization();
    callback cycle-visualizer();
    callback toggle-translation-enabled();
    callback toggle-layout-enabled();
    callback cycle-text-action-mode();
    callback cycle-translation-delivery();
    callback toggle-translation-warm();
    callback open-translator();
    callback toggle-history-enabled();
    callback clear-history();
    callback quit-requested();

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        Rectangle {
            width: 214px;
            horizontal-stretch: 0;
            background: Theme.sidebar;
            border-width: 0px;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.line-soft;
            }

            VerticalLayout {
                x: 14px;
                y: 18px;
                width: parent.width - 28px;
                height: parent.height - 36px;
                spacing: 4px;

                VerticalLayout {
                    height: 72px;
                    vertical-stretch: 0;
                    spacing: 3px;

                    Text {
                        text: "Rust Voice";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        height: 20px;
                        vertical-stretch: 0;
                        spacing: 7px;
                        StatusDot {
                            active: root.runtime-status != "Starting workers…"
                                && root.runtime-status != "Worker error";
                        }
                        Text {
                            text: root.runtime-status;
                            color: Theme.text-faint;
                            font-size: 10px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }

                NavItem {
                    label: "Overview";
                    active: root.active-page == 0;
                    clicked => { root.active-page = 0; }
                }
                NavItem {
                    label: "Speech";
                    active: root.active-page == 1;
                    clicked => { root.active-page = 1; }
                }
                NavItem {
                    label: "Text tools";
                    active: root.active-page == 2;
                    clicked => { root.active-page = 2; }
                }
                NavItem {
                    label: "Translation";
                    active: root.active-page == 3;
                    clicked => { root.active-page = 3; }
                }
                NavItem {
                    label: "History";
                    active: root.active-page == 4;
                    clicked => {
                        root.active-page = 4;
                        root.refresh-history();
                    }
                }
                NavItem {
                    label: "About";
                    active: root.active-page == 5;
                    clicked => { root.active-page = 5; }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    height: 68px;
                    vertical-stretch: 0;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    background: Theme.panel;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        Text {
                            text: "Local by default";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Audio and text stay on this device.";
                            color: Theme.text-faint;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                    }
                }

                ActionButton {
                    height: 34px;
                    vertical-stretch: 0;
                    label: "Quit Rust Voice";
                    danger: true;
                    clicked => { root.quit-requested(); }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: 34px;
            padding-right: 34px;
            padding-top: 26px;
            padding-bottom: 24px;
            spacing: 16px;

        HorizontalLayout {
            height: 68px;
            vertical-stretch: 0;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.active-page == 0 ? "Overview"
                        : root.active-page == 1 ? "Speech"
                        : root.active-page == 2 ? "Text tools"
                        : root.active-page == 3 ? "Translation"
                        : root.active-page == 4 ? "History"
                        : "About";
                    color: Theme.text;
                    font-size: 25px;
                    font-weight: 700;
                }
                Text {
                    text: root.active-page == 0
                        ? "Your shortcuts and the current state of the local engine."
                        : root.active-page == 1
                            ? "Choose the local model that matches this computer."
                            : root.active-page == 2
                                ? "Control what happens when you act on selected text."
                                : root.active-page == 3
                                    ? "Manage local translation models and result delivery."
                                    : root.active-page == 4
                                        ? "Reuse recent dictations without recording them again."
                                        : "A fast, local-first voice and text utility built with Rust.";
                    color: Theme.text-muted;
                    font-size: 12px;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: status-text.preferred-width + 38px;
                height: 32px;
                border-radius: 7px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    StatusDot {
                        active: root.runtime-status != "Starting workers…"
                            && root.runtime-status != "Worker error";
                    }
                    status-text := Text {
                        text: root.runtime-status;
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.active-page == 0 : HorizontalLayout {
            height: 132px;
            vertical-stretch: 0;
            spacing: 12px;

            Rectangle {
                horizontal-stretch: 6;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.orange-soft;

                HorizontalLayout {
                    padding: 18px;
                    spacing: 18px;

                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 7px;
                        Eyebrow { height: 14px; text: "DICTATION"; }
                        Text {
                            text: "Hold Ctrl + Alt + Space";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 680;
                        }
                        Text {
                            text: root.indicator-status;
                            color: Theme.text-muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    ActionButton {
                        width: 218px;
                        height: 36px;
                        label: root.output-mode-label;
                        clicked => { root.toggle-output-mode(); }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 4;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;

                VerticalLayout {
                    padding: 17px;
                    spacing: 7px;
                    Eyebrow { height: 14px; text: "GLOBAL CONTROLS"; }
                    Text {
                        text: "Ctrl + Alt + V   ·   insert latest";
                        color: Theme.text;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Ctrl + Alt + T   ·   translate selection";
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                    Text {
                        text: "Ctrl + Alt + K   ·   correct layout";
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                }
            }
        }

        if root.active-page == 0 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            SectionTitle {
                height: 28px;
                vertical-stretch: 0;
                text: "Quick access";
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;

                VerticalLayout {
                    padding: 14px;
                    spacing: 9px;

                    SettingRow {
                        title: "Insert latest dictation";
                        detail: "Recover the newest completed transcript in the current app.";
                        action: "Ctrl + Alt + V";
                    }
                    SettingRow {
                        title: "Translate selected text";
                        detail: "Open the compact local translation preview immediately.";
                        action: "Ctrl + Alt + T";
                    }
                    SettingRow {
                        title: "Correct selected layout";
                        detail: "Convert selected text directly without opening the palette.";
                        action: "Ctrl + Alt + K";
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        Text {
                            text: "Need a full translator workspace?";
                            color: Theme.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            width: 146px;
                            height: 36px;
                            label: "Open translator";
                            accent: true;
                            clicked => { root.open-translator(); }
                        }
                    }
                }

                SettingRow {
                    height: 64px;
                    vertical-stretch: 0;
                    title: "Recording visualizer";
                    detail: "Choose Voice Orb, Symmetric Spectrum or Fluid Ribbon.";
                    action: root.visualizer-label;
                    active: true;
                    clicked => { root.cycle-visualizer(); }
                }
            }
        }

        if root.active-page == 1
            || root.active-page == 2
            || root.active-page == 3 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            if root.active-page == 1 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    SectionTitle { text: "Speech engine"; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "4 local performance profiles";
                        color: Theme.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        if root.model-rows.length == 0 : Text {
                            text: root.runtime-status == "Worker error"
                                ? "Speech worker is unavailable. Restart the app or inspect diagnostics."
                                : "Loading local speech profiles…";
                            color: root.runtime-status == "Worker error" ? Theme.red : Theme.text-faint;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        for row[index] in root.model-rows : Rectangle {
                            height: 72px;
                            vertical-stretch: 0;
                            border-radius: 7px;
                            border-width: 1px;
                            border-color: row.selected ? Theme.orange : Theme.line;
                            background: row.selected ? Theme.orange-soft : Theme.ink;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 12px;

                                Rectangle {
                                    width: 4px;
                                    height: 30px;
                                    border-radius: 1px;
                                    background: row.selected ? Theme.orange : Theme.line;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: row.title;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 650;
                                    }
                                    Text {
                                        text: row.detail;
                                        color: Theme.text-faint;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Text {
                                    width: 90px;
                                    text: row.state;
                                    color: row.selected ? Theme.orange : Theme.text-muted;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                ActionButton {
                                    width: 82px;
                                    height: 34px;
                                    label: row.selected ? "ACTIVE" : "USE";
                                    accent: !row.selected;
                                    enabled: !row.selected;
                                    clicked => { root.select-model(index); }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 68px;
                    vertical-stretch: 0;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Release latency";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 650;
                            }
                            Text {
                                text: "Prepare results during natural pauses. Efficient mode uses less GPU and battery.";
                                color: Theme.text-faint;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            width: 210px;
                            height: 34px;
                            label: root.release-optimization-label;
                            accent: root.release-optimization-label == "Release optimization: fastest";
                            clicked => { root.toggle-release-optimization(); }
                        }
                    }
                }
            }

            if root.active-page == 2 || root.active-page == 3 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                if root.active-page == 3 : HorizontalLayout {
                    height: 34px;
                    vertical-stretch: 0;
                    SectionTitle { text: "Translation"; }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        width: 138px;
                        height: 34px;
                        label: "Open translator";
                        accent: true;
                        clicked => { root.open-translator(); }
                    }
                }

                if root.active-page == 3 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        for row[index] in root.translation-model-rows : Rectangle {
                            height: 72px;
                            vertical-stretch: 0;
                            border-radius: 7px;
                            border-width: 1px;
                            border-color: row.selected ? Theme.orange : Theme.line;
                            background: row.selected ? Theme.orange-soft : Theme.ink;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: row.title;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 650;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.detail;
                                        color: Theme.text-faint;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    width: 86px;
                                    text: row.state;
                                    color: row.selected ? Theme.orange : Theme.text-muted;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    width: 86px;
                                    height: 34px;
                                    label: row.selected ? "ACTIVE" : (row.state == "Download" ? "GET" : "USE");
                                    accent: !row.selected;
                                    enabled: !row.selected;
                                    clicked => { root.select-translation-model(index); }
                                }
                            }
                        }
                    }
                }

                if root.active-page == 3 : VerticalLayout {
                    height: 146px;
                    vertical-stretch: 0;
                    spacing: 8px;

                    SettingRow {
                        title: "Translation shortcut";
                        detail: "Show a compact preview, then copy or replace the original selection.";
                        action: "Ctrl + Alt + T";
                    }
                    SettingRow {
                        title: "Warm translation engine";
                        detail: "Keep the selected model ready for the shortest response time.";
                        action: root.translation-warm-label;
                        active: root.translation-warm-label == "Warm engine: on (fastest)";
                        clicked => { root.toggle-translation-warm(); }
                    }
                }

                if root.active-page == 2 : HorizontalLayout {
                    height: 34px;
                    vertical-stretch: 0;
                    SectionTitle { text: "Selected-text actions"; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "Ctrl + Alt + T";
                        color: Theme.orange;
                        font-size: 11px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                }

                if root.active-page == 2 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        Text {
                            height: 48px;
                            text: "Translation and layout correction use dedicated shortcuts, so each action runs immediately.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        SettingRow {
                            title: "Translate selection";
                            detail: "Translate the selected text using the active local model.";
                            action: root.translation-enabled-label;
                            active: root.translation-enabled-label == "Translation: enabled";
                            clicked => { root.toggle-translation-enabled(); }
                        }
                        SettingRow {
                            title: "Correct keyboard layout";
                            detail: "Convert selected text between its likely keyboard layouts.";
                            action: root.layout-enabled-label;
                            active: root.layout-enabled-label == "Layout correction: enabled";
                            clicked => { root.toggle-layout-enabled(); }
                        }
                        SettingRow {
                            title: "Translation preview";
                            detail: "Open the local result in a compact focus-safe window.";
                            action: "Ctrl + Alt + T";
                        }
                    }
                }
            }
        }

        if root.active-page == 4 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                SectionTitle { text: "Recent dictations"; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    width: 132px;
                    height: 34px;
                    label: root.history-enabled-label;
                    clicked => { root.toggle-history-enabled(); }
                }
                ActionButton {
                    width: 72px;
                    height: 34px;
                    label: "Clear";
                    danger: true;
                    clicked => { root.clear-history(); }
                }
                ActionButton {
                    width: 78px;
                    height: 34px;
                    label: "Refresh";
                    clicked => { root.refresh-history(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;

                if root.history-rows.length == 0 : Text {
                    text: "Completed dictations appear here. History can be disabled at any time.";
                    color: Theme.text-faint;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if root.history-rows.length > 0 : ListView {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;

                    for row[index] in root.history-rows : Rectangle {
                        height: 62px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.ink;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: row.text;
                                    color: Theme.text;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.detail;
                                    color: Theme.text-faint;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            ActionButton {
                                width: 70px;
                                height: 34px;
                                label: "Copy";
                                clicked => { root.copy-history(index); }
                            }
                        }
                    }
                }
            }
        }

        if root.active-page == 5 : Rectangle {
            vertical-stretch: 1;
            border-radius: 9px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            VerticalLayout {
                x: 28px;
                y: 26px;
                width: parent.width - 56px;
                height: parent.height - 52px;
                spacing: 14px;

                Eyebrow {
                    height: 16px;
                    text: "RUST VOICE  ·  0.5.2";
                }
                Text {
                    height: 34px;
                    text: "Local tools for language and thought.";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 650;
                }
                Text {
                    height: 50px;
                    text: "Dictation, selected-text actions and translation run locally after you choose and download a model.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 1px;
                    vertical-stretch: 0;
                    background: Theme.line;
                }

                VerticalLayout {
                    height: 116px;
                    vertical-stretch: 0;
                    spacing: 9px;
                    Text {
                        text: "Privacy";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 620;
                    }
                    Text {
                        text: "No cloud account is required. Models are downloaded only when you choose them.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "History can be disabled or cleared from the History page.";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }

                VerticalLayout {
                    height: 128px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Text {
                        text: "Keyboard shortcuts";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 620;
                    }
                    Text { text: "Ctrl + Alt + Space   Dictate"; color: Theme.text-muted; font-size: 12px; }
                    Text { text: "Ctrl + Alt + V       Insert latest"; color: Theme.text-muted; font-size: 12px; }
                    Text { text: "Ctrl + Alt + T       Translate selection"; color: Theme.text-muted; font-size: 12px; }
                    Text { text: "Ctrl + Alt + K       Correct layout"; color: Theme.text-muted; font-size: 12px; }
                }

                Rectangle { vertical-stretch: 1; }

                AboutSlint {
                    width: 180px;
                    height: 76px;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;
                }
            }
        }
        }
    }
}

export component RecordingIndicator inherits Window {
    title: "Rust Recording Indicator";
    icon: @image-url("../assets/tray-icon.svg");
    width: 118px;
    height: 42px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <[float]> bar-heights;
    in property <int> visualizer-style: 0;
    in property <bool> processing: false;
    in property <float> signal-opacity: 0.54;
    in property <float> disc-opacity: 1;
    in property <float> orb-size: 12;
    in property <float> orb-glow: 0.24;
    in property <float> ribbon-y1: 9.5;
    in property <float> ribbon-y2: 9.5;
    in property <float> ribbon-y3: 9.5;
    in property <float> ribbon-y4: 9.5;
    in-out property <bool> prepared: false;

    Rectangle {
        border-radius: 10px;
        background: #2c2f31;
        opacity: root.prepared ? 1 : 0;

        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 7px;
            background: #272727;

            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                height: 19px;
                padding-left: 9px;
                padding-right: 7px;
                alignment: center;
                spacing: 3px;

                if root.visualizer-style == 0 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    Rectangle {
                        width: root.orb-size * 1px + 9px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: #ffd400;
                        opacity: root.orb-glow * 0.34;
                    }

                    Rectangle {
                        width: root.orb-size * 1px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: #ffd400;
                        opacity: root.signal-opacity;

                        Rectangle {
                            width: parent.width * 0.28;
                            height: self.width;
                            x: parent.width * 0.24;
                            y: parent.height * 0.18;
                            border-radius: self.width / 2;
                            background: #fff4a3;
                            opacity: 0.52;
                        }
                    }
                }

                if root.visualizer-style == 1 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 3px;
                        alignment: center;

                        for bar-height in root.bar-heights : Rectangle {
                            width: 2px;
                            height: 19px;
                            background: transparent;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 2px;
                                height: bar-height * 1px;
                                border-radius: 1px;
                                background: #ffd400;
                                opacity: root.signal-opacity;
                            }
                        }
                    }
                }

                if root.visualizer-style == 2 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 56;
                        viewbox-height: 19;
                        fill: transparent;
                        stroke: #ffd400;
                        stroke-width: 2.2px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        opacity: root.signal-opacity;
                        MoveTo { x: 0; y: root.ribbon-y1; }
                        CubicTo {
                            control-1-x: 5; control-1-y: root.ribbon-y1;
                            control-2-x: 10; control-2-y: root.ribbon-y2;
                            x: 17; y: root.ribbon-y2;
                        }
                        CubicTo {
                            control-1-x: 23; control-1-y: root.ribbon-y2;
                            control-2-x: 27; control-2-y: root.ribbon-y3;
                            x: 35; y: root.ribbon-y3;
                        }
                        CubicTo {
                            control-1-x: 42; control-1-y: root.ribbon-y3;
                            control-2-x: 49; control-2-y: root.ribbon-y4;
                            x: 56; y: root.ribbon-y4;
                        }
                    }
                }

                Rectangle {
                    width: 4px;
                    height: 19px;
                    background: transparent;
                }

                Rectangle {
                    width: 18px;
                    height: 19px;
                    background: transparent;

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 6px;
                        background: #ffd400;
                        opacity: root.disc-opacity;

                        Rectangle {
                            width: root.processing ? 5px : 7px;
                            height: root.processing ? 5px : 7px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: root.processing ? 2.5px : 2px;
                            background: #111214;
                        }
                    }
                }
            }
        }
    }
}

export component SelectionChooser inherits Window {
    title: "Correct keyboard layout";
    width: 590px;
    height: 117px + root.source-panel-height * 1px + root.candidate-labels.length * 61px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <string> source-text;
    in-out property <bool> prepared: false;
    in-out property <float> source-panel-height: 52;
    in property <[string]> candidate-labels;
    in property <[string]> candidate-texts;
    callback choose-candidate(int);
    callback cancel();

    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.acrylic;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 18px;
            spacing: 9px;

            HorizontalLayout {
                height: 24px;
                vertical-stretch: 0;
                Text {
                    text: "Correct keyboard layout";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 720;
                }
                Rectangle { horizontal-stretch: 1; }
                Eyebrow { text: "SELECT A RESULT"; }
            }

            Rectangle {
                height: root.source-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    height: parent.height - 14px;
                    text: root.source-text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            for label[index] in root.candidate-labels : Rectangle {
                height: 52px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: option-touch.has-hover ? Theme.orange : Theme.line;
                background: option-touch.has-hover ? Theme.orange-soft : Theme.panel;

                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: label;
                            color: Theme.orange;
                            font-size: 9px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.candidate-texts[index];
                            color: Theme.text;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: "ENTER";
                        color: Theme.text-faint;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                option-touch := TouchArea {
                    clicked => {
                        root.choose-candidate(index);
                    }
                }
            }

            HorizontalLayout {
                height: 30px;
                vertical-stretch: 0;
                Text {
                    text: "Original selection remains active";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    width: 80px;
                    height: 30px;
                    label: "CANCEL";
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
    }
}

export component ActionPalette inherits Window {
    title: "Text actions";
    icon: @image-url("../assets/tray-icon.svg");
    width: 520px;
    height: 115px + root.source-panel-height * 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <string> source-text;
    in-out property <bool> prepared: false;
    in-out property <float> source-panel-height: 54;
    in property <bool> translation-enabled: false;
    in property <bool> layout-enabled: true;
    callback translate();
    callback correct-layout();
    callback cancel();

    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.acrylic;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 17px;
            spacing: 9px;

            HorizontalLayout {
                height: 23px;
                vertical-stretch: 0;
                Text {
                    text: "Text actions";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 720;
                }
                Rectangle { horizontal-stretch: 1; }
                Eyebrow { text: "CTRL + ALT + T"; }
            }

            Rectangle {
                height: root.source-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    height: parent.height - 14px;
                    text: root.source-text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                height: 40px;
                vertical-stretch: 0;
                spacing: 7px;
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "TRANSLATE";
                    accent: true;
                    enabled: root.translation-enabled;
                    clicked => { root.translate(); }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "CORRECT LAYOUT";
                    enabled: root.layout-enabled;
                    clicked => { root.correct-layout(); }
                }
                ActionButton {
                    width: 74px;
                    height: 40px;
                    label: "CANCEL";
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}

export component TranslationPreview inherits Window {
    title: "Translation preview";
    icon: @image-url("../assets/tray-icon.svg");
    width: root.card-width * 1px;
    height: 103px + (root.source-panel-height + root.result-panel-height) * 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in-out property <string> request-id;
    in-out property <bool> prepared: false;
    in-out property <string> source-text;
    in-out property <string> translated-text;
    in-out property <string> direction-label: "Detecting language…";
    in-out property <bool> processing: true;
    in-out property <float> card-width: 420;
    in-out property <float> source-panel-height: 58;
    in-out property <float> result-panel-height: 68;
    in-out property <float> result-content-height: 52;
    in-out property <bool> result-scrollable: false;
    callback replace();
    callback copy();
    callback dismiss();

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: root.processing ? Theme.line : #e3995270;
        background: Theme.glass;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 14px;
            spacing: 7px;

            HorizontalLayout {
                height: 22px;
                vertical-stretch: 0;
                Text {
                    text: "Translation";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 720;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.direction-label;
                    color: root.processing ? Theme.text-muted : Theme.orange;
                    font-size: 8px;
                    font-weight: 650;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: root.source-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;
                background: #11141ac8;
                Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    height: parent.height - 12px;
                    text: root.source-text;
                    color: Theme.text-muted;
                    font-size: 9px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            Rectangle {
                height: root.result-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.processing ? Theme.line : Theme.orange;
                background: root.processing ? #11141ac8 : #e3995214;

                result-scroll := Flickable {
                    x: 10px;
                    y: 7px;
                    width: parent.width - (root.result-scrollable ? 26px : 20px);
                    height: parent.height - 16px;
                    viewport-width: self.width;
                    viewport-height: root.result-content-height * 1px;

                    Text {
                        width: result-scroll.width;
                        height: root.result-content-height * 1px;
                        text: root.translated-text;
                        color: root.processing ? Theme.text-muted : Theme.text;
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }

                if root.result-scrollable: Rectangle {
                    x: parent.width - 7px;
                    y: 7px;
                    width: 2px;
                    height: parent.height - 14px;
                    border-radius: 1px;
                    background: #050608a8;

                    Rectangle {
                        width: 2px;
                        height: parent.height * (result-scroll.height / result-scroll.viewport-height) < 22px
                            ? 22px
                            : parent.height * (result-scroll.height / result-scroll.viewport-height);
                        y: (-result-scroll.viewport-y / (result-scroll.viewport-height - result-scroll.height))
                            * (parent.height - self.height);
                        border-radius: 1px;
                        background: Theme.orange;
                        opacity: 0.72;
                    }
                }
            }

            HorizontalLayout {
                height: 31px;
                vertical-stretch: 0;
                spacing: 6px;
                Text {
                    text: "Local · focus-safe";
                    color: Theme.text-faint;
                    font-size: 8px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    width: 60px;
                    height: 31px;
                    label: "CLOSE";
                    clicked => { root.dismiss(); }
                }
                ActionButton {
                    width: 64px;
                    height: 31px;
                    label: "COPY";
                    enabled: !root.processing;
                    clicked => { root.copy(); }
                }
                ActionButton {
                    width: 82px;
                    height: 31px;
                    label: "REPLACE";
                    accent: true;
                    enabled: !root.processing;
                    clicked => { root.replace(); }
                }
            }
        }
    }
}

export component TranslatorWindow inherits Window {
    title: "Local translator";
    icon: @image-url("../assets/tray-icon.svg");
    width: 740px;
    height: 590px;
    background: Theme.ink;
    default-font-family: "Segoe UI Variable Text";

    in-out property <string> source-text;
    in-out property <string> result-text;
    in-out property <string> status-text: "Choose a translation model in Settings.";
    in-out property <bool> processing: false;
    callback translate();
    callback copy-result();
    callback swap-text();

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 22px;
        spacing: 10px;

        HorizontalLayout {
            height: 48px;
            vertical-stretch: 0;
            VerticalLayout {
                spacing: 1px;
                Eyebrow { height: 13px; text: "LOCAL TRANSLATOR"; }
                Text {
                    text: "English ↔ Russian";
                    color: Theme.text;
                    font-size: 21px;
                    font-weight: 740;
                }
                Text {
                    text: "Direction is detected automatically";
                    color: Theme.text-muted;
                    font-size: 9px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton {
                width: 104px;
                height: 32px;
                label: "SWAP TEXT";
                clicked => { root.swap-text(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            TextEdit {
                x: 11px;
                y: 9px;
                width: parent.width - 22px;
                height: parent.height - 18px;
                text <=> root.source-text;
                wrap: word-wrap;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.processing ? Theme.line : Theme.orange;
            background: root.processing ? Theme.panel : Theme.orange-soft;
            Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                text: root.processing ? "Translating locally…" : root.result-text;
                color: root.processing ? Theme.text-muted : Theme.text;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            height: 36px;
            vertical-stretch: 0;
            spacing: 7px;
            Text {
                text: root.status-text;
                color: Theme.text-muted;
                font-size: 9px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton {
                width: 104px;
                label: "COPY RESULT";
                enabled: !root.processing && root.result-text != "";
                clicked => { root.copy-result(); }
            }
            ActionButton {
                width: 110px;
                label: "TRANSLATE";
                accent: true;
                enabled: !root.processing;
                clicked => { root.translate(); }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray-icon.svg");
    tooltip: "Rust Voice";

    callback open-settings();
    callback open-translator();
    callback copy-last();
    callback quit-requested();

    clicked => {
        root.open-settings();
    }

    Menu {
        MenuItem {
            title: "Open settings";
            activated => {
                root.open-settings();
            }
        }
        MenuItem {
            title: "Open translator";
            activated => {
                root.open-translator();
            }
        }
        MenuItem {
            title: "Copy latest transcript";
            activated => {
                root.copy-last();
            }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => {
                root.quit-requested();
            }
        }
    }
}
