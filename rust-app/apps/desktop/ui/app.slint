import { ListView } from "std-widgets.slint";
import { Theme } from "overlay_theme.slint";

// The settings window is a document and is drawn as one; the overlays below sit
// on top of other people's applications and keep their own material. Splitting
// them apart is what lets each be judged on its own terms.
import { SettingsWindow } from "settings.slint";
import { SupportWindow } from "support.slint";
import { ModelRow, ProviderRow, HistoryRow, GlossaryRow, HotkeyRow, ResourceRow } from "rows.slint";
import { Fact } from "parts.slint";
import { MenuOption, RowAction } from "controls.slint";
import { Sheet } from "sheet.slint";
import { RecordingVisual, SlateLine } from "recording_visual.slint";
import { ScreenBlockOverlay, ScreenConnectorOverlay, ScreenTranslationPreviewWindow, ScreenTranslationWindow } from "screen_translation.slint";

export { Theme, SettingsWindow, SupportWindow, ModelRow, ProviderRow, HistoryRow, GlossaryRow, HotkeyRow, ResourceRow, Fact, MenuOption, SlateLine, ScreenBlockOverlay, ScreenConnectorOverlay, ScreenTranslationPreviewWindow, ScreenTranslationWindow }

export struct TranslationPair {
    source: string,
    translation: string,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    forward-focus: focus;
    height: 34px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    border-radius: 6px;
    border-width: 1px;
    border-color: root.accent
        ? Theme.orange
        : root.danger
            ? Theme.red
            : Theme.line;
    opacity: root.enabled ? 1 : 0.42;
    background: touch.pressed
        ? (root.accent
            ? #c98242
            : root.danger
                ? #c6423d
                : #242b33)
        : touch.has-hover
            ? (root.accent
                ? #eda866
                : root.danger
                    ? #e66b6b
                    : Theme.panel-raised)
            : (root.accent
                ? Theme.orange
                : root.danger
                    ? Theme.red
                    : Theme.panel);

    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.label;
        color: root.accent || root.danger ? Theme.ink : Theme.text;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component IconAction inherits Rectangle {
    in property <image> source;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    forward-focus: focus;
    width: 30px;
    height: 26px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Sheet.ink : Sheet.hairline;
    background: touch.has-hover && root.enabled ? Sheet.raised-strong : transparent;
    opacity: root.enabled ? 1 : 0.42;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    Image {
        x: 8px;
        y: 6px;
        width: 14px;
        height: 14px;
        source: root.source;
        image-fit: contain;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if touch.has-hover && root.enabled : Rectangle {
        z: 20;
        y: parent.height + 4px;
        x: parent.width - self.width;
        width: tooltip-text.preferred-width + 16px;
        height: 26px;
        background: Sheet.ink;
        tooltip-text := Text {
            text: root.label;
            color: Sheet.on-ink;
            font-size: Sheet.label-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Eyebrow inherits Text {
    color: Theme.orange;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.8px;
    vertical-alignment: center;
}

export component RecordingIndicator inherits Window {
    in property <string> indicator-title: @tr("SayFlex Recording Indicator");
    title: root.indicator-title;
    icon: @image-url("../assets/tray-icon.svg");
    width: root.visualizer-style == 9
        ? 128px
        : root.visualizer-style == 6
        ? 128px
        : root.visualizer-style == 5
            ? 116px
            : root.visualizer-style == 4
                ? 92px
                : 118px;
    height: root.visualizer-style == 9
        ? 128px
        : root.visualizer-style == 6
        ? 154px
        : root.visualizer-style == 5
            ? 116px
            : root.visualizer-style == 4
                ? 92px
                : 42px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <[float]> bar-heights;
    in property <[float]> spectrum-heights;
    in property <int> visualizer-style: 3;
    in property <int> circular-palette: 0;
    in property <int> broadcast-mic-palette: 0;
    in property <image> flow-sphere-frame;
    in property <image> pulse-matrix-frame;
    in property <[SlateLine]> slate-lines;
    in property <int> writing-slate-surface: 0;
    property <bool> writing-slate-blue-glass: root.writing-slate-surface == 2;
    in property <image> writing-slate-glass-backdrop;
    in property <bool> processing: false;
    in property <float> signal-opacity: 0.54;
    in property <float> disc-opacity: 1;
    in property <float> orb-size: 12;
    in property <float> orb-glow: 0.24;
    in property <float> ribbon-y1: 9.5;
    in property <float> ribbon-y2: 9.5;
    in property <float> ribbon-y3: 9.5;
    in property <float> ribbon-y4: 9.5;
    in property <float> mic-edge-height: 5;
    in property <float> mic-outer-height: 7;
    in property <float> mic-middle-height: 9;
    in property <float> mic-inner-height: 6;
    in property <float> mic-near-height: 7;
    in property <float> visual-scale: 1;
    in property <float> visual-opacity: 1;
    in-out property <bool> prepared: false;
    // Testable native-surface contract: styles from Broadcast Mic onward do
    // not use the opaque panel that belongs to the first three styles.
    out property <bool> transparent-surface: root.visualizer-style >= 3;

    RecordingVisual {
        width: 100%;
        height: 100%;
        bar-heights: root.bar-heights;
        spectrum-heights: root.spectrum-heights;
        visualizer-style: root.visualizer-style;
        circular-palette: root.circular-palette;
        broadcast-mic-palette: root.broadcast-mic-palette;
        flow-sphere-frame: root.flow-sphere-frame;
        pulse-matrix-frame: root.pulse-matrix-frame;
        slate-lines: root.slate-lines;
        writing-slate-surface: root.writing-slate-surface;
        writing-slate-glass-backdrop: root.writing-slate-glass-backdrop;
        processing: root.processing;
        signal-opacity: root.signal-opacity;
        disc-opacity: root.disc-opacity;
        orb-size: root.orb-size;
        orb-glow: root.orb-glow;
        ribbon-y1: root.ribbon-y1;
        ribbon-y2: root.ribbon-y2;
        ribbon-y3: root.ribbon-y3;
        ribbon-y4: root.ribbon-y4;
        mic-edge-height: root.mic-edge-height;
        mic-outer-height: root.mic-outer-height;
        mic-middle-height: root.mic-middle-height;
        mic-inner-height: root.mic-inner-height;
        mic-near-height: root.mic-near-height;
        visual-scale: root.visual-scale;
        visual-opacity: root.visual-opacity;
        prepared: root.prepared;
    }
}

export component SelectionChooser inherits Window {
    title: @tr("Correct keyboard layout");
    width: 458px;
    height: 62px + root.source-panel-height * 1px + root.candidate-labels.length * 56px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <string> source-text;
    in-out property <bool> prepared: false;
    in-out property <float> source-panel-height: 52;
    in property <[string]> candidate-labels;
    in property <[string]> candidate-texts;
    callback choose-candidate(int);
    callback cancel();

    Rectangle {
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.glass;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            HorizontalLayout {
                height: 24px;
                vertical-stretch: 0;
                Text {
                    text: @tr("Correct keyboard layout");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 680;
                }
                Rectangle { horizontal-stretch: 1; }
                close-action := Rectangle {
                    width: 26px;
                    height: 24px;
                    border-radius: 5px;
                    border-width: close-touch.has-hover ? 1px : 0px;
                    border-color: Theme.line;
                    background: close-touch.has-hover ? Theme.panel-raised : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Close");
                    accessible-enabled: true;
                    accessible-action-default => { root.cancel(); }

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Theme.text : Theme.text-muted;
                        font-size: 17px;
                        font-weight: 430;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel(); }
                    }
                }
            }

            Rectangle {
                height: root.source-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line-soft;
                background: #16181ca8;
                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    height: parent.height - 14px;
                    text: root.source-text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            for label[index] in root.candidate-labels : Rectangle {
                height: 48px;
                vertical-stretch: 0;
                border-radius: 6px;
                border-width: 1px;
                border-color: option-touch.has-hover ? Theme.orange : Theme.line;
                background: option-touch.pressed
                    ? #24272c
                    : option-touch.has-hover
                        ? Theme.orange-soft
                        : Theme.panel-raised;
                accessible-role: button;
                accessible-label: label;
                accessible-enabled: true;
                accessible-action-default => { root.choose-candidate(index); }

                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: label;
                            color: Theme.orange;
                            font-size: 9px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.candidate-texts[index];
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 520;
                            overflow: elide;
                        }
                    }
                }

                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.choose-candidate(index);
                    }
                }
            }
        }
    }
}

export component ActionPalette inherits Window {
    title: @tr("Text actions");
    icon: @image-url("../assets/tray-icon.svg");
    width: 520px;
    height: 115px + root.source-panel-height * 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <string> source-text;
    in-out property <bool> prepared: false;
    in-out property <float> source-panel-height: 54;
    in property <bool> translation-enabled: false;
    in property <bool> layout-enabled: true;
    callback translate();
    callback correct-layout();
    callback cancel();

    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.acrylic;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 17px;
            spacing: 9px;

            HorizontalLayout {
                height: 23px;
                vertical-stretch: 0;
                Text {
                    text: @tr("Text actions");
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 720;
                }
                Rectangle { horizontal-stretch: 1; }
                Eyebrow { text: @tr("CTRL + ALT + F"); }
            }

            Rectangle {
                height: root.source-panel-height * 1px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    height: parent.height - 14px;
                    text: root.source-text;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                height: 40px;
                vertical-stretch: 0;
                spacing: 7px;
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: @tr("TRANSLATE");
                    accent: true;
                    enabled: root.translation-enabled;
                    clicked => { root.translate(); }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: @tr("CORRECT LAYOUT");
                    enabled: root.layout-enabled;
                    clicked => { root.correct-layout(); }
                }
                ActionButton {
                    width: 74px;
                    height: 40px;
                    label: @tr("CANCEL");
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}

// Shown when a dictation could not be inserted. It never takes the keyboard
// focus: the user can click into the field they want and then press Insert.
export component InsertionNotice inherits Window {
    title: @tr("Text was not inserted");
    icon: @image-url("../assets/tray-icon.svg");
    width: 440px;
    height: 196px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <string> reason;
    in property <string> preview;
    in-out property <bool> prepared: false;
    out property <bool> hovered: hover.has-hover;
    callback insert();
    callback copy();
    callback dismiss();

    hover := TouchArea { }

    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.acrylic;
        opacity: root.prepared ? 1 : 0;

        VerticalLayout {
            padding: 14px;
            spacing: 7px;

            HorizontalLayout {
                height: 24px;
                vertical-stretch: 0;
                Text {
                    text: @tr("Text was not inserted");
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 26px;
                    height: 24px;
                    border-radius: 5px;
                    border-width: close-touch.has-hover ? 1px : 0px;
                    border-color: Theme.line;
                    background: close-touch.has-hover ? Theme.panel-raised : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Close");
                    accessible-enabled: true;
                    accessible-action-default => { root.dismiss(); }

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Theme.text : Theme.text-muted;
                        font-size: 17px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismiss(); }
                    }
                }
            }

            Text {
                vertical-stretch: 0;
                text: root.reason;
                color: Theme.text;
                font-size: 12px;
                wrap: word-wrap;
                accessible-role: text;
            }

            Rectangle {
                height: 26px;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    text: root.preview;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            Text {
                vertical-stretch: 0;
                text: @tr("Click the field you want, then press Insert. The text is also in History.");
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                spacing: 7px;
                ActionButton {
                    horizontal-stretch: 1;
                    label: @tr("INSERT");
                    accent: true;
                    clicked => { root.insert(); }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    label: @tr("COPY");
                    clicked => { root.copy(); }
                }
            }
        }
    }
}

export component TranslationPreview inherits Window {
    // Kept for diagnostics and accessibility only. The window is frameless, so
    // no title or chrome is rendered to the user.
    title: @tr("Translation preview");
    preferred-width: root.card-width * 1px;
    preferred-height: root.main-card-height * 1px
        + (root.view-mode == 1 ? root.original-card-height * 1px + 18px : 0px);
    min-width: 252px;
    min-height: root.preferred-height;
    no-frame: true;
    // Native presentation owns z-order: compact text popups are transiently
    // topmost, while screen results are ordinary windows until PIN is chosen.
    always-on-top: false;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in-out property <string> request-id;
    in-out property <bool> prepared: false;
    in-out property <string> source-text;
    in-out property <string> translated-text;
    in-out property <[string]> translated-paragraphs;
    in-out property <bool> processing: false;
    in-out property <bool> model-offer-visible: false;
    in-out property <string> model-offer-action;
    /// A warning under the result, such as "check the numbers". Empty: none.
    in-out property <string> notice;
    in-out property <float> latest-paragraph-opacity: 1;
    in-out property <float> visible-main-card-height: 96;
    property <float> shimmer-phase: 0;
    out property <bool> source-available: root.source-text != "";
    in-out property <[TranslationPair]> dual-pairs;
    // 0 = translated result, 1 = original companion card, 2 = interleaved.
    in-out property <int> view-mode: 0;
    in-out property <bool> pinned: false;
    in-out property <bool> pin-enabled: true;
    // Physical screen-region anchor retained only as geometry. No captured
    // pixels are ever stored in the preview component.
    in-out property <bool> screen-anchor-active: false;
    in-out property <int> screen-anchor-x: 0;
    in-out property <int> screen-anchor-y: 0;
    in-out property <int> screen-anchor-width: 0;
    in-out property <int> screen-anchor-height: 0;
    in-out property <bool> live-glass: false;
    in-out property <bool> dark-text: false;
    in-out property <int> blur-radius: 3;
    in-out property <float> card-width: 252;
    in property <image> glass-backdrop;
    in-out property <float> original-card-height: 96;
    /// What the original actually needs, measured rather than estimated.
    ///
    /// The height was worked out in Rust from a fixed forty-eight characters a
    /// line against a card that is usually three hundred and fifty wide, so the
    /// last line of the original came out clipped. This is measured at the
    /// width the card is really drawn at, plus the 19 above the text and the 13
    /// below it.
    ///
    /// A separate element because the one the card uses lives inside an `if`
    /// and cannot be reached from here. It draws nothing.
    out property <float> original-content-height:
        (measure-original.preferred-height + 32px) / 1px;
    out property <float> dual-content-height:
        max(20px, dual-stack.preferred-height + 4px) / 1px;
    out property <float> result-content-height:
        root.view-mode == 2
            ? root.dual-content-height
            : root.translated-paragraphs.length > 0
                ? max(20px, result-stack.preferred-height + 4px) / 1px
                : max(20px, result-text.preferred-height + 4px) / 1px;
    out property <float> result-panel-height:
        min(252px, root.result-content-height * 1px) / 1px;
    out property <bool> result-scrollable:
        root.result-content-height * 1px > result-scroll.height + 0.5px;
    out property <float> result-scroll-offset: -result-scroll.viewport-y / 1px;
    out property <float> result-viewport-height: result-scroll.height / 1px;
    out property <float> main-card-height:
        max(96, 50 + root.result-panel-height + (root.processing ? 24 : 0)
            + (root.model-offer-visible ? 40 : 0) + (root.notice != "" ? 30 : 0));
    callback begin-drag();
    callback begin-resize(int);
    callback pin-state-changed(bool);
    callback view-mode-changed(int);
    callback reset-scroll();
    callback scroll-by(float);
    callback download-model();
    reset-scroll => {
        result-scroll.viewport-y = 0px;
    }
    scroll-by(delta) => {
        if (root.result-scrollable) {
            result-scroll.viewport-y = max(
                result-scroll.height - result-scroll.viewport-height,
                min(0px, result-scroll.viewport-y + (delta / 120) * 48px)
            );
        }
    }

    Timer {
        interval: 16ms;
        running: abs(root.visible-main-card-height - root.main-card-height) > 0.5;
        triggered() => {
            root.visible-main-card-height +=
                (root.main-card-height - root.visible-main-card-height) * 0.24;
            if (abs(root.visible-main-card-height - root.main-card-height) <= 0.5) {
                root.visible-main-card-height = root.main-card-height;
            }
        }
    }
    Timer {
        interval: 16ms;
        running: root.latest-paragraph-opacity < 0.999;
        triggered() => {
            root.latest-paragraph-opacity = min(1, root.latest-paragraph-opacity + 0.105);
        }
    }
    Timer {
        interval: 16ms;
        running: root.processing;
        triggered() => {
            root.shimmer-phase += 0.018;
            if (root.shimmer-phase >= 1) {
                root.shimmer-phase = 0;
            }
        }
    }

    // Measures the original; never seen.
    measure-original := Text {
        visible: false;
        x: 0;
        y: 0;
        height: 0px;
        width: root.card-width * 1px - 38px;
        text: root.source-text;
        font-size: 13px;
        font-weight: 460;
        wrap: word-wrap;
    }

    if root.view-mode == 1: original-card := Rectangle {
        x: 5px;
        y: 6px;
        width: parent.width - 10px;
        height: root.original-card-height * 1px;
        border-radius: 9px;
        border-width: 0px;
        clip: true;
        opacity: root.prepared ? 1 : 0;
        background: @linear-gradient(145deg,
            rgba(65, 150, 196, 0.065) 0%,
            rgba(8, 24, 39, 0.14) 48%,
            rgba(58, 148, 195, 0.05) 100%);

        Image {
            width: parent.width;
            height: parent.height;
            source: root.glass-backdrop;
            image-fit: fill;
            opacity: root.live-glass ? 0 : 1;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(145deg,
                rgba(65, 150, 196, 0.065) 0%,
                rgba(8, 24, 39, 0.14) 48%,
                rgba(58, 148, 195, 0.05) 100%);
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-blue-glass-wash.svg");
            image-fit: fill;
            opacity: 0.14;
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-matte-grain.svg");
            image-fit: fill;
            opacity: 0.06;
        }
        original-text := Text {
            x: 14px;
            y: 19px;
            width: parent.width - 28px;
            height: parent.height - 32px;
            text: root.source-text;
            color: root.dark-text ? #111820 : #f5f3ef;
            font-size: 13px;
            font-weight: 460;
            wrap: word-wrap;
            vertical-alignment: top;
        }

        TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.begin-drag();
                }
            }
        }
    }

    main-card := Rectangle {
        x: root.view-mode == 1 ? 5px : 0px;
        y: root.view-mode == 1 ? root.original-card-height * 1px + 18px : 0px;
        width: parent.width - (root.view-mode == 1 ? 10px : 0px);
        height: min(
            parent.height - self.y - (root.view-mode == 1 ? 6px : 0px),
            root.visible-main-card-height * 1px
        );
        border-radius: 9px;
        border-width: 0px;
        background: @linear-gradient(145deg,
            rgba(65, 150, 196, 0.075) 0%,
            rgba(8, 24, 39, 0.16) 48%,
            rgba(58, 148, 195, 0.06) 100%);
        clip: true;
        opacity: root.prepared ? 1 : 0;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.glass-backdrop;
            image-fit: fill;
            opacity: root.live-glass ? 0 : 1;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(145deg,
                rgba(65, 150, 196, 0.075) 0%,
                rgba(8, 24, 39, 0.16) 48%,
                rgba(58, 148, 195, 0.06) 100%);
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-blue-glass-wash.svg");
            image-fit: fill;
            opacity: 0.16;
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/slate-matte-grain.svg");
            image-fit: fill;
            opacity: 0.07;
        }

        orig-button := Rectangle {
            x: 14px;
            y: 7px;
            width: 44px;
            height: 24px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.view-mode == 1
                ? Theme.red
                : root.dark-text ? #10182070 : #d7d3cc48;
            background: root.view-mode == 1
                ? Theme.red
                : orig-touch.has-hover
                    ? Theme.red-soft
                    : root.dark-text ? #ffffff42 : #0c0f1450;
            opacity: root.source-available ? 1 : 0.28;
            accessible-role: button;
            accessible-label: @tr("Show original text");
            accessible-enabled: root.source-available;
            accessible-action-default => {
                if (root.source-available) {
                    root.view-mode = root.view-mode == 1 ? 0 : 1;
                    root.reset-scroll();
                    root.view-mode-changed(root.view-mode);
                }
            }

            Text {
                text: @tr("ORIG");
                color: root.view-mode == 1 ? #0b0e13 : root.dark-text ? #111820 : #dedad3;
                opacity: root.view-mode == 1 ? 1 : (orig-touch.has-hover ? 0.92 : 0.62);
                font-size: 9px;
                font-weight: 680;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            orig-touch := TouchArea {
                enabled: root.source-available;
                clicked => {
                    root.view-mode = root.view-mode == 1 ? 0 : 1;
                    root.reset-scroll();
                    root.view-mode-changed(root.view-mode);
                }
            }
        }

        dual-button := Rectangle {
            x: 64px;
            y: 7px;
            width: 44px;
            height: 24px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.view-mode == 2
                ? Theme.red
                : root.dark-text ? #10182070 : #d7d3cc48;
            background: root.view-mode == 2
                ? Theme.red
                : dual-touch.has-hover
                    ? Theme.red-soft
                    : root.dark-text ? #ffffff42 : #0c0f1450;
            opacity: root.source-available ? 1 : 0.28;
            accessible-role: button;
            accessible-label: @tr("Show interleaved original and translation");
            accessible-enabled: root.source-available;
            accessible-action-default => {
                if (root.source-available) {
                    root.view-mode = root.view-mode == 2 ? 0 : 2;
                    root.reset-scroll();
                    root.view-mode-changed(root.view-mode);
                }
            }

            Text {
                text: @tr("DUAL");
                color: root.view-mode == 2 ? #0b0e13 : root.dark-text ? #111820 : #dedad3;
                opacity: root.view-mode == 2 ? 1 : (dual-touch.has-hover ? 0.92 : 0.62);
                font-size: 9px;
                font-weight: 680;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            dual-touch := TouchArea {
                enabled: root.source-available;
                clicked => {
                    root.view-mode = root.view-mode == 2 ? 0 : 2;
                    root.reset-scroll();
                    root.view-mode-changed(root.view-mode);
                }
            }
        }

        result-scroll := Flickable {
            x: 14px;
            y: 38px;
            // Always reserve the scrollbar gutter. Changing the width when the
            // scrollbar appears would reflow the text and create a
            // height/scroll feedback loop while a streamed result grows.
            width: parent.width - self.x - 20px;
            height: parent.height - self.y
                - (root.processing ? 32px : 12px)
                - (root.model-offer-visible ? 40px : 0px)
                - (root.notice != "" ? 30px : 0px);
            viewport-width: self.width;
            viewport-height: root.result-content-height * 1px;

            result-text := Text {
                visible: root.view-mode != 2 && root.translated-paragraphs.length == 0;
                width: result-scroll.width;
                height: root.result-content-height * 1px;
                text: root.translated-text;
                color: root.dark-text ? #111820 : #f5f3ef;
                font-size: 14px;
                font-weight: 470;
                wrap: word-wrap;
                vertical-alignment: top;
            }

            result-stack := VerticalLayout {
                visible: root.view-mode != 2 && root.translated-paragraphs.length > 0;
                width: result-scroll.width;
                spacing: 10px;

                for paragraph[index] in root.translated-paragraphs: Rectangle {
                    width: parent.width;
                    height: paragraph-text.preferred-height;
                    opacity: index + 1 == root.translated-paragraphs.length
                        ? root.latest-paragraph-opacity
                        : 1;

                    paragraph-text := Text {
                        x: 0;
                        y: (index + 1 == root.translated-paragraphs.length
                            ? (1 - root.latest-paragraph-opacity) * 5px
                            : 0px);
                        width: parent.width;
                        text: paragraph;
                        color: root.dark-text ? #111820 : #f5f3ef;
                        font-size: 14px;
                        font-weight: 470;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }

            dual-stack := VerticalLayout {
                visible: root.view-mode == 2;
                width: result-scroll.width;
                spacing: 0px;

                for pair[index] in root.dual-pairs: VerticalLayout {
                    width: parent.width;
                    spacing: 5px;
                    padding-bottom: index + 1 < root.dual-pairs.length ? 10px : 0px;

                    Text {
                        width: parent.width;
                        text: pair.source;
                        color: root.dark-text ? #111820 : #f5f3ef;
                        font-size: 13px;
                        font-weight: 610;
                        wrap: word-wrap;
                    }
                    Text {
                        width: parent.width;
                        text: pair.translation;
                        color: root.dark-text ? #27333f : #d7dbe0;
                        font-size: 14px;
                        font-weight: 450;
                        wrap: word-wrap;
                    }
                    if index + 1 < root.dual-pairs.length: Rectangle {
                        width: parent.width;
                        height: 1px;
                        background: transparent;

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            width: 96px;
                            height: 1px;
                            background: Theme.red;
                            opacity: 0.62;
                        }
                    }
                }
            }
        }

        if root.result-scrollable: Rectangle {
            x: parent.width - 8px;
            y: 38px;
            width: 2px;
            height: root.result-panel-height * 1px;
            border-radius: 1px;
            background: root.dark-text ? #f4f6f880 : #080a0d80;

            Rectangle {
                width: 2px;
                height: parent.height * (result-scroll.height / result-scroll.viewport-height) < 20px
                    ? 20px
                    : parent.height * (result-scroll.height / result-scroll.viewport-height);
                y: (-result-scroll.viewport-y / (result-scroll.viewport-height - result-scroll.height))
                    * (parent.height - self.height);
                border-radius: 1px;
                background: Theme.red;
                opacity: 0.7;
            }
        }

        translating-status := Rectangle {
            // Opacity alone only hides the pixels. UI Automation would still
            // expose "Translating" after a terminal result (including a
            // capture failure), which gives assistive technology a state that
            // contradicts the visible card. Remove the subtree whenever the
            // operation is no longer running.
            visible: root.processing;
            x: 14px;
            y: parent.height - 25px;
            width: 86px;
            height: 16px;
            clip: true;
            opacity: root.processing ? 1 : 0;
            animate opacity { duration: 150ms; easing: ease-out; }

            Text {
                width: parent.width;
                height: parent.height;
                text: @tr("Translating");
                color: root.dark-text ? #2d333a8a : #d8d4cd8a;
                font-size: 11px;
                font-weight: 560;
                vertical-alignment: center;
            }
            wave-red := Rectangle {
                x: -34px + root.shimmer-phase * (parent.width + 48px);
                width: 34px;
                height: parent.height;
                clip: true;

                Text {
                    x: -wave-red.x;
                    width: translating-status.width;
                    height: parent.height;
                    text: @tr("Translating");
                    color: #d9362b;
                    font-size: 11px;
                    font-weight: 620;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: 9px;
                    width: 16px;
                    height: parent.height;
                    clip: true;

                    Text {
                        x: -wave-red.x - parent.x;
                        width: translating-status.width;
                        height: parent.height;
                        text: @tr("Translating");
                        color: #f0a33a;
                        font-size: 11px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.notice != "": Text {
            x: 14px;
            y: parent.height - 38px - (root.model-offer-visible ? 40px : 0px);
            width: parent.width - 28px;
            height: 30px;
            text: root.notice;
            color: root.dark-text ? #8a4b00 : #f0a33a;
            font-size: 11px;
            font-weight: 600;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: center;
            accessible-role: text;
        }

        if root.model-offer-visible: model-offer-button := Rectangle {
            x: 14px;
            y: parent.height - 38px;
            width: parent.width - 28px;
            height: 30px;
            border-radius: 6px;
            background: model-offer-touch.pressed
                ? #bd2f27
                : model-offer-touch.has-hover ? #ef5147 : Theme.red;
            accessible-role: button;
            accessible-label: root.model-offer-action;
            accessible-action-default => { root.download-model(); }

            Text {
                text: root.model-offer-action;
                color: #0b0e13;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            model-offer-touch := TouchArea {
                clicked => { root.download-model(); }
            }
        }

        // The header is also the drag handle. It sits above the text so the
        // first press is never consumed by the content layer; the pin remains
        // outside this exact hit area.
        drag-area := TouchArea {
            x: 114px;
            y: 0;
            width: max(0px, parent.width - self.x - 122px);
            height: 36px;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.begin-drag();
                }
            }
        }

        pin-button := Rectangle {
            x: parent.width - 52px;
            y: 7px;
            width: 44px;
            height: 24px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.pinned
                ? Theme.red
                : root.dark-text ? #10182070 : #d7d3cc48;
            background: root.pinned
                ? Theme.red
                : pin-touch.has-hover
                    ? Theme.red-soft
                    : root.dark-text ? #ffffff42 : #0c0f1450;
            accessible-role: button;
            accessible-label: root.pinned ? @tr("Unpin translation") : @tr("Pin translation");
            accessible-enabled: root.pin-enabled;
            accessible-action-default => {
                if (root.pin-enabled) {
                    root.pinned = !root.pinned;
                    root.pin-state-changed(root.pinned);
                }
            }

            Text {
                text: @tr("PIN");
                color: root.pinned ? #0b0e13 : root.dark-text ? #111820 : #dedad3;
                opacity: root.pin-enabled
                    ? (root.pinned ? 1 : (pin-touch.has-hover ? 0.92 : 0.62))
                    : 0.28;
                font-size: 10px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            pin-touch := TouchArea {
                enabled: root.pin-enabled;
                clicked => {
                    root.pinned = !root.pinned;
                    root.pin-state-changed(root.pinned);
                }
            }
        }
    }

    if root.pinned: TouchArea {
        x: 0;
        y: 7px;
        width: 7px;
        height: parent.height - 14px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(0);
            }
        }
    }
    if root.pinned: TouchArea {
        x: parent.width - 7px;
        y: 7px;
        width: 7px;
        height: parent.height - 14px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(1);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 7px;
        y: 0;
        width: parent.width - 14px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(2);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 7px;
        y: parent.height - 7px;
        width: parent.width - 14px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(3);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 0;
        y: 0;
        width: 7px;
        height: 7px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(4);
            }
        }
    }
    if root.pinned: TouchArea {
        x: parent.width - 7px;
        y: 0;
        width: 7px;
        height: 7px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(5);
            }
        }
    }
    if root.pinned: TouchArea {
        x: 0;
        y: parent.height - 7px;
        width: 7px;
        height: 7px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(6);
            }
        }
    }
    if root.pinned: TouchArea {
        x: parent.width - 7px;
        y: parent.height - 7px;
        width: 7px;
        height: 7px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.begin-resize(7);
            }
        }
    }
}

export component ScreenRegionOverlay inherits Window {
    title: "SayFlex";
    preferred-width: 1px;
    preferred-height: 1px;
    min-width: 1px;
    min-height: 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <image> frozen-image;
    in property <bool> selection-active: false;
    in property <float> selection-x: 0;
    in property <float> selection-y: 0;
    in property <float> selection-width: 0;
    in property <float> selection-height: 0;
    in property <float> dim-opacity: 0.28;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.frozen-image;
        image-fit: fill;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: rgba(12, 13, 16, root.dim-opacity);
    }

    if root.selection-active: selected-region := Rectangle {
        x: root.selection-x * 1px;
        y: root.selection-y * 1px;
        width: root.selection-width * 1px;
        height: root.selection-height * 1px;
        clip: true;
        border-width: 2px;
        border-color: Theme.signal;
        background: transparent;

        Image {
            x: -root.selection-x * 1px;
            y: -root.selection-y * 1px;
            width: root.width;
            height: root.height;
            source: root.frozen-image;
            image-fit: fill;
        }
    }
}

export component TranslatorWindow inherits Window {
    title: @tr("Translator");
    icon: @image-url("../assets/tray-icon.svg");
    width: 780px;
    height: 610px;
    background: Sheet.canvas;
    default-font-family: "Segoe UI Variable Text";

    in-out property <string> source-text;
    in-out property <string> result-text;
    in-out property <string> status-text: @tr("Choose a translation model in Settings.");
    in-out property <bool> processing: false;
    // 0 idle, 1 processing, 2 result, 3 fallback result, 4 terminal error.
    in-out property <int> presentation-state: 0;
    in-out property <string> notice-headline;
    in-out property <string> notice-detail;
    in-out property <bool> model-offer-visible: false;
    in-out property <string> model-offer-action;
    out property <bool> source-focused: source-input.has-focus;
    callback translate();
    callback submit-shortcut();
    callback copy-result();
    callback swap-text();
    callback download-model();
    callback close-requested();
    submit-shortcut => {
        source-input.clear-focus();
        root.translate();
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 24px;
        spacing: 14px;

        Rectangle {
            height: 88px;
            background: Sheet.ink;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 22px;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "SayFlex";
                        color: Sheet.on-ink;
                        font-size: 24px;
                        font-weight: 720;
                    }
                    Text {
                        text: @tr("TRANSLATOR");
                        color: Sheet.on-ink;
                        opacity: 0.62;
                        font-size: Sheet.label-size;
                        font-weight: 650;
                        letter-spacing: 2px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: @tr("Direction is detected automatically");
                    color: Sheet.on-ink;
                    opacity: 0.72;
                    font-size: Sheet.detail-size;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 7px;
            HorizontalLayout {
                height: 26px;
                Text {
                    text: @tr("SOURCE TEXT");
                    color: Sheet.muted;
                    font-size: Sheet.label-size;
                    font-weight: 650;
                    letter-spacing: 1.7px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconAction {
                    source: @image-url("../assets/action-swap.svg");
                    label: @tr("Swap text");
                    enabled: !root.processing && (root.source-text != "" || root.result-text != "");
                    clicked => { root.swap-text(); }
                }
            }
            source-panel := Rectangle {
                vertical-stretch: 1;
                clip: true;
                border-width: source-input.has-focus ? 2px : 1px;
                border-color: source-input.has-focus ? Sheet.signal : Sheet.hairline;
                background: Sheet.raised;

                input-scroll := Flickable {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    viewport-width: self.width;
                    viewport-height: max(self.height, source-input.preferred-height);

                    source-input := TextInput {
                        width: input-scroll.width;
                        height: input-scroll.viewport-height;
                        text <=> root.source-text;
                        color: Sheet.ink;
                        selection-foreground-color: Sheet.on-ink;
                        selection-background-color: Sheet.signal;
                        font-size: Sheet.body-size;
                        wrap: word-wrap;
                        accessible-label: @tr("Source text");
                        cursor-position-changed(position) => {
                            if (position.y + input-scroll.viewport-y < 0px) {
                                input-scroll.viewport-y = -position.y;
                            } else if (position.y + self.font-size + input-scroll.viewport-y > input-scroll.height) {
                                input-scroll.viewport-y = input-scroll.height - position.y - self.font-size;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 7px;
            Text {
                height: 20px;
                text: @tr("TRANSLATION");
                color: Sheet.muted;
                font-size: Sheet.label-size;
                font-weight: 650;
                letter-spacing: 1.7px;
            }
            Rectangle {
                vertical-stretch: 1;
                border-width: !source-input.has-focus && root.presentation-state >= 2 ? 2px : 1px;
                border-color: !source-input.has-focus && root.presentation-state >= 2
                    ? Sheet.signal
                    : Sheet.hairline;
                background: Sheet.raised;
                Text {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    text: root.processing ? @tr("Translating…") : root.result-text;
                    color: root.processing ? Sheet.muted : Sheet.ink;
                    font-size: Sheet.body-size;
                    wrap: word-wrap;
                    accessible-label: @tr("Translation result");
                }
            }
        }

        HorizontalLayout {
            height: 52px;
            vertical-stretch: 0;
            spacing: 10px;
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 9px;
                Rectangle {
                    width: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        background: root.presentation-state >= 3 ? Sheet.signal : Sheet.hairline;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.notice-headline == "" ? root.status-text : root.notice-headline;
                        color: root.presentation-state >= 3 ? Sheet.signal-text : Sheet.muted;
                        font-size: Sheet.detail-size;
                        font-weight: root.presentation-state >= 3 ? 650 : 400;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    if root.notice-detail != "" : Text {
                        text: root.notice-detail;
                        color: Sheet.muted;
                        font-size: Sheet.label-size;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }
            IconAction {
                source: @image-url("../assets/action-copy.svg");
                label: @tr("Copy result");
                enabled: !root.processing && root.result-text != "";
                clicked => { root.copy-result(); }
            }
            if root.model-offer-visible: RowAction {
                label: root.model-offer-action;
                clicked => { root.download-model(); }
            }
            RowAction {
                label: @tr("Translate (Ctrl+Enter)");
                enabled: !root.processing;
                clicked => { root.translate(); }
            }
        }
    }

}

export component FirstRunWindow inherits Window {
    title: @tr("Welcome to SayFlex");
    icon: @image-url("../assets/tray-icon.svg");
    width: 680px;
    height: 520px;
    background: Sheet.canvas;
    default-font-family: "Segoe UI Variable Text";

    in property <string> model-name;
    in property <string> model-size;
    in-out property <bool> download-recommended: true;
    callback continue-requested();

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 28px;
        spacing: 18px;

        Rectangle {
            height: 88px;
            background: Sheet.ink;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 20px;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "SayFlex";
                        color: Sheet.on-ink;
                        font-size: 24px;
                        font-weight: 720;
                    }
                    Text {
                        text: @tr("FIRST START");
                        color: Sheet.on-ink;
                        opacity: 0.62;
                        font-size: Sheet.label-size;
                        font-weight: 650;
                        letter-spacing: 2px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: @tr("Your choice controls the download");
                    color: Sheet.on-ink;
                    opacity: 0.72;
                    font-size: Sheet.detail-size;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: @tr("Set up local dictation");
                color: Sheet.ink;
                font-size: 22px;
                font-weight: 700;
            }
            Text {
                text: @tr("SayFlex can transcribe speech on this computer. The recommended model keeps audio on the device and can be removed later in Models.");
                color: Sheet.muted;
                font-size: Sheet.body-size;
                wrap: word-wrap;
            }
        }

        choice := Rectangle {
            height: 86px;
            border-width: choice-focus.has-focus ? 2px : 1px;
            border-color: root.download-recommended ? Sheet.signal : Sheet.hairline;
            background: root.download-recommended ? Sheet.signal-soft : Sheet.raised;
            accessible-role: checkbox;
            accessible-label: @tr("Download the recommended local model");
            accessible-enabled: true;
            accessible-checkable: true;
            accessible-checked: root.download-recommended;
            accessible-action-default => { root.download-recommended = !root.download-recommended; }
            forward-focus: choice-focus;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 14px;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-width: 1px;
                    border-color: root.download-recommended ? Sheet.signal : Sheet.ink;
                    background: root.download-recommended ? Sheet.signal : transparent;
                    if root.download-recommended : Rectangle {
                        width: 8px;
                        height: 8px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: Sheet.on-ink;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Text {
                        text: @tr("Download {} ({})", root.model-name, root.model-size);
                        color: Sheet.ink;
                        font-size: Sheet.body-size;
                        font-weight: 700;
                    }
                    Text {
                        text: root.download-recommended
                            ? @tr("Starts only after you press Continue")
                            : @tr("No model will be downloaded; you can configure a cloud provider instead");
                        color: Sheet.muted;
                        font-size: Sheet.detail-size;
                        wrap: word-wrap;
                    }
                }
            }

            choice-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    choice-focus.focus();
                    root.download-recommended = !root.download-recommended;
                }
            }
            choice-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == Key.Return {
                        root.download-recommended = !root.download-recommended;
                        return accept;
                    }
                    reject
                }
            }
        }

        Rectangle {
            height: 50px;
            background: Sheet.raised;
            Rectangle {
                x: 0px;
                y: 0px;
                width: 4px;
                height: parent.height;
                background: Sheet.signal;
            }
            Text {
                x: 16px;
                width: parent.width - 32px;
                text: @tr("Nothing is downloaded before confirmation. You can change this choice later in Providers and Models.");
                color: Sheet.muted;
                font-size: Sheet.detail-size;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        Text {
            text: @tr("Have an NVIDIA GPU? After setup, open Settings → Dictation to download optional NVIDIA acceleration separately.");
            color: Sheet.muted;
            font-size: Sheet.detail-size;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }
        Rectangle {
            height: 46px;
            HorizontalLayout {
                width: parent.width;
                height: 26px;
                Text {
                    horizontal-stretch: 1;
                    text: @tr("Closing this window leaves SayFlex unconfigured.");
                    color: Sheet.muted;
                    font-size: Sheet.label-size;
                    vertical-alignment: center;
                }
                RowAction {
                    label: @tr("Continue");
                    primary: true;
                    clicked => { root.continue-requested(); }
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray-icon.svg");
    tooltip: "SayFlex";

    callback open-settings();
    callback open-translator();
    callback copy-last();
    callback quit-requested();

    clicked => {
        root.open-settings();
    }

    Menu {
        MenuItem {
            title: @tr("Open settings");
            activated => {
                root.open-settings();
            }
        }
        MenuItem {
            title: @tr("Open translator");
            activated => {
                root.open-translator();
            }
        }
        MenuItem {
            title: @tr("Copy latest transcript");
            activated => {
                root.copy-last();
            }
        }
        MenuSeparator {}
        MenuItem {
            title: @tr("Quit");
            activated => {
                root.quit-requested();
            }
        }
    }
}
