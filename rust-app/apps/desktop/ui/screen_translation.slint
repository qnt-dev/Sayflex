import { Theme } from "overlay_theme.slint";

export struct ScreenBlockOverlay {
    block-id: string,
    source: string,
    translation: string,
    x: float,
    y: float,
    width: float,
    height: float,
    source-x: float,
    source-y: float,
    source-width: float,
    source-height: float,
    callout: bool,
    overflow-panel: bool,
    panel-order: int,
    low-confidence: bool,
    replace-source: bool,
    mask-source: bool,
}

component OverlayButton inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Theme.red : #d7d3cc48;
    background: root.active
        ? Theme.red
        : touch.has-hover ? Theme.red-soft : #0c0f1450;
    opacity: root.enabled ? 1 : 0.28;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Text {
        text: root.label;
        color: root.active ? #0b0e13 : #dedad3;
        opacity: root.active ? 1 : (touch.has-hover ? 0.92 : 0.62);
        font-size: root.label == "ON IMAGE" ? 9px : 10px;
        font-weight: 680;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TranslatedLabel inherits Rectangle {
    in property <string> source-text;
    in property <string> translated-text;
    in property <bool> dual: false;
    in property <bool> selected-label: false;
    in property <bool> dimmed: false;
    in property <length> text-size: 12px;
    out property <length> measured-content-height: translated-text-item.preferred-height + 8px;
    callback selected();
    callback edit-requested();

    border-radius: 3px;
    forward-focus: key-focus;
    border-width: root.selected-label || touch.has-hover ? 1px : 0px;
    border-color: root.selected-label ? Theme.red : #f3e9cf80;
    background: touch.has-hover ? #25170fff : #120e09ff;
    opacity: root.dimmed ? 0.38 : 1;
    accessible-role: button;
    accessible-label: @tr("Editable translated image text");
    accessible-action-default => { root.edit-requested(); }

    translated-text-item := Text {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 4px;
        text: root.dual
            ? root.source-text + "\n" + root.translated-text
            : root.translated-text;
        color: #f3e9cf;
        font-size: max(12px, root.text-size);
        font-weight: 570;
        wrap: word-wrap;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { key-focus.focus(); root.selected(); }
        double-clicked => { root.edit-requested(); }
    }
    key-focus := FocusScope {
        x: 0px; y: 0px; width: 0px; height: 0px;
        key-pressed(event) => {
            if event.text == Key.Return {
                root.edit-requested();
                return accept;
            }
            reject
        }
    }
}

export component TranslationCorrectionPanel inherits Rectangle {
    in-out property <string> original-text: "End Turn";
    in property <string> context-text: "Battle for Wesnoth · game interface";
    in property <string> baseline-translation: "Завершить ход";
    in property <bool> save-error: false;
    in property <bool> editor-focusable: true;
    in property <string> direction-text: "EN → RU";
    in-out property <string> edited-translation: "Завершить ход";
    callback save-requested();
    callback confirm-requested();
    callback cancel-requested();
    callback retry-requested();
    forward-focus: translation-input;
    init => { translation-input.focus(); }

    background: #16181cf7;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;

    Text {
        x: 14px; y: 12px;
        text: @tr("Correct translation");
        color: Theme.text;
        font-size: 14px;
        font-weight: 620;
    }
    Text {
        x: parent.width - 66px; y: 15px; width: 52px;
        text: root.direction-text;
        color: Theme.text-faint;
        font-size: 9px;
        font-weight: 650;
        horizontal-alignment: right;
    }
    Rectangle { x: 14px; y: 39px; width: parent.width - 28px; height: 1px; background: Theme.line; }

    Text { x: 14px; y: 50px; text: @tr("SOURCE PHRASE"); color: Theme.text-faint; font-size: 8px; font-weight: 680; letter-spacing: 0.6px; }

    source-frame := Rectangle {
        x: 14px; y: 65px; width: parent.width - 28px; height: 42px;
        border-radius: 6px;
        border-width: 1px;
        border-color: source-input.has-focus ? Theme.red : #3a3d43;
        background: #0f1115;
        source-input := TextInput {
            x: 9px; y: 6px; width: parent.width - 18px; height: parent.height - 12px;
            text <=> root.original-text;
            color: Theme.text;
            selection-background-color: #d85c5c60;
            font-size: 12px;
            wrap: word-wrap;
            enabled: root.editor-focusable;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel-requested();
                    return accept;
                }
                reject
            }
        }
    }

    Text { x: 14px; y: 114px; text: @tr("APPROVED TRANSLATION"); color: Theme.text-faint; font-size: 8px; font-weight: 680; letter-spacing: 0.6px; }

    input-frame := Rectangle {
        x: 14px; y: 129px; width: parent.width - 28px; height: 52px;
        border-radius: 6px;
        border-width: 1px;
        border-color: translation-input.has-focus ? Theme.red : #3a3d43;
        background: #0f1115;
        translation-input := TextInput {
            x: 9px; y: 7px; width: parent.width - 18px; height: parent.height - 14px;
            text <=> root.edited-translation;
            color: Theme.text;
            selection-background-color: #d85c5c60;
            font-size: 12px;
            wrap: word-wrap;
            enabled: root.editor-focusable;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel-requested();
                    return accept;
                }
                if event.modifiers.control && event.text == Key.Return {
                    if root.save-error { root.retry-requested(); }
                    else if root.edited-translation == root.baseline-translation { root.confirm-requested(); }
                    else { root.save-requested(); }
                    return accept;
                }
                reject
            }
        }
    }

    Text {
        x: 14px; y: 190px; width: parent.width - 28px;
        text: root.context-text;
        color: Theme.text-muted;
        font-size: 9px;
        overflow: elide;
    }
    if root.save-error: Text {
        x: 14px; y: 210px; width: parent.width - 28px;
        text: @tr("Save failed. Your correction is still here.");
        color: #e3a0a0;
        font-size: 9px;
    }

    HorizontalLayout {
        x: 14px; y: parent.height - 38px; width: parent.width - 28px; height: 24px;
        spacing: 7px;
        alignment: end;
        OverlayButton { width: 62px; label: @tr("Cancel"); clicked => { root.cancel-requested(); } }
        OverlayButton {
            width: root.save-error ? 64px : 70px;
            label: root.save-error
                ? @tr("Retry")
                : root.edited-translation == root.baseline-translation ? @tr("Confirm") : @tr("Save");
            active: true;
            clicked => {
                if root.save-error { root.retry-requested(); }
                else if root.edited-translation == root.baseline-translation { root.confirm-requested(); }
                else { root.save-requested(); }
            }
        }
    }
}

export component ScreenImageResult inherits Rectangle {
    in property <image> crop-image;
    in property <int> view-mode: 3;
    in property <bool> pinned: false;
    in property <int> selected-block: 4;
    in property <bool> editor-visible: false;
    in property <bool> image-expired: false;
    in property <bool> saved: false;
    in property <bool> save-error: false;
    in property <bool> copied: false;
    in property <bool> dim-other-blocks: false;
    in property <bool> dense-panel-active: false;
    in property <bool> use-fixture-blocks: true;
    in property <[ScreenBlockOverlay]> blocks;
    in property <float> image-content-width: root.width / 1px;
    in property <float> dense-panel-width: 0;
    in property <float> editor-panel-x: 488;
    in property <float> editor-panel-y: 292;
    in property <length> minimum-overlay-font-size: 12px;
    in property <string> menu-translation: "Меню";
    in property <string> actions-translation: "Действия";
    in property <string> encampment-translation: "Лагерь (Замок)";
    in property <string> unit-translation: "Кочевник · быстрый, стойкий";
    in property <string> end-turn-translation: "Завершить ход";
    in-out property <string> editor-original: "End Turn";
    in property <string> editor-context: "Battle for Wesnoth · game interface";
    in property <string> editor-direction: "EN → RU";
    in property <string> editor-baseline: "Завершить ход";
    in-out property <string> editor-translation: "Завершить ход";
    in property <bool> editor-saving: false;
    callback begin-drag-requested();
    callback close-requested();
    callback view-requested(int);
    callback pin-requested();
    callback block-selected(int);
    callback block-edit-requested(int);
    callback save-requested();
    callback confirm-requested();
    callback cancel-requested();
    callback retry-requested();
    callback copy-text-requested();
    callback save-file-requested();
    callback delete-image-requested();

    border-radius: 9px;
    border-width: 0px;
    background: @linear-gradient(145deg,
        rgba(65, 150, 196, 0.075) 0%,
        rgba(8, 24, 39, 0.16) 48%,
        rgba(58, 148, 195, 0.06) 100%);
    clip: true;

    Rectangle { width: parent.width; height: parent.height; background: Theme.glass; }
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/slate-blue-glass-wash.svg");
        image-fit: fill;
        opacity: 0.16;
    }
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/slate-matte-grain.svg");
        image-fit: fill;
        opacity: 0.07;
    }

    TouchArea {
        x: 0px; y: 0px; width: parent.width; height: 38px;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.begin-drag-requested();
            }
        }
    }
    OverlayButton { x: 14px; y: 7px; width: 44px; label: "ORIG"; active: root.view-mode == 1; clicked => { root.view-requested(1); } }
    OverlayButton { x: 64px; y: 7px; width: 44px; label: "DUAL"; active: root.view-mode == 2; clicked => { root.view-requested(2); } }
    OverlayButton { x: 114px; y: 7px; width: 78px; label: "ON IMAGE"; active: root.view-mode == 3; clicked => { root.view-requested(3); } }
    OverlayButton { x: 198px; y: 7px; width: 32px; label: "↓"; accessible-name: @tr("Save file"); enabled: !root.image-expired; clicked => { root.save-file-requested(); } }
    OverlayButton { x: 236px; y: 7px; width: 38px; label: "DEL"; accessible-name: @tr("Delete image"); enabled: !root.image-expired; clicked => { root.delete-image-requested(); } }
    OverlayButton { x: parent.width - 96px; y: 7px; width: 44px; label: "PIN"; active: root.pinned; clicked => { root.pin-requested(); } }
    OverlayButton { x: parent.width - 46px; y: 7px; width: 38px; label: "×"; accessible-name: @tr("Close"); clicked => { root.close-requested(); } }
    content := Rectangle {
        x: 0px; y: 38px;
        width: parent.width;
        height: parent.height - 38px;
        background: #0b0d11;
        clip: true;

        if root.view-mode != 0 && !root.image-expired: image-content := Rectangle {
            x: 0px;
            width: root.image-content-width * 1px;
            height: parent.height;
            clip: true;
            Image { width: parent.width; height: parent.height; source: root.crop-image; image-fit: fill; }

            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 3px; y: 1px; width: 75px; height: root.view-mode == 2 ? 28px : 18px;
                source-text: "Menu"; translated-text: root.menu-translation; dual: root.view-mode == 2; text-size: root.minimum-overlay-font-size;
                selected-label: root.selected-block == 0;
                dimmed: root.dim-other-blocks && root.selected-block != 0;
                selected => { root.block-selected(0); }
                edit-requested => { root.block-edit-requested(0); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 80px; y: 1px; width: 76px; height: root.view-mode == 2 ? 28px : 18px;
                source-text: "Actions"; translated-text: root.actions-translation; dual: root.view-mode == 2; text-size: root.minimum-overlay-font-size;
                selected-label: root.selected-block == 1;
                dimmed: root.dim-other-blocks && root.selected-block != 1;
                selected => { root.block-selected(1); }
                edit-requested => { root.block-edit-requested(1); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 830px; y: 216px; width: 126px; height: root.view-mode == 2 ? 34px : 19px;
                source-text: "Encampment (Castle)"; translated-text: root.encampment-translation; dual: root.view-mode == 2; text-size: root.minimum-overlay-font-size;
                selected-label: root.selected-block == 2;
                dimmed: root.dim-other-blocks && root.selected-block != 2;
                selected => { root.block-selected(2); }
                edit-requested => { root.block-edit-requested(2); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 830px; y: 379px; width: 126px; height: root.view-mode == 2 ? 54px : 40px;
                source-text: "Khalifate Human · quick, resilient";
                translated-text: root.unit-translation;
                dual: root.view-mode == 2;
                selected-label: root.selected-block == 3;
                dimmed: root.dim-other-blocks && root.selected-block != 3;
                text-size: root.minimum-overlay-font-size;
                selected => { root.block-selected(3); }
                edit-requested => { root.block-edit-requested(3); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: end-turn := TranslatedLabel {
                x: 832px; y: 538px; width: 123px; height: root.view-mode == 2 ? 36px : 31px;
                source-text: "End Turn";
                translated-text: root.end-turn-translation;
                dual: root.view-mode == 2;
                selected-label: root.selected-block == 4;
                dimmed: root.dim-other-blocks && root.selected-block != 4;
                text-size: root.minimum-overlay-font-size;
                selected => { root.block-selected(4); }
                edit-requested => { root.block-edit-requested(4); }
            }

            // A callout is never allowed to leave the original glyphs visible
            // underneath it. Cover the OCR source rectangle first, then draw a
            // restrained leader so the translated text remains spatially tied
            // to the part of the screenshot it replaces.
            for block in root.blocks: Rectangle {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.mask-source && block.callout && !block.overflow-panel;
                x: block.source-x * 1px;
                y: block.source-y * 1px;
                width: block.source-width * 1px;
                height: block.source-height * 1px;
                background: #120e09ff;
                border-width: 1px;
                border-color: #d7d3cc40;
                border-radius: 2px;
            }
            for block in root.blocks: Rectangle {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.mask-source && block.callout && !block.overflow-panel;
                x: min(
                    block.source-x + block.source-width / 2,
                    block.x + block.width / 2
                ) * 1px;
                y: (block.source-y + block.source-height / 2) * 1px;
                width: max(1, abs(
                    (block.x + block.width / 2)
                    - (block.source-x + block.source-width / 2)
                )) * 1px;
                height: 1px;
                background: Theme.red;
                opacity: 0.72;
            }
            for block in root.blocks: Rectangle {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.mask-source && block.callout && !block.overflow-panel;
                x: (block.x + block.width / 2) * 1px;
                y: min(
                    block.source-y + block.source-height / 2,
                    block.y + block.height / 2
                ) * 1px;
                width: 1px;
                height: max(1, abs(
                    (block.y + block.height / 2)
                    - (block.source-y + block.source-height / 2)
                )) * 1px;
                background: Theme.red;
                opacity: 0.72;
            }

            for block[index] in root.blocks: TranslatedLabel {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.replace-source && !block.overflow-panel;
                x: block.x * 1px;
                y: block.y * 1px;
                width: block.width * 1px;
                height: block.callout ? max(block.height * 1px, self.measured-content-height) : block.height * 1px;
                source-text: block.source;
                translated-text: block.translation;
                dual: root.view-mode == 2;
                selected-label: root.selected-block == index;
                dimmed: root.dim-other-blocks && root.selected-block != index;
                text-size: root.minimum-overlay-font-size;
                border-color: block.low-confidence && !self.selected-label ? #d7a45b : Theme.red;
                selected => { root.block-selected(index); }
                edit-requested => { root.block-edit-requested(index); }
            }

            // If the image cannot hold collision-free callouts, keep the
            // screenshot pixels untouched and move the translation into the
            // external panel. The transparent hit target preserves selection
            // and double-click editing without leaving an empty mask behind.
            for block[index] in root.blocks: Rectangle {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.replace-source && block.overflow-panel;
                x: block.source-x * 1px;
                y: block.source-y * 1px;
                width: block.source-width * 1px;
                height: block.source-height * 1px;
                background: transparent;
                border-width: root.selected-block == index || block.low-confidence ? 1px : 0px;
                border-color: block.low-confidence ? #d7a45b : Theme.red;
                border-radius: 2px;
                marker-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.block-selected(index); }
                    double-clicked => { root.block-edit-requested(index); }
                }
            }

        }

        if root.dense-panel-active && root.view-mode != 1: dense-panel := Rectangle {
            x: root.image-content-width * 1px + 8px;
            y: 8px;
            width: root.dense-panel-width * 1px;
            height: parent.height - 16px;
            background: #111318fa;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 7px;
            clip: true;

            dense-scroll := Flickable {
                x: 7px;
                y: 7px;
                width: parent.width - 14px;
                height: parent.height - 14px;
                viewport-width: self.width;
                viewport-height: max(self.height, dense-stack.preferred-height);

                dense-stack := VerticalLayout {
                    width: dense-scroll.width;
                    spacing: 0px;

                    for block[index] in root.blocks: panel-row := Rectangle {
                        visible: block.overflow-panel;
                        width: parent.width;
                        height: block.overflow-panel
                            ? max(54px, panel-source.preferred-height + panel-translation.preferred-height + 21px) + 7px
                            : 0px;

                        card := Rectangle {
                            width: parent.width;
                            height: max(0px, parent.height - 7px);
                            background: root.selected-block == index ? #2a1715f5 : #0c0f14ed;
                            border-width: 1px;
                            border-color: block.low-confidence ? #d7a45b : root.selected-block == index ? Theme.red : #d7d3cc35;
                            border-radius: 5px;

                            panel-source := Text {
                                x: 9px; y: 7px; width: parent.width - 18px;
                                text: block.source;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 520;
                                wrap: word-wrap;
                            }
                            panel-translation := Text {
                                x: 9px; y: panel-source.preferred-height + 11px; width: parent.width - 18px;
                                text: block.translation;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 570;
                                wrap: word-wrap;
                            }
                            panel-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.block-selected(index); }
                                double-clicked => { root.block-edit-requested(index); }
                            }
                        }
                    }
                }
            }
        }

        if root.editor-visible: inline-editor := TranslationCorrectionPanel {
            x: root.editor-panel-x * 1px;
            y: root.editor-panel-y * 1px;
            width: min(330px, parent.width - self.x - 8px);
            height: min(282px, parent.height - self.y - 8px);
            original-text <=> root.editor-original;
            context-text: root.editor-context;
            direction-text: root.editor-direction;
            baseline-translation: root.editor-baseline;
            edited-translation <=> root.editor-translation;
            save-error: root.save-error;
            editor-focusable: !root.editor-saving;
            save-requested => { root.save-requested(); }
            confirm-requested => { root.confirm-requested(); }
            cancel-requested => { root.cancel-requested(); }
            retry-requested => { root.retry-requested(); }
        }

        if root.view-mode == 0: Rectangle {
            x: 18px; y: 18px; width: parent.width - 36px; height: parent.height - 36px;
            background: transparent;
            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                if root.use-fixture-blocks: Text { text: root.menu-translation + " · " + root.actions-translation + " · " + root.encampment-translation; color: Theme.text; font-size: 14px; font-weight: 470; }
                if root.use-fixture-blocks: Text { text: root.unit-translation; color: Theme.text; font-size: 14px; font-weight: 470; }
                if root.use-fixture-blocks: Text { text: root.end-turn-translation; color: Theme.text; font-size: 14px; font-weight: 470; }
                for block in root.blocks: Text {
                    visible: !root.use-fixture-blocks;
                    text: block.translation;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 470;
                    wrap: word-wrap;
                }
            }
        }

        if root.image-expired: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #111318;
            expired-panel := Rectangle {
                x: 18px;
                y: max(12px, (parent.height - self.height) / 2);
                width: parent.width - 36px;
                height: min(150px, parent.height - 24px);
                Text {
                    y: 0px; width: parent.width; height: 30px;
                    text: @tr("Image expired");
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 620;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    y: 42px; width: parent.width; height: 38px;
                    text: @tr("The temporary screenshot was removed. Your text translation remains available.");
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                OverlayButton {
                    x: (parent.width - 104px) / 2;
                    y: 96px;
                    width: 104px;
                    label: root.copied ? @tr("COPIED") : @tr("COPY TEXT");
                    active: root.copied;
                    clicked => { root.copy-text-requested(); }
                }
            }
        }

        if root.saved: Rectangle {
            x: parent.width - 180px; y: 12px; width: 162px; height: 28px;
            border-radius: 6px;
            border-width: 1px;
            border-color: #52675a;
            background: #17211bed;
            Text { text: "✓  " + @tr("Saved to glossary"); color: #c8decf; font-size: 10px; font-weight: 560; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

export component ScreenTranslationPreviewWindow inherits Window {
    title: "Screen translation visual preview";
    preferred-width: 960px;
    preferred-height: 614px;
    min-width: 960px;
    min-height: 614px;
    no-frame: true;
    // Screen results behave like ordinary windows until the user explicitly
    // pins them. Native presentation applies the same contract in production.
    always-on-top: false;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";
    forward-focus: keyboard;

    in-out property <int> preview-state: 0;
    in property <image> fixture-image: @image-url("../assets/battle-for-wesnoth-1.12-screen-translation-preview.jpg");
    in-out property <int> view-mode: 3;
    in-out property <bool> pinned: false;
    in-out property <bool> editor-visible: false;
    in-out property <int> selected-block: 4;
    in-out property <bool> copied: false;
    in-out property <bool> dense-panel-active: false;
    in-out property <[ScreenBlockOverlay]> fixture-blocks;
    out property <bool> dim-other-blocks: root.editor-visible;
    out property <bool> save-confirmation-visible: root.preview-state == 2;
    out property <float> editor-panel-x: root.selected-block <= 1 ? 164 : 488;
    out property <float> editor-panel-y: root.selected-block <= 1
        ? 30
        : root.selected-block == 2 ? 100
        : 292;
    in-out property <string> menu-translation: "Меню";
    in-out property <string> actions-translation: "Действия";
    in-out property <string> encampment-translation: "Лагерь (Замок)";
    in-out property <string> unit-translation: "Кочевник · быстрый, стойкий";
    in-out property <string> end-turn-translation: "Завершить ход";
    in-out property <string> editor-original: "End Turn";
    in-out property <string> editor-baseline: "Завершить ход";
    in-out property <string> editor-translation: "Завершить ход";
    out property <int> drag-request-count: 0;
    out property <int> close-request-count: 0;
    out property <int> delete-request-count: 0;
    callback choose-view(int);
    callback toggle-pin();
    callback select-block(int);
    callback edit-block(int);
    callback keyboard-edit-selected();
    callback commit-edit();
    callback save-edit();
    callback confirm-edit();
    callback cancel-edit();
    callback retry-save();
    callback copy-text();
    callback save-file();
    callback delete-image();
    callback request-drag();
    callback request-close();
    callback request-delete-image();

    choose-view(mode) => { root.view-mode = root.view-mode == mode ? 0 : mode; root.editor-visible = false; }
    toggle-pin => { root.pinned = !root.pinned; }
    select-block(block) => {
        root.selected-block = block;
        root.editor-visible = false;
        root.preview-state = 0;
    }
    edit-block(block) => {
        root.selected-block = block;
        if block == 0 {
            root.editor-original = "Menu";
            root.editor-translation = root.menu-translation;
        } else if block == 1 {
            root.editor-original = "Actions";
            root.editor-translation = root.actions-translation;
        } else if block == 2 {
            root.editor-original = "Encampment (Castle)";
            root.editor-translation = root.encampment-translation;
        } else if block == 3 {
            root.editor-original = "Khalifate Human · quick, resilient";
            root.editor-translation = root.unit-translation;
        } else {
            root.editor-original = "End Turn";
            root.editor-translation = root.end-turn-translation;
        }
        root.editor-baseline = root.editor-translation;
        root.editor-visible = true;
        root.preview-state = 1;
        keyboard.focus();
    }
    keyboard-edit-selected => {
        if root.selected-block >= 0 && root.selected-block <= 4 && root.view-mode != 1 {
            root.edit-block(root.selected-block);
        }
    }
    commit-edit => {
        if root.preview-state == 3 { root.retry-save(); }
        else if root.editor-translation == root.editor-baseline { root.confirm-edit(); }
        else { root.save-edit(); }
    }
    save-edit => {
        if root.selected-block == 0 { root.menu-translation = root.editor-translation; }
        else if root.selected-block == 1 { root.actions-translation = root.editor-translation; }
        else if root.selected-block == 2 { root.encampment-translation = root.editor-translation; }
        else if root.selected-block == 3 { root.unit-translation = root.editor-translation; }
        else { root.end-turn-translation = root.editor-translation; }
        root.editor-baseline = root.editor-translation;
        root.preview-state = 2;
        root.editor-visible = false;
    }
    confirm-edit => { root.preview-state = 2; root.editor-visible = false; }
    cancel-edit => { root.preview-state = 0; root.editor-visible = false; }
    retry-save => { root.save-edit(); }
    copy-text => { root.copied = true; }
    save-file => { }
    delete-image => { root.preview-state = 4; root.editor-visible = false; }
    request-drag => { root.drag-request-count += 1; }
    request-close => { root.close-request-count += 1; }
    request-delete-image => { root.delete-request-count += 1; root.delete-image(); }

    keyboard := FocusScope {
        width: 960px;
        height: 614px;

        KeyBinding {
            enabled: !root.editor-visible && root.view-mode != 1;
            keys: @keys(Return);
            activated => { root.keyboard-edit-selected(); }
        }
        KeyBinding {
            enabled: root.editor-visible;
            keys: @keys(Escape);
            activated => { root.cancel-edit(); }
        }
        KeyBinding {
            enabled: root.editor-visible;
            keys: @keys(Control + Return);
            activated => { root.commit-edit(); }
        }

        ScreenImageResult {
            x: 0px; y: 0px; width: 960px; height: 614px;
            crop-image: root.fixture-image;
            view-mode: root.view-mode;
            pinned: root.pinned;
            selected-block: root.selected-block;
            editor-visible: root.editor-visible;
            image-expired: root.preview-state == 4;
            saved: root.save-confirmation-visible;
            save-error: root.preview-state == 3;
            copied: root.copied;
            dim-other-blocks: root.dim-other-blocks;
            dense-panel-active: root.dense-panel-active;
            image-content-width: root.dense-panel-active ? 632 : 960;
            dense-panel-width: root.dense-panel-active ? 320 : 0;
            use-fixture-blocks: !root.dense-panel-active;
            blocks: root.fixture-blocks;
            editor-panel-x: root.editor-panel-x;
            editor-panel-y: root.editor-panel-y;
            menu-translation: root.menu-translation;
            actions-translation: root.actions-translation;
            encampment-translation: root.encampment-translation;
            unit-translation: root.unit-translation;
            end-turn-translation: root.end-turn-translation;
            editor-original: root.editor-original;
            editor-baseline: root.editor-baseline;
            editor-translation <=> root.editor-translation;
            begin-drag-requested => { root.request-drag(); }
            close-requested => { root.request-close(); }
            view-requested(mode) => { root.choose-view(mode); }
            pin-requested => { root.toggle-pin(); }
            block-selected(block) => { root.select-block(block); }
            block-edit-requested(block) => { root.edit-block(block); }
            save-requested => { root.save-edit(); }
            confirm-requested => { root.confirm-edit(); }
            cancel-requested => { root.cancel-edit(); }
            retry-requested => { root.retry-save(); }
            copy-text-requested => { root.copy-text(); }
            save-file-requested => { root.save-file(); }
            delete-image-requested => { root.request-delete-image(); }
        }
    }
}
