import { Theme } from "overlay_theme.slint";
import { ScrollRail } from "controls.slint";

export struct ScreenBlockOverlay {
    block-id: string,
    source: string,
    translation: string,
    failed: bool,
    x: float,
    y: float,
    width: float,
    height: float,
    source-x: float,
    source-y: float,
    source-width: float,
    source-height: float,
    low-confidence: bool,
    replace-source: bool,
    placed: bool,
    not-placeable: bool,
    editable-source: bool,
    overflow: bool,
    callout: bool,
    font-size: float,
    angle: float,
    font-weight: int,
    // On the picture the text is drawn straight onto the rebuilt background
    // in the source's colour; DUAL's source-and-translation pair sits on a
    // plate of the background's colour.
    plate: color,
    ink: color,
    shadow: color,
}

export struct ScreenConnectorOverlay {
    block-id: string,
    start-x: float,
    start-y: float,
    end-x: float,
    end-y: float,
}

component OverlayButton inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Theme.red : #d7d3cc48;
    background: root.active
        ? Theme.red
        : touch.has-hover ? Theme.red-soft : #0c0f1450;
    opacity: root.enabled ? 1 : 0.28;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Text {
        text: root.label;
        color: root.active ? #0b0e13 : #dedad3;
        opacity: root.active ? 1 : (touch.has-hover ? 0.92 : 0.62);
        font-size: root.label.character-count > 6 ? 9px : 10px;
        font-weight: 680;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TranslatedLabel inherits Rectangle {
    in property <string> source-text;
    in property <string> translated-text;
    in property <bool> dual: false;
    in property <bool> selected-label: false;
    in property <bool> dimmed: false;
    in property <bool> callout: false;
    in property <bool> overflow: false;
    in property <length> text-size: 12px;
    in property <int> text-weight: 570;
    in property <bool> plated: true;
    in property <color> plate: #120e09;
    in property <color> ink: #f3e9cf;
    in property <color> shadow: transparent;
    out property <length> measured-content-height: translated-text-item.preferred-height + 8px;
    callback selected();
    callback edit-requested();

    border-radius: 3px;
    forward-focus: key-focus;
    border-width: root.selected-label || touch.has-hover ? 1px : 0px;
    border-color: root.selected-label ? Theme.red : root.ink.with-alpha(0.5);
    background: root.plated
        ? (touch.has-hover ? root.plate.mix(root.ink, 0.88) : root.plate)
        : (touch.has-hover ? root.ink.with-alpha(0.1) : transparent);
    clip: true;
    opacity: root.dimmed ? 0.38 : 1;
    accessible-role: button;
    // Five blocks with one name were indistinguishable to a screen reader.
    accessible-label: root.translated-text != "" ? root.translated-text : @tr("Editable translated image text");
    accessible-action-default => { root.edit-requested(); }

    if root.shadow.alpha > 0: Text {
        x: 5px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 3px;
        text: translated-text-item.text;
        color: root.shadow;
        font-size: translated-text-item.font-size;
        font-weight: root.text-weight;
        wrap: word-wrap;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
    translated-text-item := Text {
        x: 4px;
        y: 1px;
        width: parent.width - 8px;
        height: parent.height - 2px;
        text: root.dual
            ? root.source-text + "\n" + root.translated-text
            : root.translated-text;
        color: root.ink;
        font-size: max(12px, root.text-size);
        font-weight: root.text-weight;
        wrap: word-wrap;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
    if root.overflow: Rectangle {
        x: parent.width - 20px;
        y: parent.height - 18px;
        width: 18px;
        height: 16px;
        background: #9b5b20ff;
        border-radius: 3px;
        Text { text: "…"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { key-focus.focus(); root.selected(); }
        double-clicked => { root.edit-requested(); }
    }
    key-focus := FocusScope {
        x: 0px; y: 0px; width: 0px; height: 0px;
        key-pressed(event) => {
            if event.text == Key.Return {
                root.edit-requested();
                return accept;
            }
            reject
        }
    }
}

export component TranslationCorrectionPanel inherits Rectangle {
    in-out property <string> original-text: "End Turn";
    in property <string> block-source: "End Turn";
    property <bool> term-mode: root.original-text != root.block-source;
    in property <string> context-text: "Game interface";
    in property <string> baseline-translation: "Завершить ход";
    in property <bool> save-error: false;
    in property <bool> editor-focusable: true;
    in property <string> direction-text: "EN → RU";
    in-out property <string> edited-translation: "Завершить ход";
    callback save-requested();
    callback confirm-requested();
    callback cancel-requested();
    callback retry-requested();
    forward-focus: translation-input;
    init => { translation-input.focus(); }

    background: #16181cf7;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;

    Text {
        x: 14px; y: 12px;
        text: root.term-mode ? @tr("Glossary") : @tr("Correct translation");
        color: Theme.text;
        font-size: 14px;
        font-weight: 620;
    }
    Text {
        x: parent.width - 66px; y: 15px; width: 52px;
        text: root.direction-text;
        color: Theme.text-faint;
        font-size: 9px;
        font-weight: 650;
        horizontal-alignment: right;
    }
    Rectangle { x: 14px; y: 39px; width: parent.width - 28px; height: 1px; background: Theme.line; }

    Text { x: 14px; y: 50px; text: @tr("SOURCE PHRASE"); color: Theme.text-faint; font-size: 8px; font-weight: 680; letter-spacing: 0.6px; }

    source-frame := Rectangle {
        x: 14px; y: 65px; width: parent.width - 28px; height: 42px;
        border-radius: 6px;
        border-width: 1px;
        border-color: source-input.has-focus ? Theme.red : #3a3d43;
        background: #0f1115;
        source-input := TextInput {
            x: 9px; y: 6px; width: parent.width - 18px; height: parent.height - 12px;
            text <=> root.original-text;
            color: Theme.text;
            selection-background-color: #d85c5c60;
            font-size: 12px;
            wrap: word-wrap;
            enabled: root.editor-focusable;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel-requested();
                    return accept;
                }
                reject
            }
        }
    }

    Text { x: 14px; y: 114px; text: @tr("APPROVED TRANSLATION"); color: Theme.text-faint; font-size: 8px; font-weight: 680; letter-spacing: 0.6px; }

    input-frame := Rectangle {
        x: 14px; y: 129px; width: parent.width - 28px; height: 52px;
        border-radius: 6px;
        border-width: 1px;
        border-color: translation-input.has-focus ? Theme.red : #3a3d43;
        background: #0f1115;
        translation-input := TextInput {
            x: 9px; y: 7px; width: parent.width - 18px; height: parent.height - 14px;
            text <=> root.edited-translation;
            color: Theme.text;
            selection-background-color: #d85c5c60;
            font-size: 12px;
            wrap: word-wrap;
            enabled: root.editor-focusable;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel-requested();
                    return accept;
                }
                if event.modifiers.control && event.text == Key.Return {
                    if root.save-error { root.retry-requested(); }
                    else if !root.term-mode && root.edited-translation == root.baseline-translation { root.confirm-requested(); }
                    else { root.save-requested(); }
                    return accept;
                }
                reject
            }
        }
    }

    Text {
        x: 14px; y: 190px; width: parent.width - 28px;
        text: root.context-text;
        color: Theme.text-muted;
        font-size: 9px;
        overflow: elide;
    }
    if root.save-error: Text {
        x: 14px; y: 210px; width: parent.width - 28px;
        text: @tr("Save failed. Your correction is still here.");
        color: #e3a0a0;
        font-size: 9px;
    }

    HorizontalLayout {
        x: 14px; y: parent.height - 38px; width: parent.width - 28px; height: 24px;
        spacing: 7px;
        alignment: end;
        OverlayButton { width: 62px; label: @tr("Cancel"); clicked => { root.cancel-requested(); } }
        OverlayButton {
            width: root.save-error ? 64px : 70px;
            label: root.save-error
                ? @tr("Retry")
                : !root.term-mode && root.edited-translation == root.baseline-translation ? @tr("Confirm") : @tr("Save");
            active: true;
            clicked => {
                if root.save-error { root.retry-requested(); }
                else if !root.term-mode && root.edited-translation == root.baseline-translation { root.confirm-requested(); }
                else { root.save-requested(); }
            }
        }
    }
}

export component ScreenImageResult inherits Rectangle {
    in property <image> crop-image;
    // The capture with the replaced text rebuilt from its background, shown
    // under the translations; ORIG always shows the capture itself.
    in property <image> repaired-image;
    in property <bool> use-repaired-image: false;
    in property <int> view-mode: 3;
    in property <bool> pinned: false;
    in property <int> selected-block: 4;
    in property <bool> editor-visible: false;
    in property <bool> image-expired: false;
    in property <bool> saved: false;
    in property <bool> save-error: false;
    in property <bool> copied: false;
    in property <int> failed-blocks: 0;
    in property <bool> translating: false;
    in property <string> translation-notice;
    in property <bool> translation-retry-enabled: true;
    in property <length> notice-height: root.failed-blocks > 0 || root.translating || root.translation-notice != "" ? 52px : 0px;
    in property <bool> dim-other-blocks: false;
    in property <bool> use-fixture-blocks: true;
    in property <[ScreenBlockOverlay]> blocks;
    in property <[ScreenConnectorOverlay]> connectors;
    in property <float> image-content-width: root.width / 1px;
    in property <float> image-content-height: root.height / 1px;
    in property <float> total-content-height: root.height / 1px;
    out property <float> scroll-offset: -result-scroll.viewport-y / 1px;
    out property <float> scroll-x: -result-scroll.viewport-x / 1px;
    in property <float> editor-panel-x: 488;
    in property <float> editor-panel-y: 292;
    in property <length> minimum-overlay-font-size: 12px;
    in property <string> menu-translation: "Меню";
    in property <string> actions-translation: "Действия";
    in property <string> encampment-translation: "Лагерь (Замок)";
    in property <string> unit-translation: "Кочевник · быстрый, стойкий";
    in property <string> end-turn-translation: "Завершить ход";
    in-out property <string> editor-original: "End Turn";
    in property <string> editor-block-source: "End Turn";
    in property <string> editor-context: "Game interface";
    in property <string> editor-direction: "EN → RU";
    in property <string> editor-baseline: "Завершить ход";
    in-out property <string> editor-translation: "Завершить ход";
    in property <bool> editor-saving: false;
    callback begin-drag-requested();
    callback close-requested();
    callback view-requested(int);
    callback pin-requested();
    callback block-selected(int);
    callback block-edit-requested(int);
    callback save-requested();
    callback confirm-requested();
    callback cancel-requested();
    callback retry-requested();
    callback copy-text-requested();
    callback save-file-requested();
    callback delete-image-requested();
    callback translation-retry-requested();

    border-radius: 9px;
    border-width: 0px;
    background: @linear-gradient(145deg,
        rgba(65, 150, 196, 0.075) 0%,
        rgba(8, 24, 39, 0.16) 48%,
        rgba(58, 148, 195, 0.06) 100%);
    clip: true;

    Rectangle { width: parent.width; height: parent.height; background: Theme.glass; }
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/slate-blue-glass-wash.svg");
        image-fit: fill;
        opacity: 0.16;
    }
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/slate-matte-grain.svg");
        image-fit: fill;
        opacity: 0.07;
    }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 38px; background: #0d1219ff; }

    TouchArea {
        x: 0px; y: 0px; width: parent.width; height: 38px;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.begin-drag-requested();
            }
        }
    }
    OverlayButton { x: 14px; y: 7px; width: 44px; label: @tr("ORIG"); accessible-name: @tr("Original text"); active: root.view-mode == 1; clicked => { root.view-requested(1); } }
    OverlayButton { x: 64px; y: 7px; width: 44px; label: @tr("DUAL"); accessible-name: @tr("Original and translation"); active: root.view-mode == 2; clicked => { root.view-requested(2); } }
    OverlayButton { x: 114px; y: 7px; width: 78px; label: @tr("ON IMAGE"); accessible-name: @tr("Translation on the image"); active: root.view-mode == 3; clicked => { root.view-requested(3); } }
    OverlayButton { x: 198px; y: 7px; width: 32px; label: "↓"; accessible-name: @tr("Save file"); enabled: !root.image-expired && !root.translating; clicked => { root.save-file-requested(); } }
    OverlayButton { x: 236px; y: 7px; width: 38px; label: @tr("DEL"); accessible-name: @tr("Delete image"); enabled: !root.image-expired && !root.translating; clicked => { root.delete-image-requested(); } }
    OverlayButton { x: parent.width - 96px; y: 7px; width: 44px; label: @tr("PIN"); accessible-name: root.pinned ? @tr("Unpin window") : @tr("Keep window on top"); active: root.pinned; clicked => { root.pin-requested(); } }
    OverlayButton { x: parent.width - 46px; y: 7px; width: 38px; label: "×"; accessible-name: @tr("Close"); clicked => { root.close-requested(); } }
    if root.notice-height > 0px: Rectangle {
        x: 0px; y: 38px; width: parent.width; height: root.notice-height;
        background: #30291eff;
        Text {
            x: 10px; y: 4px; width: parent.width - 126px; height: parent.height - 8px;
            text: root.translating ? @tr("Translating…") : root.translation-notice != "" ? root.translation-notice : @tr("Some parts could not be translated. The original text is marked.");
            color: #f2d6a1; font-size: 12px; wrap: word-wrap; vertical-alignment: center;
        }
        OverlayButton {
            x: parent.width - 110px; y: (parent.height - self.height) / 2;
            width: 100px; label: @tr("Retry translation");
            enabled: root.translation-retry-enabled && !root.translating && !root.image-expired && !root.editor-visible;
            clicked => { root.translation-retry-requested(); }
        }
    }
    content := Rectangle {
        x: 0px; y: 38px + root.notice-height;
        width: parent.width;
        height: parent.height - 38px - root.notice-height;
        background: #0b0d11;
        clip: true;

        result-scroll := Flickable {
            visible: root.view-mode != 0 && !root.image-expired;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewport-width: root.image-content-width * 1px;
            viewport-height: root.total-content-height * 1px;
            Rectangle {
                width: root.image-content-width * 1px;
                height: root.total-content-height * 1px;
                background: #0b0d11;
            }
            image-content := Rectangle {
                x: 0px;
                y: 0px;
                width: root.image-content-width * 1px;
                height: root.image-content-height * 1px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.use-repaired-image && root.view-mode != 1 ? root.repaired-image : root.crop-image;
                    image-fit: fill;
                }
            }

            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 3px; y: 1px; width: 75px; height: root.view-mode == 2 ? 28px : 18px;
                source-text: "Menu"; translated-text: root.menu-translation; dual: root.view-mode == 2; text-size: root.minimum-overlay-font-size;
                selected-label: root.selected-block == 0;
                dimmed: root.dim-other-blocks && root.selected-block != 0;
                selected => { root.block-selected(0); }
                edit-requested => { root.block-edit-requested(0); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 80px; y: 1px; width: 76px; height: root.view-mode == 2 ? 28px : 18px;
                source-text: "Actions"; translated-text: root.actions-translation; dual: root.view-mode == 2; text-size: root.minimum-overlay-font-size;
                selected-label: root.selected-block == 1;
                dimmed: root.dim-other-blocks && root.selected-block != 1;
                selected => { root.block-selected(1); }
                edit-requested => { root.block-edit-requested(1); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 830px; y: 216px; width: 126px; height: root.view-mode == 2 ? 34px : 19px;
                source-text: "Encampment (Castle)"; translated-text: root.encampment-translation; dual: root.view-mode == 2; text-size: root.minimum-overlay-font-size;
                selected-label: root.selected-block == 2;
                dimmed: root.dim-other-blocks && root.selected-block != 2;
                selected => { root.block-selected(2); }
                edit-requested => { root.block-edit-requested(2); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: TranslatedLabel {
                x: 830px; y: 379px; width: 126px; height: root.view-mode == 2 ? 54px : 40px;
                source-text: "Khalifate Human · quick, resilient";
                translated-text: root.unit-translation;
                dual: root.view-mode == 2;
                selected-label: root.selected-block == 3;
                dimmed: root.dim-other-blocks && root.selected-block != 3;
                text-size: root.minimum-overlay-font-size;
                selected => { root.block-selected(3); }
                edit-requested => { root.block-edit-requested(3); }
            }
            if root.use-fixture-blocks && root.view-mode != 1: end-turn := TranslatedLabel {
                x: 832px; y: 538px; width: 123px; height: root.view-mode == 2 ? 36px : 31px;
                source-text: "End Turn";
                translated-text: root.end-turn-translation;
                dual: root.view-mode == 2;
                selected-label: root.selected-block == 4;
                dimmed: root.dim-other-blocks && root.selected-block != 4;
                text-size: root.minimum-overlay-font-size;
                selected => { root.block-selected(4); }
                edit-requested => { root.block-edit-requested(4); }
            }

            for block[index] in root.blocks: TranslatedLabel {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.placed;
                x: block.x * 1px;
                y: block.y * 1px;
                width: block.width * 1px;
                height: block.height * 1px;
                transform-origin: { x: 0px, y: 0px };
                transform-rotation: block.angle * 1deg;
                source-text: block.source;
                translated-text: block.translation;
                dual: root.view-mode == 2;
                selected-label: root.selected-block == index;
                dimmed: root.dim-other-blocks && root.selected-block != index;
                callout: block.callout;
                overflow: block.overflow;
                text-size: max(root.minimum-overlay-font-size, block.font-size * 1px);
                text-weight: block.font-weight;
                plated: block.callout || root.view-mode == 2;
                plate: block.plate;
                ink: block.ink;
                shadow: block.shadow;
                border-color: block.low-confidence && !self.selected-label ? #d7a45b : Theme.red;
                selected => { root.block-selected(index); }
                edit-requested => { root.block-edit-requested(index); }
            }

            // Unchanged alphabetic text keeps its pixels, but can still be
            // selected and confirmed in the glossary.
            for block[index] in root.blocks: Rectangle {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.editable-source;
                x: block.source-x * 1px; y: block.source-y * 1px;
                width: block.source-width * 1px; height: block.source-height * 1px;
                background: transparent;
                border-width: root.selected-block == index || source-touch.has-hover ? 1px : 0px;
                border-color: #f3e9cf80;
                source-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.block-selected(index); }
                    double-clicked => { root.block-edit-requested(index); }
                }
            }

            // Unplaceable text keeps every original pixel intact. The small
            // amber outline makes the exceptional row explicit and remains an
            // editing target without introducing a translation side panel.
            for block[index] in root.blocks: Rectangle {
                visible: !root.use-fixture-blocks && root.view-mode != 1 && block.not-placeable;
                x: block.source-x * 1px;
                y: block.source-y * 1px;
                width: block.source-width * 1px;
                height: block.source-height * 1px;
                background: transparent;
                border-width: 1px;
                border-color: #d7a45b;
                border-radius: 2px;
                marker-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.block-selected(index); }
                    double-clicked => { root.block-edit-requested(index); }
                }
            }

        }

        ScrollRail {
            visible: result-scroll.visible && result-scroll.viewport-height > result-scroll.height + 0.5px;
            x: parent.width - 7px; y: 0px;
            track: result-scroll.height;
            content: result-scroll.viewport-height; shown: result-scroll.height;
            offset: -result-scroll.viewport-y;
            scrolled(next) => { result-scroll.viewport-y = -next; }
        }
        ScrollRail {
            visible: result-scroll.visible && result-scroll.viewport-width > result-scroll.width + 0.5px;
            horizontal: true;
            x: 0px; y: parent.height - 7px;
            track: result-scroll.width;
            content: result-scroll.viewport-width; shown: result-scroll.width;
            offset: -result-scroll.viewport-x;
            scrolled(next) => { result-scroll.viewport-x = -next; }
        }

        if root.editor-visible: inline-editor := TranslationCorrectionPanel {
            x: max(8px, min(root.editor-panel-x * 1px, parent.width - self.width - 8px));
            y: max(8px, min(root.editor-panel-y * 1px, parent.height - self.height - 8px));
            width: min(330px, parent.width - 16px);
            height: min(282px, parent.height - 16px);
            original-text <=> root.editor-original;
            block-source: root.editor-block-source;
            context-text: root.editor-context;
            direction-text: root.editor-direction;
            baseline-translation: root.editor-baseline;
            edited-translation <=> root.editor-translation;
            save-error: root.save-error;
            editor-focusable: !root.editor-saving;
            save-requested => { root.save-requested(); }
            confirm-requested => { root.confirm-requested(); }
            cancel-requested => { root.cancel-requested(); }
            retry-requested => { root.retry-requested(); }
        }

        // Text mode is reached by clicking the active view button again while
        // the picture is still available, so a long result must scroll here
        // exactly as it does over the image.
        text-scroll := Flickable {
            visible: root.view-mode == 0;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewport-width: self.width;
            viewport-height: max(self.height, text-column.preferred-height + 36px);
            text-column := VerticalLayout {
                x: 18px;
                y: 18px;
                width: text-scroll.width - 36px;
                spacing: 12px;
                if root.use-fixture-blocks: Text { text: root.menu-translation + " · " + root.actions-translation + " · " + root.encampment-translation; color: Theme.text; font-size: 14px; font-weight: 470; }
                if root.use-fixture-blocks: Text { text: root.unit-translation; color: Theme.text; font-size: 14px; font-weight: 470; }
                if root.use-fixture-blocks: Text { text: root.end-turn-translation; color: Theme.text; font-size: 14px; font-weight: 470; }
                for block in root.blocks: Text {
                    visible: !root.use-fixture-blocks;
                    text: block.failed ? @tr("Not translated") + ": " + block.source : block.translation;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 470;
                    wrap: word-wrap;
                }
            }
        }
        ScrollRail {
            visible: text-scroll.visible && text-scroll.viewport-height > text-scroll.height + 0.5px;
            x: parent.width - 7px; y: 0px;
            track: text-scroll.height;
            content: text-scroll.viewport-height; shown: text-scroll.height;
            offset: -text-scroll.viewport-y;
            scrolled(next) => { text-scroll.viewport-y = -next; }
        }

        if root.image-expired: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #111318;
            expired-panel := Rectangle {
                x: 18px;
                y: max(12px, (parent.height - self.height) / 2);
                width: parent.width - 36px;
                height: min(150px, parent.height - 24px);
                Text {
                    y: 0px; width: parent.width; height: 30px;
                    text: @tr("Image expired");
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 620;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    y: 42px; width: parent.width; height: 38px;
                    text: @tr("The temporary screenshot was removed. Your text translation remains available.");
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                OverlayButton {
                    x: (parent.width - 104px) / 2;
                    y: 96px;
                    width: 104px;
                    label: root.copied ? @tr("COPIED") : @tr("COPY TEXT");
                    active: root.copied;
                    clicked => { root.copy-text-requested(); }
                }
            }
        }

        if root.saved: Rectangle {
            x: parent.width - 180px; y: 12px; width: 162px; height: 28px;
            border-radius: 6px;
            border-width: 1px;
            border-color: #52675a;
            background: #17211bed;
            Text { text: "✓  " + @tr("Saved to glossary"); color: #c8decf; font-size: 10px; font-weight: 560; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// Production screen results own a dedicated component and native window for
// their entire lifetime. The compact TranslationPreview never changes into
// this surface, so pinning, editing and dragging cannot rewrite its HWND
// contract or reveal compact-popup chrome.
export component ScreenTranslationWindow inherits Window {
    title: @tr("Screen translation result");
    preferred-width: root.screen-content-width * 1px;
    preferred-height: max(
        (root.screen-content-height + 38 + root.screen-notice-height) * 1px,
        root.screen-editor-visible ? (340 + root.screen-notice-height) * 1px : 0px
    );
    min-width: 380px;
    // Keep the toolbar usable without stretching short captures. Large results
    // retain their existing resize floor; small ones fit the image and notice.
    min-height: root.screen-editor-visible
        ? (340 + root.screen-notice-height) * 1px
        : min(340px, root.preferred-height);
    no-frame: true;
    always-on-top: false;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    in-out property <string> request-id;
    in-out property <bool> prepared: false;
    in-out property <bool> pinned: false;
    in-out property <bool> pin-enabled: true;
    // Set when the input host confirms the copy, cleared with new content.
    in-out property <bool> screen-copied: false;
    in-out property <int> screen-failed-blocks: 0;
    in-out property <bool> screen-translating: false;
    in-out property <string> screen-translation-notice;
    in-out property <bool> screen-translation-retry-enabled: true;
    out property <float> screen-notice-height: screen-failed-blocks > 0 || screen-translating || screen-translation-notice != "" ? 52 : 0;
    in-out property <image> screen-crop-image;
    in-out property <image> screen-repaired-image;
    in-out property <bool> screen-use-repaired-image: false;
    in-out property <[ScreenBlockOverlay]> screen-blocks;
    in-out property <[ScreenConnectorOverlay]> screen-connectors;
    in-out property <float> screen-content-width: 960;
    in-out property <float> screen-content-height: 576;
    in-out property <float> screen-image-content-width: 960;
    in-out property <float> screen-image-content-height: 576;
    in-out property <float> screen-total-content-height: 576;
    out property <float> screen-scroll-offset: image-view.scroll-offset;
    out property <float> screen-scroll-x: image-view.scroll-x;
    out property <float> screen-visible-width: root.width / 1px;
    out property <float> screen-visible-height: (root.height - 38px) / 1px - root.screen-notice-height;
    in-out property <int> screen-view-mode: 3;
    in-out property <int> screen-selected-block: -1;
    in-out property <bool> screen-editor-visible: false;
    property <length> before-editor-height: 0px;
    property <bool> before-editor-fit-content: false;
    property <length> expanded-editor-height: 0px;
    changed screen-editor-visible => {
        if root.screen-editor-visible {
            root.before-editor-height = root.height;
            root.before-editor-fit-content = abs(root.height
                - (root.screen-content-height + 38 + root.screen-notice-height) * 1px) <= 1px;
            root.expanded-editor-height = max(root.height, (340 + root.screen-notice-height) * 1px);
            root.height = root.expanded-editor-height;
        } else if root.before-editor-height > 0px
            && abs(root.height - root.expanded-editor-height) <= 1px {
            // Native minimums grow the surface but do not shrink it again.
            // Restore only our expansion; keep a size the user chose instead.
            // A successful edit may have removed the last failure notice.
            root.height = root.before-editor-fit-content
                ? root.preferred-height : root.before-editor-height;
        }
    }
    in-out property <bool> screen-image-expired: false;
    in-out property <bool> screen-saved: false;
    in-out property <bool> screen-save-error: false;
    in-out property <string> screen-editor-original;
    in-out property <string> screen-editor-block-source;
    in-out property <string> screen-editor-context;
    in-out property <string> screen-editor-direction;
    in-out property <string> screen-editor-baseline;
    in-out property <string> screen-editor-translation;
    in-out property <bool> screen-editor-saving: false;
    in-out property <float> screen-editor-panel-x: 8;
    in-out property <float> screen-editor-panel-y: 8;
    in-out property <string> measure-text;
    in-out property <float> measure-width: 180;
    in-out property <float> measure-font-size: 12;
    in-out property <int> measure-font-weight: 570;
    out property <float> measured-text-width: measure-item.preferred-width / 1px;
    out property <float> measured-text-height: measure-item.preferred-height / 1px;

    callback begin-drag();
    callback begin-resize();
    callback pin-state-changed(bool);
    callback screen-block-selected(int);
    callback screen-block-edit-requested(int);
    callback screen-view-state-changed(int);
    callback screen-copy-text-requested();
    callback screen-save-file-requested();
    callback screen-delete-image-requested();
    callback screen-close-requested();
    callback screen-editor-save-requested();
    callback screen-editor-confirm-requested();
    callback screen-editor-cancel-requested();
    callback screen-editor-retry-requested();
    callback screen-translation-retry-requested();

    measure-item := Text {
        visible: false;
        x: 0px;
        y: 0px;
        width: root.measure-width * 1px;
        height: 0px;
        text: root.measure-text;
        font-size: root.measure-font-size * 1px;
        font-weight: root.measure-font-weight;
        wrap: word-wrap;
    }

    image-view := ScreenImageResult {
        width: parent.width;
        height: parent.height;
        crop-image: root.screen-crop-image;
        repaired-image: root.screen-repaired-image;
        use-repaired-image: root.screen-use-repaired-image;
        view-mode: root.screen-view-mode;
        pinned: root.pinned;
        selected-block: root.screen-selected-block;
        editor-visible: root.screen-editor-visible;
        image-expired: root.screen-image-expired;
        copied: root.screen-copied;
        failed-blocks: root.screen-failed-blocks;
        translating: root.screen-translating;
        translation-notice: root.screen-translation-notice;
        translation-retry-enabled: root.screen-translation-retry-enabled;
        saved: root.screen-saved;
        save-error: root.screen-save-error;
        dim-other-blocks: root.screen-editor-visible;
        image-content-width: root.screen-image-content-width;
        image-content-height: root.screen-image-content-height;
        total-content-height: root.screen-total-content-height;
        use-fixture-blocks: false;
        blocks: root.screen-blocks;
        connectors: root.screen-connectors;
        editor-original <=> root.screen-editor-original;
        editor-block-source: root.screen-editor-block-source;
        editor-context: root.screen-editor-context;
        editor-direction: root.screen-editor-direction;
        editor-baseline: root.screen-editor-baseline;
        editor-translation <=> root.screen-editor-translation;
        editor-saving: root.screen-editor-saving;
        editor-panel-x: root.screen-editor-panel-x;
        editor-panel-y: root.screen-editor-panel-y;
        begin-drag-requested => { root.begin-drag(); }
        close-requested => { root.screen-close-requested(); }
        view-requested(mode) => {
            root.screen-view-mode = root.screen-view-mode == mode ? 0 : mode;
            root.screen-view-state-changed(root.screen-view-mode);
        }
        pin-requested => {
            if root.pin-enabled {
                root.pinned = !root.pinned;
                root.pin-state-changed(root.pinned);
            }
        }
        block-selected(block) => {
            root.screen-selected-block = block;
            root.screen-block-selected(block);
        }
        block-edit-requested(block) => {
            if !root.screen-translating {
                root.screen-selected-block = block;
                root.screen-block-edit-requested(block);
            }
        }
        copy-text-requested => { root.screen-copy-text-requested(); }
        save-file-requested => { root.screen-save-file-requested(); }
        delete-image-requested => { root.screen-delete-image-requested(); }
        save-requested => { root.screen-editor-save-requested(); }
        confirm-requested => { root.screen-editor-confirm-requested(); }
        cancel-requested => { root.screen-editor-cancel-requested(); }
        retry-requested => { root.screen-editor-retry-requested(); }
        translation-retry-requested => { root.screen-translation-retry-requested(); }
    }
    resize-corner := TouchArea {
        x: parent.width - 10px;
        y: parent.height - 10px;
        width: 10px;
        height: 10px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.begin-resize();
            }
        }
    }
}

export component ScreenTranslationPreviewWindow inherits Window {
    title: "Screen translation visual preview";
    preferred-width: 960px;
    preferred-height: 614px;
    min-width: 960px;
    min-height: 614px;
    no-frame: true;
    // Screen results behave like ordinary windows until the user explicitly
    // pins them. Native presentation applies the same contract in production.
    always-on-top: false;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";
    forward-focus: keyboard;

    in-out property <int> preview-state: 0;
    // Set by the developer preview from a file in the source tree. The GPL
    // screenshot must not be compiled into the program.
    in property <image> fixture-image;
    in-out property <int> view-mode: 3;
    in-out property <bool> pinned: false;
    in-out property <bool> editor-visible: false;
    in-out property <int> selected-block: 4;
    in-out property <bool> copied: false;
    in-out property <[ScreenBlockOverlay]> fixture-blocks;
    out property <bool> dim-other-blocks: root.editor-visible;
    out property <bool> save-confirmation-visible: root.preview-state == 2;
    out property <float> editor-panel-x: root.selected-block <= 1 ? 164 : 488;
    out property <float> editor-panel-y: root.selected-block <= 1
        ? 30
        : root.selected-block == 2 ? 100
        : 292;
    in-out property <string> menu-translation: "Меню";
    in-out property <string> actions-translation: "Действия";
    in-out property <string> encampment-translation: "Лагерь (Замок)";
    in-out property <string> unit-translation: "Кочевник · быстрый, стойкий";
    in-out property <string> end-turn-translation: "Завершить ход";
    in-out property <string> editor-original: "End Turn";
    in-out property <string> editor-baseline: "Завершить ход";
    in-out property <string> editor-translation: "Завершить ход";
    out property <int> drag-request-count: 0;
    out property <int> close-request-count: 0;
    out property <int> delete-request-count: 0;
    callback choose-view(int);
    callback toggle-pin();
    callback select-block(int);
    callback edit-block(int);
    callback keyboard-edit-selected();
    callback commit-edit();
    callback save-edit();
    callback confirm-edit();
    callback cancel-edit();
    callback retry-save();
    callback copy-text();
    callback save-file();
    callback delete-image();
    callback request-drag();
    callback request-close();
    callback request-delete-image();

    choose-view(mode) => { root.view-mode = root.view-mode == mode ? 0 : mode; root.editor-visible = false; }
    toggle-pin => { root.pinned = !root.pinned; }
    select-block(block) => {
        root.selected-block = block;
        root.editor-visible = false;
        root.preview-state = 0;
    }
    edit-block(block) => {
        root.selected-block = block;
        if block == 0 {
            root.editor-original = "Menu";
            root.editor-translation = root.menu-translation;
        } else if block == 1 {
            root.editor-original = "Actions";
            root.editor-translation = root.actions-translation;
        } else if block == 2 {
            root.editor-original = "Encampment (Castle)";
            root.editor-translation = root.encampment-translation;
        } else if block == 3 {
            root.editor-original = "Khalifate Human · quick, resilient";
            root.editor-translation = root.unit-translation;
        } else {
            root.editor-original = "End Turn";
            root.editor-translation = root.end-turn-translation;
        }
        root.editor-baseline = root.editor-translation;
        root.editor-visible = true;
        root.preview-state = 1;
        keyboard.focus();
    }
    keyboard-edit-selected => {
        if root.selected-block >= 0 && root.selected-block <= 4 && root.view-mode != 1 {
            root.edit-block(root.selected-block);
        }
    }
    commit-edit => {
        if root.preview-state == 3 { root.retry-save(); }
        else if root.editor-translation == root.editor-baseline { root.confirm-edit(); }
        else { root.save-edit(); }
    }
    save-edit => {
        if root.selected-block == 0 { root.menu-translation = root.editor-translation; }
        else if root.selected-block == 1 { root.actions-translation = root.editor-translation; }
        else if root.selected-block == 2 { root.encampment-translation = root.editor-translation; }
        else if root.selected-block == 3 { root.unit-translation = root.editor-translation; }
        else { root.end-turn-translation = root.editor-translation; }
        root.editor-baseline = root.editor-translation;
        root.preview-state = 2;
        root.editor-visible = false;
    }
    confirm-edit => { root.preview-state = 2; root.editor-visible = false; }
    cancel-edit => { root.preview-state = 0; root.editor-visible = false; }
    retry-save => { root.save-edit(); }
    copy-text => { root.copied = true; }
    save-file => { }
    delete-image => { root.preview-state = 4; root.editor-visible = false; }
    request-drag => { root.drag-request-count += 1; }
    request-close => { root.close-request-count += 1; }
    request-delete-image => { root.delete-request-count += 1; root.delete-image(); }

    keyboard := FocusScope {
        width: 960px;
        height: 614px;

        KeyBinding {
            enabled: !root.editor-visible && root.view-mode != 1;
            keys: @keys(Return);
            activated => { root.keyboard-edit-selected(); }
        }
        KeyBinding {
            enabled: root.editor-visible;
            keys: @keys(Escape);
            activated => { root.cancel-edit(); }
        }
        KeyBinding {
            enabled: root.editor-visible;
            keys: @keys(Control + Return);
            activated => { root.commit-edit(); }
        }

        ScreenImageResult {
            x: 0px; y: 0px; width: 960px; height: 614px;
            crop-image: root.fixture-image;
            view-mode: root.view-mode;
            pinned: root.pinned;
            selected-block: root.selected-block;
            editor-visible: root.editor-visible;
            image-expired: root.preview-state == 4;
            saved: root.save-confirmation-visible;
            save-error: root.preview-state == 3;
            copied: root.copied;
            dim-other-blocks: root.dim-other-blocks;
            image-content-width: 960;
            use-fixture-blocks: true;
            blocks: root.fixture-blocks;
            editor-panel-x: root.editor-panel-x;
            editor-panel-y: root.editor-panel-y;
            menu-translation: root.menu-translation;
            actions-translation: root.actions-translation;
            encampment-translation: root.encampment-translation;
            unit-translation: root.unit-translation;
            end-turn-translation: root.end-turn-translation;
            editor-original: root.editor-original;
            editor-baseline: root.editor-baseline;
            editor-translation <=> root.editor-translation;
            begin-drag-requested => { root.request-drag(); }
            close-requested => { root.request-close(); }
            view-requested(mode) => { root.choose-view(mode); }
            pin-requested => { root.toggle-pin(); }
            block-selected(block) => { root.select-block(block); }
            block-edit-requested(block) => { root.edit-block(block); }
            save-requested => { root.save-edit(); }
            confirm-requested => { root.confirm-edit(); }
            cancel-requested => { root.cancel-edit(); }
            retry-requested => { root.retry-save(); }
            copy-text-requested => { root.copy-text(); }
            save-file-requested => { root.save-file(); }
            delete-image-requested => { root.request-delete-image(); }
        }
    }
}
