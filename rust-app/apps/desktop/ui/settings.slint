// The settings window.
//
// The shell is three rows: topline, workspace, footer. The topline and the
// footer are a fixed height and always fit; the workspace takes the rest and
// scrolls when the rest is less than a page needs, which is what lets the
// window be dragged to any size without anything being cut off.

import { Sheet } from "sheet.slint";
import { Fact } from "parts.slint";
import { ModelRow, ProviderRow, HistoryRow, GlossaryRow, HotkeyRow, ResourceRow } from "rows.slint";
import { RowAction, ScrollRail } from "controls.slint";
import { ModelsPage, ProvidersPage, HistoryPage, GlossaryPage } from "pages_lists.slint";
import { TranslationPage, HotkeysPage } from "pages_forms.slint";
import { OverviewPage, DictationPage, VisualsPage, ResourcesPage, AboutPage } from "pages_instruments.slint";
import { SlateLine } from "recording_visual.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    forward-focus: focus;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-enabled: true;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    height: 42px;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Sheet.ink;
    background: root.active
        ? Sheet.ink
        : (touch.has-hover ? Sheet.raised : transparent);

    HorizontalLayout {
        padding-left: 15px;
        padding-right: 15px;
        spacing: 14px;

        // The mark is the same square the rest of the interface uses for
        // "this one", filled when the page is the one you are on.
        Rectangle {
            width: 9px;
            height: 9px;
            y: (parent.height - self.height) / 2;
            background: root.active ? Sheet.on-ink : transparent;
            border-width: root.active ? 0px : 1px;
            border-color: Sheet.hairline;
        }
        Text {
            text: root.label;
            color: root.active ? Sheet.on-ink : Sheet.ink;
            font-size: Sheet.body-size;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component SettingsNavigation inherits VerticalLayout {
    in property <int> active-page;
    callback select-page(int);

    width: Sheet.nav-width;
    spacing: 6px;

    Text {
        text: @tr("Tools");
        color: Sheet.muted;
        font-size: Sheet.detail-size;
        height: 22px;
    }

    NavItem { label: @tr("Overview"); active: root.active-page == 0; clicked => { root.select-page(0); } }
    NavItem { label: @tr("Dictation"); active: root.active-page == 1; clicked => { root.select-page(1); } }
    NavItem { label: @tr("Translation"); active: root.active-page == 2; clicked => { root.select-page(2); } }
    NavItem { label: @tr("Models"); active: root.active-page == 3; clicked => { root.select-page(3); } }
    NavItem { label: @tr("Providers"); active: root.active-page == 4; clicked => { root.select-page(4); } }
    NavItem { label: @tr("Visuals"); active: root.active-page == 5; clicked => { root.select-page(5); } }
    NavItem { label: @tr("History"); active: root.active-page == 6; clicked => { root.select-page(6); } }
    NavItem { label: @tr("Glossary"); active: root.active-page == 7; clicked => { root.select-page(7); } }
    NavItem { label: @tr("Hotkeys"); active: root.active-page == 8; clicked => { root.select-page(8); } }
    NavItem { label: @tr("Resources"); active: root.active-page == 9; clicked => { root.select-page(9); } }
    NavItem { label: @tr("About"); active: root.active-page == 10; clicked => { root.select-page(10); } }

    Rectangle { vertical-stretch: 1; }
}

export component SettingsWindow inherits Window {
    in property <string> window-title: "SayFlex";
    title: root.window-title;
    icon: @image-url("../assets/tray-icon.svg");
    // Small enough to be worth dragging to. The pages are still drawn at the
    // size they were designed for; the workspace scrolls to whatever is left,
    // so this number decides how small the window may get and nothing else.
    // The topline and the footer are the only parts that must always fit.
    min-width: 520px;
    min-height: 300px;
    // Without these the window opens at whatever the current page happens to
    // need and changes size when the page does, which is the interface moving
    // under the pointer.
    preferred-width: 1000px;
    preferred-height: 720px;
    background: Sheet.canvas;
    default-font-family: "Segoe UI Variable Text";

    // ── what page, and what the frame says ──
    in-out property <int> active-page: 0;
    // The custom rail needs the same geometry as the native Flickable. Wheel
    // and touchpad input remain owned by Slint; these properties only project
    // its position and accept deliberate rail drags.
    in-out property <length> workspace-scroll-y: 0px;
    out property <length> workspace-scroll-content-height: work.viewport-height;
    out property <length> workspace-scroll-shown-height: work.height;
    in property <string> today: "";
    in property <string> app-version: "";
    in-out property <string> ui-locale: "system";
    in property <string> ui-locale-label: @tr("System language");
    in-out property <string> runtime-status: @tr("Starting workers…");
    in-out property <string> indicator-status: @tr("Idle");
    /// Whether the line above reports something that went wrong, rather than
    /// something that is merely happening. Set by the same code that writes the
    /// message, because only that code knows.
    in property <bool> status-is-a-problem: false;
    /// Whether a recording would reach a service, and whether a selection
    /// would. Two answers, because the two lists are separate and either can be
    /// true on its own — one boolean said AUDIO LEAVES DEVICE when only the
    /// text was going anywhere.
    in property <bool> audio-leaves-device: false;
    in property <bool> text-leaves-device: false;
    /// The three words along the bottom, written where the lists are read.
    /// Which provider row has its key form open, if any.
    ///
    /// On the window rather than only on the page, because the code that sends
    /// the key is the only thing that knows the send succeeded — and until this
    /// existed it had no way to close the form it had promised to close.
    in-out property <string> provider-editing: "";
    in property <string> departure-badge: @tr("LOCAL · PRIVATE");

    // ── Overview ──
    in property <string> overview-statement: @tr("Starting up");
    in property <string> overview-sub: "";
    in property <[Fact]> overview-facts;
    in property <string> overview-note;
    in property <string> overview-note-action;
    in property <bool> overview-note-signal: false;

    // ── Dictation ──
    in property <string> dictation-subtitle: @tr("Local speech");
    in property <string> dictation-readout: "";
    in property <string> dictation-caption: "";
    in-out property <int> speech-backend-index: 0;
    in property <bool> speech-backend-verified: false;
    in property <string> speech-backend-detail: "";
    in property <string> cuda-setup-status: "";
    in property <string> cuda-setup-description: "";
    in property <string> cuda-setup-error: "";
    in property <string> cuda-download-label: @tr("Accept and download");
    in property <float> cuda-setup-progress: 0;
    in property <bool> cuda-setup-busy: false;
    in property <bool> cuda-can-download: false;
    in property <bool> cuda-can-cancel: false;
    in property <bool> cuda-can-activate: false;
    in-out property <string> output-mode: "original";
    in-out property <string> output-mode-label: @tr("Original language");
    in property <bool> output-mode-locked: false;
    in-out property <string> dictation-language: "auto";
    in-out property <string> dictation-language-label: @tr("Auto-detect");
    in-out property <string> release-mode: "fastest";
    in-out property <string> insertion-mode: "clipboard";
    in-out property <string> release-mode-label: @tr("Fast response");
    in property <bool> release-mode-locked: false;
    in property <string> release-mode-note: "";
    in-out property <bool> history-enabled: true;
    in property <string> dictate-hotkey: "Ctrl + Alt + Space";

    // ── Translation ──
    in-out property <bool> translation-enabled: false;
    in property <bool> translation-ready: false;
    in property <string> translation-model-name: "";
    in property <string> translation-model-detail: "";
    in-out property <string> translation-delivery: "preview";
    in property <string> translation-delivery-label: @tr("Show a preview");
    in-out property <string> text-action-mode: "adaptive";
    in property <string> text-action-mode-label: @tr("Decide from the text");
    in-out property <bool> translation-warm: true;
    in-out property <int> translation-blur-radius: 3;
    in-out property <string> translation-primary-language: "English";
    in-out property <string> translation-primary-language-value: "en";
    in-out property <string> translation-secondary-language: "Russian";
    in-out property <string> translation-secondary-language-value: "ru";
    in property <string> translation-note: "";
    in property <string> translation-note-action: "";
    in property <bool> translation-note-signal: false;
    in-out property <bool> screenshot-retention-enabled: true;
    in property <string> screenshot-retention-summary: @tr("Temporary screen captures are kept for up to 24 hours and 500 MB. The size limit can remove older captures sooner.");

    // ── the lists ──
    // Speech models then the translator, in one list: the page is about
    // models, and the row says which kind it is.
    in property <[ModelRow]> model-rows;
    in property <string> models-summary: "";
    in property <[ProviderRow]> provider-rows;
    in property <string> provider-claim: "";
    in property <[HistoryRow]> history-rows;
    in property <string> history-scope: "";
    in property <[GlossaryRow]> glossary-rows;
    in-out property <string> glossary-query: "";
    in-out property <string> glossary-editing-id: "";
    in-out property <string> glossary-draft-source: "";
    in-out property <string> glossary-draft-translation: "";
    in property <string> glossary-problem: "";
    in property <bool> glossary-can-retry: false;
    in property <[HotkeyRow]> hotkey-rows;
    in-out property <length> models-scroll-y: 0px;
    in-out property <length> models-scroll-content-height: 0px;
    in-out property <length> models-scroll-shown-height: 0px;
    in-out property <length> providers-scroll-y: 0px;
    in-out property <length> providers-scroll-content-height: 0px;
    in-out property <length> providers-scroll-shown-height: 0px;
    in-out property <length> history-scroll-y: 0px;
    in-out property <length> history-scroll-content-height: 0px;
    in-out property <length> history-scroll-shown-height: 0px;
    in-out property <length> glossary-scroll-y: 0px;
    in-out property <length> glossary-scroll-content-height: 0px;
    in-out property <length> glossary-scroll-shown-height: 0px;
    in-out property <length> hotkeys-scroll-y: 0px;
    in-out property <length> hotkeys-scroll-content-height: 0px;
    in-out property <length> hotkeys-scroll-shown-height: 0px;
    in property <string> hotkeys-summary: "";
    in property <bool> hotkeys-summary-signal: false;
    in-out property <int> hotkey-capture-index: -1;
    in-out property <string> hotkey-capture-label: "";
    in-out property <string> hotkey-capture-value: "";
    in-out property <bool> hotkey-capture-valid: false;

    // ── Resources ──
    in property <[ResourceRow]> resource-rows;
    in property <bool> resources-can-unload: false;

    // ── Visuals ──
    in-out property <int> selected-visualizer: 3;
    in property <string> visuals-subtitle: "";
    in property <string> visuals-caption: "";
    in property <string> visuals-note: "";
    in-out property <int> selected-circular-palette: 0;
    in-out property <int> selected-broadcast-mic-palette: 0;
    in-out property <int> selected-flow-sphere-palette: 0;
    in-out property <int> selected-pulse-matrix-palette: 0;
    in-out property <int> selected-writing-slate-surface: 0;
    in property <[float]> visual-preview-bars;
    in property <[float]> visual-preview-spectrum;
    in property <[SlateLine]> visual-preview-slate-lines;
    in property <image> visual-preview-flow-sphere-frame;
    in property <image> visual-preview-pulse-matrix-frame;
    in property <image> visual-preview-companion-frame;
    in property <bool> visual-preview-processing: false;
    in property <float> visual-preview-signal-opacity: 0.8;
    in property <float> visual-preview-disc-opacity: 1;
    in property <float> visual-preview-orb-size: 14;
    in property <float> visual-preview-orb-glow: 0.35;
    in property <float> visual-preview-ribbon-y1: 9.5;
    in property <float> visual-preview-ribbon-y2: 9.5;
    in property <float> visual-preview-ribbon-y3: 9.5;
    in property <float> visual-preview-ribbon-y4: 9.5;
    in property <float> visual-preview-mic-edge-height: 5;
    in property <float> visual-preview-mic-outer-height: 7;
    in property <float> visual-preview-mic-middle-height: 9;
    in property <float> visual-preview-mic-inner-height: 6;
    in property <float> visual-preview-mic-near-height: 7;

    // ── what the window can be asked to do ──
    callback choose-model(string);
    callback cancel-model-install(string);
    callback remove-model(string);
    callback refresh-history();
    callback copy-history(int);
    callback clear-history();
    callback set-history-enabled(bool);
    callback set-output-mode(string);
    callback set-dictation-language(string);
    callback set-release-mode(string);
    callback set-insertion-mode(string);
    callback select-speech-backend(int);
    callback download-cuda-runtime();
    callback cancel-cuda-runtime();
    callback activate-cuda-runtime();
    callback open-cuda-license();
    callback select-visualizer(int);
    /// The visualizer page needs the sleeping frame timer.
    callback animation-wanted();
    callback select-circular-palette(int);
    callback select-broadcast-mic-palette(int);
    callback select-flow-sphere-palette(int);
    callback select-pulse-matrix-palette(int);
    callback select-writing-slate-surface(int);
    callback set-translation-enabled(bool);
    callback set-translation-delivery(string);
    callback set-text-action-mode(string);
    callback set-translation-warm(bool);
    callback set-translation-blur(int);
    callback set-translation-primary-language(string);
    callback set-translation-secondary-language(string);
    callback set-screenshot-retention-enabled(bool);
    callback open-latest-screen-translation();
    callback delete-screenshots-now();
    callback search-glossary(string);
    callback save-glossary-entry(string, string, string);
    callback delete-glossary-entry(string);
    callback retry-glossary-action();
    callback open-translator();
    callback open-support();
    callback set-hotkey-enabled(int, bool);
    callback change-hotkey(int);
    callback reset-hotkey(int);
    callback cancel-hotkey-capture();
    callback save-hotkey-capture();
    callback set-ui-locale(string);
    callback unload-resource(string);
    callback unload-all-resources();
    callback move-provider(int, int);
    callback toggle-provider(int);
    callback use-provider-only(int);
    callback save-provider(string, string, string);
    callback edit-provider(string);
    callback update-provider-draft(string, string, string);
    callback discard-provider-draft(string);
    callback forget-provider-key(string);
    /// What the last save was refused for, and which row asked. Written by the
    /// one owner in Rust so the form cannot decide it locally and be wrong.
    in-out property <string> provider-problem;
    in-out property <string> provider-problem-for;
    in-out property <string> provider-draft-secret;
    in-out property <string> provider-draft-extra;

    VerticalLayout {
        spacing: 0px;

        // ── topline ──
        HorizontalLayout {
            height: 74px;
            padding-left: 40px;
            padding-right: 40px;
            padding-top: 26px;

            HorizontalLayout {
                spacing: 20px;
                alignment: start;
                Text {
                    text: root.today;
                    color: Sheet.ink;
                    font-size: 16px;
                    font-weight: 650;
                    letter-spacing: -0.5px;
                    vertical-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            RowAction {
                label: @tr("Quick translation");
                clicked => { root.open-translator(); }
            }
        }

        // ── workspace ──
        //
        // The pages are drawn at a fixed size and do not reflow, so a window
        // smaller than that size has to do something with the difference. It
        // used to cut it off: the declared floor of 940x640 was below what the
        // layout actually needed, so at the floor the footer sat on top of the
        // last rows and the bottom of the page was simply gone, while the
        // window refused to shrink more than sixty pixels before stopping.
        //
        // Now the workspace is always laid out at its own size and scrolls when
        // the window is smaller. Nothing is ever cut off, and the window is free
        // to be as small as the person using it wants.
        Rectangle {
            vertical-stretch: 1;

        work := Flickable {
            visible: !self.page-owns-scroll;
            width: 100%;
            height: 100%;
            viewport-width: max(self.width, Sheet.workspace-min-width);
            viewport-y <=> root.workspace-scroll-y;
            // Exactly one object owns vertical wheel input. Models, Providers,
            // History and Hotkeys contain a virtualized ListView and scroll
            // themselves; making this outer Flickable scrollable as well made
            // it capture the first wheel events, move a short distance, then
            // hand control to the list only after Slint's capture timeout.
            // That was the visible stop-start motion the thumb drag did not
            // have. Form pages have no inner vertical scroller, so the outer
            // workspace remains their owner.
            property <bool> page-owns-scroll: root.active-page == 3
                || root.active-page == 4
                || root.active-page == 6
                || root.active-page == 7
                || root.active-page == 8;
            // The fixed floor only describes the smallest page. Form pages can
            // grow when settings are added (Translation now does), so the
            // scroll extent must come from the active page's actual layout.
            // Otherwise the page draws past a 474px viewport, the last rows are
            // clipped, and the rail quite truthfully believes there is nowhere
            // to scroll.
            // The navigation is taller than most pages; in a short window its
            // last items (Resources, About) were below the scroll extent and
            // could not be reached at all.
            viewport-height: self.page-owns-scroll
                ? self.height
                : max(
                    self.height,
                    max(
                        Sheet.workspace-min-height,
                        max(page.preferred-height, form-navigation.preferred-height) + 30px
                    )
                );

        HorizontalLayout {
            width: parent.viewport-width;
            height: parent.viewport-height;
            padding-left: Sheet.workspace-pad;
            padding-right: Sheet.workspace-pad;
            padding-top: 30px;
            spacing: Sheet.workspace-gap;

            form-navigation := SettingsNavigation {
                active-page: root.active-page;
                select-page(index) => {
                    root.active-page = index;
                    work.viewport-x = 0px;
                    work.viewport-y = 0px;
                }
            }

            // The page fills the column. List pages own their row scrolling;
            // form and instrument pages report their natural preferred height
            // to the outer Flickable, so adding a row cannot silently clip it.
            //
            // That size is stated here rather than left to whichever page is
            // open, because a column that reports a different minimum for each
            // page makes the workspace change size as you walk through it —
            // 720 tall on Dictation, 640 on Providers, jumping under the
            // pointer.
            page := VerticalLayout {
                horizontal-stretch: 1;
                min-width: Sheet.page-min-width;
                min-height: Sheet.page-min-height;
                spacing: 0px;

                if root.active-page == 0 : OverviewPage {
                    statement: root.overview-statement;
                    sub: root.overview-sub;
                    claim: root.provider-claim;
                    audio-leaves-device: root.audio-leaves-device || root.text-leaves-device;
                    facts: root.overview-facts;
                    note-text: root.overview-note;
                    note-action: root.overview-note-action;
                    note-signal: root.overview-note-signal;
                    note-acted => { root.active-page = 3; }
                }

                if root.active-page == 1 : DictationPage {
                    subtitle: root.dictation-subtitle;
                    readout: root.dictation-readout;
                    caption: root.dictation-caption;
                    engine-note: root.speech-backend-detail;
                    backend: root.speech-backend-index;
                    backend-verified: root.speech-backend-verified;
                    cuda-status: root.cuda-setup-status;
                    cuda-description: root.cuda-setup-description;
                    cuda-error: root.cuda-setup-error;
                    cuda-download-label: root.cuda-download-label;
                    cuda-progress: root.cuda-setup-progress;
                    cuda-busy: root.cuda-setup-busy;
                    cuda-can-download: root.cuda-can-download;
                    cuda-can-cancel: root.cuda-can-cancel;
                    cuda-can-activate: root.cuda-can-activate;
                    download-cuda => { root.download-cuda-runtime(); }
                    cancel-cuda => { root.cancel-cuda-runtime(); }
                    activate-cuda => { root.activate-cuda-runtime(); }
                    open-cuda-license => { root.open-cuda-license(); }
                    output-mode: root.output-mode-label;
                    output-mode-value: root.output-mode;
                    output-locked: root.output-mode-locked;
                    dictation-language: root.dictation-language-label;
                    dictation-language-value: root.dictation-language;
                    release-mode: root.release-mode-label;
                    release-mode-value: root.release-mode;
                    release-mode-locked: root.release-mode-locked;
                    release-mode-note: root.release-mode-note;
                    insertion-mode-value: root.insertion-mode;
                    keeping-history: root.history-enabled;
                    hotkey: root.dictate-hotkey;
                    select-backend(index) => { root.select-speech-backend(index); }
                    set-output-mode(value) => { root.set-output-mode(value); }
                    set-dictation-language(value) => { root.set-dictation-language(value); }
                    set-release-mode(value) => { root.set-release-mode(value); }
                    set-insertion-mode(value) => { root.set-insertion-mode(value); }
                    set-keeping-history(next) => { root.set-history-enabled(next); }
                }

                if root.active-page == 2 : TranslationPage {
                    enabled: root.translation-enabled;
                    ready: root.translation-ready;
                    model-name: root.translation-model-name;
                    model-detail: root.translation-model-detail;
                    delivery: root.translation-delivery-label;
                    delivery-value: root.translation-delivery;
                    text-action: root.text-action-mode-label;
                    text-action-value: root.text-action-mode;
                    warm: root.translation-warm;
                    blur-radius: root.translation-blur-radius;
                    primary-language: root.translation-primary-language;
                    primary-language-value: root.translation-primary-language-value;
                    secondary-language: root.translation-secondary-language;
                    secondary-language-value: root.translation-secondary-language-value;
                    note-text: root.translation-note;
                    note-action: root.translation-note-action;
                    note-signal: root.translation-note-signal;
                    screenshot-retention-enabled: root.screenshot-retention-enabled;
                    screenshot-retention-summary: root.screenshot-retention-summary;
                    set-enabled(next) => { root.set-translation-enabled(next); }
                    set-delivery(value) => { root.set-translation-delivery(value); }
                    set-text-action(value) => { root.set-text-action-mode(value); }
                    set-warm(next) => { root.set-translation-warm(next); }
                    set-blur(value) => { root.set-translation-blur(value); }
                    set-primary-language(value) => { root.set-translation-primary-language(value); }
                    set-secondary-language(value) => { root.set-translation-secondary-language(value); }
                    set-screenshot-retention-enabled(next) => { root.set-screenshot-retention-enabled(next); }
                    open-latest-screen-translation => { root.open-latest-screen-translation(); }
                    delete-screenshots-now => { root.delete-screenshots-now(); }
                    open-translator => { root.open-translator(); }
                    note-acted => { root.active-page = 3; }
                }

                if root.active-page == 3 && !work.page-owns-scroll : ModelsPage {
                    // The rail belongs at the window edge, not beside the text.
                    rail-overhang: Sheet.rail-overhang;
                    rows: root.model-rows;
                    summary: root.models-summary;
                    choose(catalog-id) => { root.choose-model(catalog-id); }
                    cancel-install(catalog-id) => { root.cancel-model-install(catalog-id); }
                    remove(catalog-id) => { root.remove-model(catalog-id); }
                }

                if root.active-page == 4 && !work.page-owns-scroll : ProvidersPage {
                    // The rail belongs at the window edge, not beside the text.
                    rail-overhang: Sheet.rail-overhang;
                    editing <=> root.provider-editing;
                    rows: root.provider-rows;
                    audio-leaves-device: root.audio-leaves-device || root.text-leaves-device;
                    claim: root.provider-claim;
                    toggle-provider(index) => { root.toggle-provider(index); }
                    use-provider-only(index) => { root.use-provider-only(index); }
                    move-provider(from, to) => { root.move-provider(from, to); }
                    problem <=> root.provider-problem;
                    problem-for <=> root.provider-problem-for;
                    draft-secret <=> root.provider-draft-secret;
                    draft-extra <=> root.provider-draft-extra;
                    save-provider(id, secret, extra) => {
                        root.save-provider(id, secret, extra);
                    }
                    edit-provider(id) => { root.edit-provider(id); }
                    update-provider-draft(id, secret, extra) => {
                        root.update-provider-draft(id, secret, extra);
                    }
                    discard-provider-draft(id) => { root.discard-provider-draft(id); }
                    forget-provider-key(id) => { root.forget-provider-key(id); }
                }

                if root.active-page == 5 : VisualsPage {
                    // The live preview needs the frame timer, which sleeps
                    // while nothing moves.
                    init => { root.animation-wanted(); }
                    selected: root.selected-visualizer;
                    subtitle: root.visuals-subtitle;
                    caption: root.visuals-caption;
                    side-note: root.visuals-note;
                    circular-palette: root.selected-circular-palette;
                    broadcast-mic-palette: root.selected-broadcast-mic-palette;
                    sphere-palette: root.selected-flow-sphere-palette;
                    pulse-matrix-palette: root.selected-pulse-matrix-palette;
                    slate-surface: root.selected-writing-slate-surface;
                    preview-bars: root.visual-preview-bars;
                    preview-spectrum: root.visual-preview-spectrum;
                    preview-slate-lines: root.visual-preview-slate-lines;
                    preview-flow-sphere-frame: root.visual-preview-flow-sphere-frame;
                    preview-pulse-matrix-frame: root.visual-preview-pulse-matrix-frame;
                    preview-companion-frame: root.visual-preview-companion-frame;
                    preview-processing: root.visual-preview-processing;
                    preview-signal-opacity: root.visual-preview-signal-opacity;
                    preview-disc-opacity: root.visual-preview-disc-opacity;
                    preview-orb-size: root.visual-preview-orb-size;
                    preview-orb-glow: root.visual-preview-orb-glow;
                    preview-ribbon-y1: root.visual-preview-ribbon-y1;
                    preview-ribbon-y2: root.visual-preview-ribbon-y2;
                    preview-ribbon-y3: root.visual-preview-ribbon-y3;
                    preview-ribbon-y4: root.visual-preview-ribbon-y4;
                    preview-mic-edge-height: root.visual-preview-mic-edge-height;
                    preview-mic-outer-height: root.visual-preview-mic-outer-height;
                    preview-mic-middle-height: root.visual-preview-mic-middle-height;
                    preview-mic-inner-height: root.visual-preview-mic-inner-height;
                    preview-mic-near-height: root.visual-preview-mic-near-height;
                    select-visualizer(index) => {
                        root.select-visualizer(index);
                        root.animation-wanted();
                    }
                    select-circular-palette(index) => { root.select-circular-palette(index); }
                    select-broadcast-mic-palette(index) => { root.select-broadcast-mic-palette(index); }
                    select-sphere-palette(index) => { root.select-flow-sphere-palette(index); }
                    select-pulse-matrix-palette(index) => { root.select-pulse-matrix-palette(index); }
                    select-slate-surface(index) => { root.select-writing-slate-surface(index); }
                }

                if root.active-page == 6 && !work.page-owns-scroll : HistoryPage {
                    hotkey: root.dictate-hotkey;
                    // The rail belongs at the window edge, not beside the text.
                    rail-overhang: Sheet.rail-overhang;
                    rows: root.history-rows;
                    keeping: root.history-enabled;
                    scope: root.history-scope;
                    set-keeping(next) => { root.set-history-enabled(next); }
                    clear-history => { root.clear-history(); }
                    refresh-history => { root.refresh-history(); }
                    copy-history(index) => { root.copy-history(index); }
                }

                if root.active-page == 7 && !work.page-owns-scroll : GlossaryPage {
                    rail-overhang: Sheet.rail-overhang;
                    rows: root.glossary-rows;
                    query <=> root.glossary-query;
                    editing-id <=> root.glossary-editing-id;
                    draft-source <=> root.glossary-draft-source;
                    draft-translation <=> root.glossary-draft-translation;
                    problem: root.glossary-problem;
                    can-retry: root.glossary-can-retry;
                    search(query) => { root.search-glossary(query); }
                    save-entry(id, source, translation) => { root.save-glossary-entry(id, source, translation); }
                    delete-entry(id) => { root.delete-glossary-entry(id); }
                    retry => { root.retry-glossary-action(); }
                }

                if root.active-page == 8 && !work.page-owns-scroll : HotkeysPage {
                    // The rail belongs at the window edge, not beside the text.
                    rail-overhang: Sheet.rail-overhang;
                    rows: root.hotkey-rows;
                    summary: root.hotkeys-summary;
                    summary-signal: root.hotkeys-summary-signal;
                    capture-index: root.hotkey-capture-index;
                    capture-label: root.hotkey-capture-label;
                    capture-value: root.hotkey-capture-value;
                    capture-valid: root.hotkey-capture-valid;
                    toggle-row(index, next) => { root.set-hotkey-enabled(index, next); }
                    change-row(index) => { root.change-hotkey(index); }
                    reset-row(index) => { root.reset-hotkey(index); }
                    cancel-capture => { root.cancel-hotkey-capture(); }
                    save-capture => { root.save-hotkey-capture(); }
                    set-mode(menu, value) => { root.set-text-action-mode(value); }
                }

                if root.active-page == 9 : ResourcesPage {
                    rows: root.resource-rows;
                    can-unload-all: root.resources-can-unload;
                    unload(id) => { root.unload-resource(id); }
                    unload-all => { root.unload-all-resources(); }
                }

                if root.active-page == 10 : AboutPage {
                    version: root.app-version;
                    ui-locale <=> root.ui-locale;
                    ui-locale-label: root.ui-locale-label;
                    set-ui-locale(value) => { root.set-ui-locale(value); }
                }
            }
        }
        }

            // List pages are not children of the form-page Flickable. Slint's
            // Flickable consumes wheel input even when its vertical extent is
            // already zero; nesting a ListView under it therefore made the
            // first wheel events disappear. This clipped viewport owns only
            // horizontal panning through its explicit rail. The ListView in
            // each page is the sole vertical wheel owner.
            if work.page-owns-scroll : Rectangle {
                clip: true;
                property <length> content-width: max(self.width, Sheet.workspace-min-width);
                property <length> horizontal-offset: 0px;

                HorizontalLayout {
                    x: -parent.horizontal-offset;
                    width: parent.content-width;
                    height: parent.height;
                    padding-left: Sheet.workspace-pad;
                    padding-right: Sheet.workspace-pad;
                    padding-top: 30px;
                    spacing: Sheet.workspace-gap;

                    // List pages scroll only their rows, so the navigation
                    // beside them scrolls on its own: in a short window its
                    // last items were cut off and the wheel over it did
                    // nothing.
                    list-navigation := Flickable {
                        width: Sheet.nav-width;
                        viewport-width: self.width;
                        viewport-height: max(self.height, list-navigation-items.preferred-height);

                        list-navigation-items := SettingsNavigation {
                            width: list-navigation.width;
                            height: list-navigation.viewport-height;
                            active-page: root.active-page;
                            select-page(index) => {
                                root.active-page = index;
                                work.viewport-x = 0px;
                                work.viewport-y = 0px;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: Sheet.page-min-width;
                        min-height: Sheet.page-min-height;
                        spacing: 0px;

                        if root.active-page == 3 : models-list-page := ModelsPage {
                            rail-overhang: Sheet.rail-overhang;
                            scroll-y <=> root.models-scroll-y;
                            scroll-content-height <=> root.models-scroll-content-height;
                            changed scroll-shown-height => {
                                if (root.models-scroll-shown-height != self.scroll-shown-height) {
                                    root.models-scroll-shown-height = self.scroll-shown-height;
                                }
                            }
                            rows: root.model-rows;
                            summary: root.models-summary;
                            choose(catalog-id) => { root.choose-model(catalog-id); }
                            cancel-install(catalog-id) => { root.cancel-model-install(catalog-id); }
                            remove(catalog-id) => { root.remove-model(catalog-id); }
                        }

                        if root.active-page == 4 : providers-list-page := ProvidersPage {
                            rail-overhang: Sheet.rail-overhang;
                            scroll-y <=> root.providers-scroll-y;
                            scroll-content-height <=> root.providers-scroll-content-height;
                            changed scroll-shown-height => {
                                if (root.providers-scroll-shown-height != self.scroll-shown-height) {
                                    root.providers-scroll-shown-height = self.scroll-shown-height;
                                }
                            }
                            editing <=> root.provider-editing;
                            rows: root.provider-rows;
                            audio-leaves-device: root.audio-leaves-device || root.text-leaves-device;
                            claim: root.provider-claim;
                            toggle-provider(index) => { root.toggle-provider(index); }
                            use-provider-only(index) => { root.use-provider-only(index); }
                            move-provider(from, to) => { root.move-provider(from, to); }
                            problem <=> root.provider-problem;
                            problem-for <=> root.provider-problem-for;
                            draft-secret <=> root.provider-draft-secret;
                            draft-extra <=> root.provider-draft-extra;
                            save-provider(id, secret, extra) => {
                                root.save-provider(id, secret, extra);
                            }
                            edit-provider(id) => { root.edit-provider(id); }
                            update-provider-draft(id, secret, extra) => {
                                root.update-provider-draft(id, secret, extra);
                            }
                            discard-provider-draft(id) => { root.discard-provider-draft(id); }
                            forget-provider-key(id) => { root.forget-provider-key(id); }
                        }

                        if root.active-page == 6 : history-list-page := HistoryPage {
                            hotkey: root.dictate-hotkey;
                            rail-overhang: Sheet.rail-overhang;
                            scroll-y <=> root.history-scroll-y;
                            scroll-content-height <=> root.history-scroll-content-height;
                            changed scroll-shown-height => {
                                if (root.history-scroll-shown-height != self.scroll-shown-height) {
                                    root.history-scroll-shown-height = self.scroll-shown-height;
                                }
                            }
                            rows: root.history-rows;
                            keeping: root.history-enabled;
                            scope: root.history-scope;
                            set-keeping(next) => { root.set-history-enabled(next); }
                            clear-history => { root.clear-history(); }
                            refresh-history => { root.refresh-history(); }
                            copy-history(index) => { root.copy-history(index); }
                        }

                        if root.active-page == 7 : glossary-list-page := GlossaryPage {
                            rail-overhang: Sheet.rail-overhang;
                            scroll-y <=> root.glossary-scroll-y;
                            scroll-content-height <=> root.glossary-scroll-content-height;
                            changed scroll-shown-height => {
                                if (root.glossary-scroll-shown-height != self.scroll-shown-height) {
                                    root.glossary-scroll-shown-height = self.scroll-shown-height;
                                }
                            }
                            rows: root.glossary-rows;
                            query <=> root.glossary-query;
                            editing-id <=> root.glossary-editing-id;
                            draft-source <=> root.glossary-draft-source;
                            draft-translation <=> root.glossary-draft-translation;
                            problem: root.glossary-problem;
                            can-retry: root.glossary-can-retry;
                            search(query) => { root.search-glossary(query); }
                            save-entry(id, source, translation) => { root.save-glossary-entry(id, source, translation); }
                            delete-entry(id) => { root.delete-glossary-entry(id); }
                            retry => { root.retry-glossary-action(); }
                        }

                        if root.active-page == 8 : hotkeys-list-page := HotkeysPage {
                            rail-overhang: Sheet.rail-overhang;
                            scroll-y <=> root.hotkeys-scroll-y;
                            scroll-content-height <=> root.hotkeys-scroll-content-height;
                            changed scroll-shown-height => {
                                if (root.hotkeys-scroll-shown-height != self.scroll-shown-height) {
                                    root.hotkeys-scroll-shown-height = self.scroll-shown-height;
                                }
                            }
                            rows: root.hotkey-rows;
                            summary: root.hotkeys-summary;
                            summary-signal: root.hotkeys-summary-signal;
                            capture-index: root.hotkey-capture-index;
                            capture-label: root.hotkey-capture-label;
                            capture-value: root.hotkey-capture-value;
                            capture-valid: root.hotkey-capture-valid;
                            toggle-row(index, next) => { root.set-hotkey-enabled(index, next); }
                            change-row(index) => { root.change-hotkey(index); }
                            reset-row(index) => { root.reset-hotkey(index); }
                            cancel-capture => { root.cancel-hotkey-capture(); }
                            save-capture => { root.save-hotkey-capture(); }
                            set-mode(menu, value) => { root.set-text-action-mode(value); }
                        }
                    }
                }

                ScrollRail {
                    horizontal: true;
                    x: 0;
                    y: parent.height - 9px;
                    track: parent.width;
                    content: parent.content-width;
                    shown: parent.width;
                    offset: parent.horizontal-offset;
                    scrolled(next) => { parent.horizontal-offset = next; }
                }
            }

            // Rails, so that a window smaller than the workspace says so.
            // They appear only when there is somewhere to go, are drawn in the
            // same graphite as everything else, and can be dragged.
            ScrollRail {
                // A use-site binding replaces ScrollRail's own `visible`
                // binding.  Testing only the page owner therefore left a
                // full-width thumb on every form page even when the content
                // fitted exactly — the long grey strip above the footer.
                visible: !work.page-owns-scroll
                    && work.viewport-height > work.height + 0.5px;
                x: parent.width - 9px;
                y: 0;
                track: work.height;
                content: work.viewport-height;
                shown: work.height;
                offset: -work.viewport-y;
                scrolled(next) => { work.viewport-y = -next; }
            }

            ScrollRail {
                visible: !work.page-owns-scroll
                    && work.viewport-width > work.width + 0.5px;
                horizontal: true;
                x: 0;
                y: parent.height - 9px;
                track: work.width;
                content: work.viewport-width;
                shown: work.width;
                offset: -work.viewport-x;
                scrolled(next) => { work.viewport-x = -next; }
            }
        }

        // ── footer ──
        Rectangle {
            height: 92px;

            // A child of a Rectangle with a height but no y is centred, so this
            // rule ran through the middle of the footer and struck out the
            // brand mark. It belongs on the top edge.
            Rectangle {
                y: 0;
                height: 1px;
                background: Sheet.hairline-faint;
            }

            HorizontalLayout {
                padding-left: 40px;
                padding-right: 40px;
                padding-top: 20px;
                padding-bottom: 26px;
                spacing: 26px;

                Rectangle {
                    width: 60px;
                    height: 66px;
                    border-width: 1px;
                    border-color: Sheet.ink;
                    VerticalLayout {
                        padding: 8px;
                        alignment: end;
                        spacing: 0px;
                        Text {
                            text: "Say";
                            color: Sheet.ink;
                            font-size: 13px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Flex";
                            color: Sheet.ink;
                            font-size: 13px;
                            font-weight: 700;
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    spacing: 5px;
                    // The words come from the same reading of the two lists
                    // that the claim in the corner does, so the bottom of the
                    // window and the top of it cannot disagree.
                    property <bool> anything-leaves:
                        root.audio-leaves-device || root.text-leaves-device;
                    Text {
                        text: parent.anything-leaves ? root.departure-badge : @tr("LOCAL · PRIVATE");
                        color: parent.anything-leaves ? Sheet.signal-text : Sheet.muted;
                        font-size: Sheet.label-size;
                        font-weight: parent.anything-leaves ? 700 : 400;
                        letter-spacing: 1.6px;
                    }
                    Text {
                        text: root.runtime-status;
                        color: Sheet.ink;
                        font-size: 11px;
                        font-weight: 650;
                        letter-spacing: 1.4px;
                        overflow: elide;
                    }
                }

                // What the application is doing or has just failed to do. This
                // is where the accent earns its keep: a refused insertion, a
                // backend that would not start, a model that would not
                // download. Without it the interface knows and does not say.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    padding-left: 18px;
                    alignment: start;
                    VerticalLayout {
                        alignment: end;
                        HorizontalLayout {
                            spacing: 9px;
                            Rectangle {
                                width: 8px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: parent.height - self.height - 4px;
                                    background: root.status-is-a-problem
                                        ? Sheet.signal
                                        : Sheet.hairline;
                                    border-width: root.status-is-a-problem ? 0px : 1px;
                                    border-color: Sheet.hairline;
                                }
                            }
                            Text {
                                text: root.indicator-status;
                                color: root.status-is-a-problem
                                    ? Sheet.signal-text
                                    : Sheet.muted;
                                font-size: Sheet.detail-size;
                                font-weight: root.status-is-a-problem ? 650 : 400;
                                overflow: elide;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    VerticalLayout {
                        height: 48px;
                        // The steam raises the image's geometric centre above
                        // the visual centre of the cup. Centre the action on
                        // the cup itself, which is the perceived anchor.
                        padding-top: 10px;
                        alignment: center;
                        RowAction {
                            label: @tr("Support the developer");
                            clicked => { root.open-support(); }
                        }
                    }
                    Image {
                        width: 48px;
                        height: 48px;
                        source: @image-url("../assets/action-coffee.svg");
                        image-fit: contain;
                    }
                }
            }
        }
    }
}
