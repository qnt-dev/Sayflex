// The recording visual is shared by the native recording overlay and the
// Visuals settings page. It deliberately inherits Rectangle rather than Window:
// native-window policy belongs to the overlay wrapper, while these pixels and
// animation inputs have exactly one owner.

export struct SlateLine {
    x: float,
    width: float,
    y: float,
    opacity: float,
    glow: float,
    color-index: int,
}

export component RecordingVisual inherits Rectangle {
    width: root.visualizer-style == 6
        ? 128px
        : root.visualizer-style == 5
            ? 116px
            : root.visualizer-style == 4
                ? 92px
                : 118px;
    height: root.visualizer-style == 6
        ? 154px
        : root.visualizer-style == 5
            ? 116px
            : root.visualizer-style == 4
                ? 92px
                : 42px;
    in property <[float]> bar-heights;
    in property <[float]> spectrum-heights;
    in property <int> visualizer-style: 0;
    in property <int> circular-palette: 0;
    in property <int> broadcast-mic-palette: 0;
    in property <image> flow-sphere-frame;
    in property <[SlateLine]> slate-lines;
    in property <int> writing-slate-surface: 0;
    property <bool> writing-slate-blue-glass: root.writing-slate-surface == 2;
    in property <image> writing-slate-glass-backdrop;
    in property <bool> processing: false;
    in property <float> signal-opacity: 0.54;
    in property <float> disc-opacity: 1;
    in property <float> orb-size: 12;
    in property <float> orb-glow: 0.24;
    in property <float> ribbon-y1: 9.5;
    in property <float> ribbon-y2: 9.5;
    in property <float> ribbon-y3: 9.5;
    in property <float> ribbon-y4: 9.5;
    in property <float> mic-edge-height: 5;
    in property <float> mic-outer-height: 7;
    in property <float> mic-middle-height: 9;
    in property <float> mic-inner-height: 6;
    in property <float> mic-near-height: 7;
    in property <float> visual-scale: 1;
    in property <float> visual-opacity: 1;
    in-out property <bool> prepared: false;
    // Broadcast mic is a mark made of a microphone and level traces. A dark
    // capsule behind it turns that mark into a boxed widget, which is not the
    // visual selected by the user. Like the native circular/sphere/slate
    // styles, it is drawn directly over the target application.
    property <bool> frameless: root.visualizer-style >= 3;
    property <brush> mic-trace: root.broadcast-mic-palette == 1
        ? #4f8cff
        : root.broadcast-mic-palette == 2
            ? #ef5048
            : #f5f5f2;

    Rectangle {
        border-radius: root.frameless ? 18px : 10px;
        background: root.frameless ? transparent : #23262b;
        opacity: root.prepared ? root.visual-opacity : 0;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.visual-scale;

        Rectangle {
            x: root.frameless ? 0px : 3px;
            y: root.frameless ? 0px : 3px;
            width: parent.width - (root.frameless ? 0px : 6px);
            height: parent.height - (root.frameless ? 0px : 6px);
            border-radius: root.frameless ? 16px : 7px;
            background: root.frameless ? transparent : #111317;

            if root.visualizer-style == 5 : Image {
                source: root.flow-sphere-frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }

            if root.visualizer-style == 6 : Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Rectangle {
                    x: root.writing-slate-surface != 0 ? 0px : 2px;
                    y: root.writing-slate-surface != 0 ? 0px : 4px;
                    width: root.writing-slate-surface != 0 ? parent.width : parent.width - 4px;
                    height: root.writing-slate-surface != 0 ? parent.height : parent.height - 5px;
                    border-radius: 7px;
                    background: #000000;
                    opacity: root.writing-slate-surface != 0 ? 0 : 0.28;
                }

                Rectangle {
                    x: root.writing-slate-surface != 0 ? 0px : 3px;
                    y: root.writing-slate-surface != 0 ? 0px : 3px;
                    width: root.writing-slate-surface != 0 ? parent.width : parent.width - 6px;
                    height: root.writing-slate-surface != 0 ? parent.height : parent.height - 6px;
                    border-radius: 6px;
                    border-width: 0px;
                    background: root.writing-slate-blue-glass
                        ? @linear-gradient(145deg,
                            rgba(84, 188, 235, 0.055) 0%,
                            rgba(8, 30, 51, 0.012) 46%,
                            rgba(77, 191, 238, 0.042) 100%)
                        : root.writing-slate-surface == 1 ? #73777e4d : #181b21f5;

                    Rectangle {
                        x: root.writing-slate-blue-glass ? 0px : root.writing-slate-surface == 1 ? 0px : 3px;
                        y: root.writing-slate-blue-glass ? 0px : root.writing-slate-surface == 1 ? 0px : 3px;
                        width: root.writing-slate-blue-glass
                            ? parent.width
                            : root.writing-slate-surface == 1 ? parent.width : parent.width - 6px;
                        height: root.writing-slate-blue-glass
                            ? parent.height
                            : root.writing-slate-surface == 1 ? parent.height : parent.height - 6px;
                        border-radius: root.writing-slate-blue-glass
                            ? 6px
                            : root.writing-slate-surface == 1 ? 6px : 4px;
                        background: root.writing-slate-blue-glass
                            ? transparent
                            : root.writing-slate-surface == 1 ? transparent : #0b0e13f5;
                        border-width: 0px;
                        clip: true;

                        if root.writing-slate-blue-glass : Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.writing-slate-glass-backdrop;
                            image-fit: fill;
                        }

                        if root.writing-slate-blue-glass : Image {
                            width: parent.width;
                            height: parent.height;
                            source: @image-url("../assets/slate-blue-glass-wash.svg");
                            image-fit: fill;
                            opacity: 0.25;
                        }

                        if root.writing-slate-surface != 0 : Image {
                            width: parent.width;
                            height: parent.height;
                            source: @image-url("../assets/slate-matte-grain.svg");
                            image-fit: fill;
                            opacity: root.writing-slate-blue-glass ? 0.10 : 1;
                        }

                        for line in root.slate-lines : Rectangle {
                            x: 11px + line.x * 1px;
                            y: 11px + line.y * 1px;
                            width: line.width * 1px + 2px;
                            height: 5.5px;
                            border-radius: 2px;
                            background: line.color-index == 0
                                ? #ef5048
                                : line.color-index == 1
                                    ? #b8501c
                                    : #ece9e1;
                            opacity: line.glow * 0.2;
                        }

                        for line in root.slate-lines : Rectangle {
                            x: 12px + line.x * 1px;
                            y: 12px + line.y * 1px;
                            width: line.width * 1px;
                            height: 3.5px;
                            border-radius: 1px;
                            background: line.color-index == 0
                                ? #ef5048
                                : line.color-index == 1
                                    ? #b8501c
                                    : #ece9e1;
                            opacity: line.opacity;
                        }
                    }
                }
            }

            HorizontalLayout {
                visible: root.visualizer-style != 5 && root.visualizer-style != 6;
                y: (parent.height - self.height) / 2;
                height: root.visualizer-style == 4 ? 88px : 19px;
                padding-left: root.visualizer-style >= 4 ? 0px : 9px;
                padding-right: root.visualizer-style >= 4 ? 0px : 7px;
                alignment: center;
                spacing: 3px;

                if root.visualizer-style == 0 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    Rectangle {
                        width: root.orb-size * 1px + 9px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: #f5f5f2;
                        opacity: root.orb-glow * 0.34;
                    }

                    Rectangle {
                        width: root.orb-size * 1px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: #f5f5f2;
                        opacity: root.signal-opacity;

                        Rectangle {
                            width: parent.width * 0.28;
                            height: self.width;
                            x: parent.width * 0.24;
                            y: parent.height * 0.18;
                            border-radius: self.width / 2;
                            background: #ffffff;
                            opacity: 0.52;
                        }
                    }
                }

                if root.visualizer-style == 1 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 3px;
                        alignment: center;

                        for bar-height in root.bar-heights : Rectangle {
                            width: 2px;
                            height: 19px;
                            background: transparent;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 2px;
                                height: bar-height * 1px;
                                border-radius: 1px;
                                background: #f5f5f2;
                                opacity: root.signal-opacity;
                            }
                        }
                    }
                }

                if root.visualizer-style == 2 : Rectangle {
                    width: 56px;
                    height: 19px;
                    background: transparent;

                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 56;
                        viewbox-height: 19;
                        fill: transparent;
                        stroke: #f5f5f2;
                        stroke-width: 2.2px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        opacity: root.signal-opacity;
                        MoveTo { x: 0; y: root.ribbon-y1; }
                        CubicTo {
                            control-1-x: 5; control-1-y: root.ribbon-y1;
                            control-2-x: 10; control-2-y: root.ribbon-y2;
                            x: 17; y: root.ribbon-y2;
                        }
                        CubicTo {
                            control-1-x: 23; control-1-y: root.ribbon-y2;
                            control-2-x: 27; control-2-y: root.ribbon-y3;
                            x: 35; y: root.ribbon-y3;
                        }
                        CubicTo {
                            control-1-x: 42; control-1-y: root.ribbon-y3;
                            control-2-x: 49; control-2-y: root.ribbon-y4;
                            x: 56; y: root.ribbon-y4;
                        }
                    }
                }

                if root.visualizer-style == 3 : Rectangle {
                    width: 78px;
                    height: 19px;
                    background: transparent;

                    // Five voice-reactive lines on each side. The heights are
                    // mirrored so the tiny surface stays calm and legible.
                    Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-edge-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.58;
                    }
                    Rectangle {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-outer-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.72;
                    }
                    Rectangle {
                        x: 12px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-middle-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.86;
                    }
                    Rectangle {
                        x: 18px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-inner-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity;
                    }
                    Rectangle {
                        x: 24px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-near-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.94;
                    }

                    Rectangle {
                        x: 52px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-near-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.94;
                    }
                    Rectangle {
                        x: 58px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-inner-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity;
                    }
                    Rectangle {
                        x: 64px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-middle-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.86;
                    }
                    Rectangle {
                        x: 70px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-outer-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.72;
                    }
                    Rectangle {
                        x: 76px;
                        y: (parent.height - self.height) / 2;
                        width: 2px;
                        height: root.mic-edge-height * 1px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: root.signal-opacity * 0.58;
                    }

                    // Capsule and short stem only: the reference's stand and
                    // horizontal base deliberately do not belong in the overlay.
                    //
                    // The capsule is an outline over whatever the overlay is
                    // sitting on. It used to be filled with its own dark grey,
                    // a shade off the panel behind it, which turned the
                    // microphone into a boxed chip with a frame around it
                    // instead of a mark drawn in the same trace as the bars
                    // either side of it.
                    Rectangle {
                        x: 33px;
                        y: 0px;
                        width: 12px;
                        height: 15px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: root.mic-trace;
                        background: transparent;

                        Rectangle {
                            x: 3px;
                            y: 4px;
                            width: 6px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: root.mic-trace;
                            opacity: 0.78;
                        }
                        Rectangle {
                            x: 3px;
                            y: 7px;
                            width: 6px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: root.mic-trace;
                            opacity: 0.78;
                        }
                        Rectangle {
                            x: 3px;
                            y: 10px;
                            width: 6px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: root.mic-trace;
                            opacity: 0.78;
                        }
                    }
                    Rectangle {
                        x: 38px;
                        y: 15px;
                        width: 2px;
                        height: 4px;
                        border-radius: 1px;
                        background: root.mic-trace;
                        opacity: 0.92;
                    }
                }

                if root.visualizer-style == 4 : Rectangle {
                    width: 88px;
                    height: 88px;
                    background: transparent;

                    // A restrained native glow approximates the reference without
                    // embedding video, shaders, or a blur pass.
                    // Soft duplicate bars provide a low-cost halo.
                    for band-height[index] in root.spectrum-heights : Rectangle {
                        width: 4px;
                        height: band-height * 1px + 3px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - 22.5px - self.height;
                        border-radius: self.width / 2;
                        background: root.circular-palette == 1
                            ? index < 4 ? #7df5ff
                                : index < 9 ? #35d9ff
                                : index < 14 ? #1590ff
                                : index < 20 ? #315dff
                                : index < 26 ? #1578ff
                                : #49d7ff
                            : root.circular-palette == 2
                                ? #323940
                                : index < 3 ? #ffad21
                                    : index < 7 ? #ff6220
                                    : index < 12 ? #ff16b7
                                    : index < 18 ? #ff087b
                                    : index < 24 ? #ff1847
                                    : index < 28 ? #ff361b
                                    : #ff7c12;
                        opacity: root.circular-palette == 2
                            ? 0.18 + root.signal-opacity * 0.18
                            : root.signal-opacity * 0.18;
                        transform-origin: {
                            x: self.width / 2,
                            y: parent.height / 2 - self.y,
                        };
                        transform-rotation: index * 11.25deg;
                    }

                    for band-height[index] in root.spectrum-heights : Rectangle {
                        width: 2.2px;
                        height: band-height * 1px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - 22.5px - self.height;
                        border-radius: self.width / 2;
                        background: root.circular-palette == 1
                            ? index < 4 ? #7df5ff
                                : index < 9 ? #35d9ff
                                : index < 14 ? #1590ff
                                : index < 20 ? #315dff
                                : index < 26 ? #1578ff
                                : #49d7ff
                            : root.circular-palette == 2
                                ? Math.mod(index, 7) == 0 ? #f4f6f8
                                    : Math.mod(index, 7) == 1 ? #89939e
                                    : Math.mod(index, 7) == 2 ? #56616d
                                    : Math.mod(index, 7) == 3 ? #aeb6bf
                                    : Math.mod(index, 7) == 4 ? #69747f
                                    : Math.mod(index, 7) == 5 ? #5b6671
                                    : #d8dde2
                                : index < 3 ? #ffad21
                                    : index < 7 ? #ff6220
                                    : index < 12 ? #ff16b7
                                    : index < 18 ? #ff087b
                                    : index < 24 ? #ff1847
                                    : index < 28 ? #ff361b
                                    : #ff7c12;
                        opacity: 0.72 + root.signal-opacity * 0.28;
                        transform-origin: {
                            x: self.width / 2,
                            y: parent.height / 2 - self.y,
                        };
                        transform-rotation: index * 11.25deg;
                    }
                }

                if root.visualizer-style < 3 : Rectangle {
                    width: 4px;
                    height: 19px;
                    background: transparent;
                }

                if root.visualizer-style < 3 : Rectangle {
                    width: 18px;
                    height: 19px;
                    background: transparent;

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 6px;
                        background: #b8501c;
                        opacity: root.disc-opacity;

                        Rectangle {
                            width: root.processing ? 5px : 7px;
                            height: root.processing ? 5px : 7px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: root.processing ? 2.5px : 2px;
                            background: #111214;
                        }
                    }
                }
            }
        }
    }
}
