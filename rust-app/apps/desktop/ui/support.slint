// Developer support is kept inside SayFlex so the user can see the exact
// network and public address before copying anything. The QR codes are
// generated from the same address constants at startup and verified in tests.

import { RowAction } from "controls.slint";
import { Sheet } from "sheet.slint";

component CopyAction inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 34px;
    height: 28px;
    border-width: copy-focus.has-focus ? 2px : 1px;
    border-color: copy-focus.has-focus ? Sheet.ink : Sheet.hairline;
    background: copy-touch.has-hover ? Sheet.ink : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: true;
    accessible-action-default => { root.clicked(); }
    forward-focus: copy-focus;

    Image {
        x: 9px;
        y: 6px;
        width: 16px;
        height: 16px;
        source: @image-url("../assets/action-copy.svg");
        image-fit: contain;
        colorize: copy-touch.has-hover ? Sheet.on-ink : Sheet.ink;
    }

    copy-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            copy-focus.focus();
            root.clicked();
        }
    }

    copy-focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if copy-touch.has-hover : Rectangle {
        x: parent.width - self.width;
        y: parent.height + 5px;
        width: tooltip-text.preferred-width + 14px;
        height: 24px;
        background: Sheet.ink;
        tooltip-text := Text {
            text: root.label;
            color: Sheet.on-ink;
            font-size: Sheet.label-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component WalletCard inherits Rectangle {
    in property <string> network;
    in property <string> standard;
    in property <string> address;
    in property <image> qr;
    in property <string> copy-label;
    callback copy();

    width: 340px;
    border-width: 1px;
    border-color: Sheet.hairline;
    background: Sheet.canvas;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Text {
                text: root.network;
                color: Sheet.ink;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: standard-text.preferred-width + 16px;
                height: 22px;
                border-width: 1px;
                border-color: Sheet.signal;
                background: Sheet.signal-soft;
                standard-text := Text {
                    text: root.standard;
                    color: Sheet.signal-text;
                    font-size: Sheet.label-size;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Image {
            horizontal-stretch: 0;
            width: 224px;
            height: 224px;
            x: (parent.width - self.width) / 2;
            source: root.qr;
            image-fit: contain;
        }

        HorizontalLayout {
            height: 28px;
            padding-left: 12px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: root.address;
                accessible-label: root.address;
                color: Sheet.ink;
                font-family: "Cascadia Mono";
                font-size: 9px;
                vertical-alignment: center;
                overflow: elide;
            }
            CopyAction {
                label: root.copy-label;
                clicked => { root.copy(); }
            }
        }
    }
}

export component SupportWindow inherits Window {
    title: @tr("Support the developer");
    icon: @image-url("../assets/tray-icon.svg");
    width: 760px;
    height: 570px;
    background: Sheet.canvas;
    default-font-family: "Segoe UI Variable Text";

    in property <image> bnb-qr;
    in property <image> tron-qr;
    in property <string> bnb-address;
    in property <string> tron-address;
    in-out property <string> status-text;
    callback copy-bnb();
    callback copy-tron();
    callback close-requested();

    VerticalLayout {
        padding: 28px;
        spacing: 16px;

        Rectangle {
            height: 84px;
            background: Sheet.ink;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 18px;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "SayFlex";
                        color: Sheet.on-ink;
                        font-size: 24px;
                        font-weight: 720;
                    }
                    Text {
                        text: @tr("Support the developer");
                        color: Sheet.on-ink;
                        opacity: 0.68;
                        font-size: Sheet.label-size;
                        font-weight: 650;
                        letter-spacing: 1.7px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    width: 360px;
                    text: @tr("Scan or copy a public wallet address.");
                    color: Sheet.on-ink;
                    opacity: 0.78;
                    font-size: Sheet.detail-size;
                    wrap: word-wrap;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 16px;
            WalletCard {
                network: "BNB Smart Chain";
                standard: "BEP-20";
                address: root.bnb-address;
                qr: root.bnb-qr;
                copy-label: @tr("Copy BNB Smart Chain address");
                copy => {
                    root.status-text = @tr("Address copied");
                    root.copy-bnb();
                }
            }
            WalletCard {
                network: "TRON";
                standard: "TRC-20";
                address: root.tron-address;
                qr: root.tron-qr;
                copy-label: @tr("Copy TRON address");
                copy => {
                    root.status-text = @tr("Address copied");
                    root.copy-tron();
                }
            }
        }

        Rectangle {
            height: 46px;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 4px;
                    height: parent.height;
                    background: Sheet.signal;
                }
                Text {
                    horizontal-stretch: 1;
                    text: @tr("Only send assets on the network shown on the card.");
                    color: Sheet.muted;
                    font-size: Sheet.detail-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.status-text;
                    color: Sheet.signal-text;
                    font-size: Sheet.label-size;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                RowAction {
                    label: @tr("Close");
                    clicked => { root.close-requested(); }
                }
            }
        }
    }
}
