// Shared material for every floating SayFlex surface.
// Keeping this in one owner prevents preview-only UI from drifting back to the
// obsolete application-window styling while the production card evolves.
export global Theme {
    out property <brush> ink: #101114;
    out property <brush> sidebar: #0c0d10;
    out property <brush> panel: #16181c;
    out property <brush> panel-raised: #1d2025;
    out property <brush> line: #2b2e34;
    out property <brush> line-soft: #22252a;
    out property <brush> text: #f3f3f4;
    out property <brush> text-muted: #a3a6ad;
    out property <brush> text-faint: #747881;
    out property <brush> orange: #e39952;
    out property <brush> orange-soft: #e399521c;
    out property <brush> red: #d85c5c;
    out property <brush> red-soft: #d85c5c1c;
    out property <brush> acrylic: #101114e8;
    out property <brush> glass: #0c0e12c4;
    out property <brush> trace: #f5f5f2;
    out property <brush> trace-highlight: #ffffff;
    out property <brush> signal: #b8501c;
}
