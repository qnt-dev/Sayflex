// The form pages: Translation and Hotkeys.
//
// A form is label/value pairs where the value is a choice. The label says what
// the setting is; the value says what is true now, never what pressing it would
// do.

import { ListView } from "std-widgets.slint";
import { Sheet } from "sheet.slint";
import { HotkeyRow } from "rows.slint";
import { RowAction, Toggle, Stepper, MenuButton, MenuOption, ScrollRail } from "controls.slint";
import { ListHead, FormRow, ListRow, Note, GroupLabel, PageLede } from "parts.slint";

// ── Translation ──────────────────────────────────────────
export component TranslationPage inherits VerticalLayout {
    in property <bool> enabled: false;
    in property <bool> ready: false;
    in property <string> model-name;
    in property <string> engine-state;
    in property <string> delivery;
    in property <string> delivery-value;
    in property <string> text-action;
    in property <string> text-action-value;
    in property <bool> warm: false;
    in property <int> blur-radius: 3;
    in property <string> primary-language: "English";
    in property <string> primary-language-value: "en";
    in property <string> secondary-language: "Russian";
    in property <string> secondary-language-value: "ru";
    in property <string> note-text;
    in property <string> note-action;
    in property <bool> note-signal: false;

    callback set-enabled(bool);
    callback set-delivery(string);
    callback set-text-action(string);
    callback set-warm(bool);
    callback set-blur(int);
    callback set-primary-language(string);
    callback set-secondary-language(string);
    callback open-translator();
    callback note-acted();

    spacing: 0px;

    ListHead {
        index: "03 / 08";
        title: "Translation";
        lede: "Detects the selected text, then follows the Text provider order. Network providers send that text to their service; the local model keeps it here.";
        claim: root.ready ? "Ready" : "Not ready";
    }

    if root.note-text != "" : Note {
        text: root.note-text;
        action: root.note-action;
        signal: root.note-signal;
        acted => { root.note-acted(); }
    }

    FormRow {
        label: "Translation";
        hint: "Whether the selection shortcut may translate";
        Toggle {
            checked: root.enabled;
            on-label: "Enabled";
            off-label: "Disabled";
            toggled(next) => { root.set-enabled(next); }
        }
    }

    FormRow {
        label: "Model";
        hint: "Chosen on the Models page";
        Text {
            text: root.model-name == "" ? "None installed" : root.model-name;
            color: root.model-name == "" ? Sheet.signal-text : Sheet.ink;
            font-size: Sheet.body-size;
            font-weight: 650;
            vertical-alignment: center;
        }
    }

    FormRow {
        label: "Primary language";
        hint: "Foreign text is translated into this language";
        MenuButton {
            compact: true;
            text: root.primary-language;
            value: root.primary-language-value;
            options: [
                { value: "en", label: "English", note: "Primary language" },
                { value: "ru", label: "Russian", note: "Primary language" },
                { value: "uk", label: "Ukrainian", note: "Primary language" },
                { value: "es", label: "Spanish", note: "Primary language" },
                { value: "pt-BR", label: "Portuguese (Brazil)", note: "Primary language" },
                { value: "de", label: "German", note: "Primary language" },
                { value: "fr", label: "French", note: "Primary language" },
                { value: "it", label: "Italian", note: "Primary language" },
                { value: "zh-Hans", label: "Chinese (Simplified)", note: "Primary language" },
                { value: "zh-Hant", label: "Chinese (Traditional)", note: "Primary language" },
                { value: "ja", label: "Japanese", note: "Primary language" },
                { value: "ko", label: "Korean", note: "Primary language" },
                { value: "hi", label: "Hindi", note: "Primary language" },
                { value: "ar", label: "Arabic", note: "Primary language" },
            ];
            chosen(value) => { root.set-primary-language(value); }
        }
    }

    FormRow {
        label: "Secondary language";
        hint: "Primary-language text is translated into this one";
        MenuButton {
            compact: true;
            text: root.secondary-language;
            value: root.secondary-language-value;
            options: [
                { value: "en", label: "English", note: "Secondary language" },
                { value: "ru", label: "Russian", note: "Secondary language" },
                { value: "uk", label: "Ukrainian", note: "Secondary language" },
                { value: "es", label: "Spanish", note: "Secondary language" },
                { value: "pt-BR", label: "Portuguese (Brazil)", note: "Secondary language" },
                { value: "de", label: "German", note: "Secondary language" },
                { value: "fr", label: "French", note: "Secondary language" },
                { value: "it", label: "Italian", note: "Secondary language" },
                { value: "zh-Hans", label: "Chinese (Simplified)", note: "Secondary language" },
                { value: "zh-Hant", label: "Chinese (Traditional)", note: "Secondary language" },
                { value: "ja", label: "Japanese", note: "Secondary language" },
                { value: "ko", label: "Korean", note: "Secondary language" },
                { value: "hi", label: "Hindi", note: "Secondary language" },
                { value: "ar", label: "Arabic", note: "Secondary language" },
            ];
            chosen(value) => { root.set-secondary-language(value); }
        }
    }

    FormRow {
        label: "Engine";
        hint: "Faster to answer, and holds memory to be";
        Toggle {
            checked: root.warm;
            on-label: "Kept warm";
            off-label: "Started on demand";
            toggled(next) => { root.set-warm(next); }
        }
    }

    FormRow {
        label: "Result";
        hint: "What happens to it once it exists";
        MenuButton {
            compact: true;
            text: root.delivery;
            value: root.delivery-value;
            options: [
                { value: "preview", label: "Show a preview", note: "Nothing is replaced until you say so" },
                { value: "replace", label: "Replace the selection", note: "The original goes to the clipboard first" },
                { value: "copy", label: "Copy it", note: "The selection is left exactly as it was" },
            ];
            chosen(value) => { root.set-delivery(value); }
        }
    }

    FormRow {
        label: "On selected text";
        hint: "What Ctrl + Alt + F does with what it finds";
        MenuButton {
            compact: true;
            text: root.text-action;
            value: root.text-action-value;
            options: [
                { value: "adaptive", label: "Decide from the text", note: "Translates foreign text, offers layout candidates for the rest" },
                { value: "palette", label: "Always ask", note: "Shows the palette every time, whatever the text looks like" },
            ];
            chosen(value) => { root.set-text-action(value); }
        }
    }

    FormRow {
        label: "Preview blur";
        hint: "The backdrop behind the preview";
        Stepper {
            value: root.blur-radius;
            minimum: 0;
            maximum: 8;
            changed(next) => { root.set-blur(next); }
        }
    }

    HorizontalLayout {
        height: 54px;
        alignment: start;
        RowAction {
            label: "Open the translator";
            clicked => { root.open-translator(); }
        }
    }

}

// ── Hotkeys ──────────────────────────────────────────────
export component HotkeysPage inherits VerticalLayout {
    /// How far past the page's own right edge the rail sits.
    ///
    /// A scrollbar belongs at the edge of the window, not tucked against the
    /// end of the text: the shell knows how much padding stands between the two
    /// and passes it in, because a page cannot ask the window anything.
    in property <length> rail-overhang: 0px;
    in-out property <length> scroll-y: 0px;
    in-out property <length> scroll-content-height: 0px;
    out property <length> scroll-shown-height: list.visible-height;

    in property <[HotkeyRow]> rows;
    in property <string> summary;
    in property <bool> summary-signal: false;
    callback toggle-row(int, bool);
    callback set-mode(string, string);

    spacing: 0px;

    ListHead {
        index: "08 / 08";
        title: "Hotkeys";
        lede: "Held, not toggled: the action lasts exactly as long as the keys are down.";
        claim: root.summary;
        claim-signal: root.summary-signal;
    }

    // The commands are a list, and a list belongs in a ListView: a page that
    // reports a taller minimum than its neighbours makes the window resize
    // itself as you walk through the navigation.
    // The list scrolls, so it says so. A list cut off at the bottom
    // edge with nothing on it reads as a list that ends there, which
    // is how rows below the fold go unread.
    Rectangle {
        vertical-stretch: 1;

        list := ListView {
            width: 100%;
            height: 100%;
            viewport-y <=> root.scroll-y;
            viewport-height <=> root.scroll-content-height;
            // The widget's own scrollbar appears only while the pointer is
            // over it, which is no use for saying there is more below, and it
            // is drawn in the widget style rather than this one. It also keeps
            // a strip of the list's width for itself whether it is showing or
            // not, which is what pushed the rail in off the window's edge.
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;

            for row[index] in root.rows : VerticalLayout {
                spacing: 0px;

                ListRow {
                    lead: row.keys;
                    title: row.name;
                    detail: row.detail;
                    tone: row.tone;
                    controls-width: 186px;

                    Toggle {
                        checked: row.enabled;
                        on-label: "On";
                        off-label: "Off";
                        toggled(next) => { root.toggle-row(index, next); }
                    }

                    // The combination itself is fixed in this build. The button says
                    // so rather than being absent, because a page that silently omits
                    // the thing its design promised is a page that has been quietly
                    // reduced.
                    RowAction {
                        label: "Change";
                        enabled: row.locked-reason == "";
                        reason: row.locked-reason;
                    }
                }

                if row.mode != "" && row.enabled : HorizontalLayout {
                    height: 42px;
                    padding-left: 110px;
                    padding-bottom: 10px;
                    alignment: start;
                    spacing: 12px;
                    GroupLabel {
                        text: "DOES";
                        vertical-alignment: center;
                    }
                    MenuButton {
                        compact: true;
                        text: row.mode-value;
                        value: row.mode-key;
                        options: [
                            { value: "adaptive", label: "Decide from the text", note: "Translates foreign text, offers layout candidates for the rest" },
                            { value: "palette", label: "Always ask", note: "Shows the palette every time" },
                        ];
                        chosen(value) => { root.set-mode(row.mode, value); }
                    }
                }
            }

    }

        ScrollRail {
            x: parent.width + root.rail-overhang - 5px;
            y: 0;
            track: list.height;
            content: list.viewport-height;
            shown: list.height;
            offset: -list.viewport-y;
            scrolled(next) => { list.viewport-y = -next; }
        }
    }
}
