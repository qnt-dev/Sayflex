// The form pages: Translation and Hotkeys.
//
// A form is label/value pairs where the value is a choice. The label says what
// the setting is; the value says what is true now, never what pressing it would
// do.

import { ListView } from "std-widgets.slint";
import { Sheet } from "sheet.slint";
import { HotkeyRow } from "rows.slint";
import { RowAction, Toggle, Stepper, MenuButton, MenuOption, ScrollRail } from "controls.slint";
import { ListHead, FormRow, ListRow, Note, GroupLabel, PageLede } from "parts.slint";

// ── Translation ──────────────────────────────────────────
export component TranslationPage inherits VerticalLayout {
    in property <bool> enabled: false;
    in property <bool> ready: false;
    in property <string> model-name;
    in property <string> engine-state;
    in property <string> delivery;
    in property <string> delivery-value;
    in property <string> text-action;
    in property <string> text-action-value;
    in property <bool> warm: false;
    in property <int> blur-radius: 3;
    in property <string> primary-language: "English";
    in property <string> primary-language-value: "en";
    in property <string> secondary-language: "Russian";
    in property <string> secondary-language-value: "ru";
    in property <string> note-text;
    in property <string> note-action;
    in property <bool> note-signal: false;

    callback set-enabled(bool);
    callback set-delivery(string);
    callback set-text-action(string);
    callback set-warm(bool);
    callback set-blur(int);
    callback set-primary-language(string);
    callback set-secondary-language(string);
    callback open-translator();
    callback note-acted();

    spacing: 0px;

    ListHead {
        index: "03 / 08";
        title: @tr("Translation");
        lede: @tr("Detects the selected text, then follows the Text provider order. Network providers send that text to their service; the local model keeps it here.");
        claim: root.ready ? @tr("Ready") : @tr("Not ready");
    }

    if root.note-text != "" : Note {
        text: root.note-text;
        action: root.note-action;
        signal: root.note-signal;
        acted => { root.note-acted(); }
    }

    FormRow {
        label: @tr("Translation");
        hint: @tr("Whether the selection shortcut may translate");
        Toggle {
            checked: root.enabled;
            on-label: @tr("Enabled");
            off-label: @tr("Disabled");
            toggled(next) => { root.set-enabled(next); }
        }
    }

    FormRow {
        label: @tr("Model");
        hint: @tr("Chosen on the Models page");
        Text {
            text: root.model-name == "" ? @tr("None installed") : root.model-name;
            color: root.model-name == "" ? Sheet.signal-text : Sheet.ink;
            font-size: Sheet.body-size;
            font-weight: 650;
            vertical-alignment: center;
        }
    }

    FormRow {
        label: @tr("Primary language");
        hint: @tr("Foreign text is translated into this language");
        MenuButton {
            compact: true;
            text: root.primary-language;
            value: root.primary-language-value;
            current-index: root.primary-language-value == "en" ? 0
                : root.primary-language-value == "ru" ? 1
                : root.primary-language-value == "uk" ? 2
                : root.primary-language-value == "es" ? 3
                : root.primary-language-value == "pt-BR" ? 4
                : root.primary-language-value == "de" ? 5
                : root.primary-language-value == "fr" ? 6
                : root.primary-language-value == "it" ? 7
                : root.primary-language-value == "zh-Hans" ? 8
                : root.primary-language-value == "zh-Hant" ? 9
                : root.primary-language-value == "ja" ? 10
                : root.primary-language-value == "ko" ? 11
                : root.primary-language-value == "hi" ? 12 : 13;
            options: [
                { value: "en", label: @tr("English"), note: @tr("Primary language") },
                { value: "ru", label: @tr("Russian"), note: @tr("Primary language") },
                { value: "uk", label: @tr("Ukrainian"), note: @tr("Primary language") },
                { value: "es", label: @tr("Spanish"), note: @tr("Primary language") },
                { value: "pt-BR", label: @tr("Portuguese (Brazil)"), note: @tr("Primary language") },
                { value: "de", label: @tr("German"), note: @tr("Primary language") },
                { value: "fr", label: @tr("French"), note: @tr("Primary language") },
                { value: "it", label: @tr("Italian"), note: @tr("Primary language") },
                { value: "zh-Hans", label: @tr("Chinese (Simplified)"), note: @tr("Primary language") },
                { value: "zh-Hant", label: @tr("Chinese (Traditional)"), note: @tr("Primary language") },
                { value: "ja", label: @tr("Japanese"), note: @tr("Primary language") },
                { value: "ko", label: @tr("Korean"), note: @tr("Primary language") },
                { value: "hi", label: @tr("Hindi"), note: @tr("Primary language") },
                { value: "ar", label: @tr("Arabic"), note: @tr("Primary language") },
            ];
            chosen(value) => { root.set-primary-language(value); }
        }
    }

    FormRow {
        label: @tr("Secondary language");
        hint: @tr("Primary-language text is translated into this one");
        MenuButton {
            compact: true;
            text: root.secondary-language;
            value: root.secondary-language-value;
            current-index: root.secondary-language-value == "en" ? 0
                : root.secondary-language-value == "ru" ? 1
                : root.secondary-language-value == "uk" ? 2
                : root.secondary-language-value == "es" ? 3
                : root.secondary-language-value == "pt-BR" ? 4
                : root.secondary-language-value == "de" ? 5
                : root.secondary-language-value == "fr" ? 6
                : root.secondary-language-value == "it" ? 7
                : root.secondary-language-value == "zh-Hans" ? 8
                : root.secondary-language-value == "zh-Hant" ? 9
                : root.secondary-language-value == "ja" ? 10
                : root.secondary-language-value == "ko" ? 11
                : root.secondary-language-value == "hi" ? 12 : 13;
            options: [
                { value: "en", label: @tr("English"), note: @tr("Secondary language") },
                { value: "ru", label: @tr("Russian"), note: @tr("Secondary language") },
                { value: "uk", label: @tr("Ukrainian"), note: @tr("Secondary language") },
                { value: "es", label: @tr("Spanish"), note: @tr("Secondary language") },
                { value: "pt-BR", label: @tr("Portuguese (Brazil)"), note: @tr("Secondary language") },
                { value: "de", label: @tr("German"), note: @tr("Secondary language") },
                { value: "fr", label: @tr("French"), note: @tr("Secondary language") },
                { value: "it", label: @tr("Italian"), note: @tr("Secondary language") },
                { value: "zh-Hans", label: @tr("Chinese (Simplified)"), note: @tr("Secondary language") },
                { value: "zh-Hant", label: @tr("Chinese (Traditional)"), note: @tr("Secondary language") },
                { value: "ja", label: @tr("Japanese"), note: @tr("Secondary language") },
                { value: "ko", label: @tr("Korean"), note: @tr("Secondary language") },
                { value: "hi", label: @tr("Hindi"), note: @tr("Secondary language") },
                { value: "ar", label: @tr("Arabic"), note: @tr("Secondary language") },
            ];
            chosen(value) => { root.set-secondary-language(value); }
        }
    }

    FormRow {
        label: @tr("Engine");
        hint: @tr("Faster to answer, and holds memory to be");
        Toggle {
            checked: root.warm;
            on-label: @tr("Kept warm");
            off-label: @tr("Started on demand");
            toggled(next) => { root.set-warm(next); }
        }
    }

    FormRow {
        label: @tr("Result");
        hint: @tr("What happens to it once it exists");
        MenuButton {
            compact: true;
            text: root.delivery;
            value: root.delivery-value;
            current-index: root.delivery-value == "preview" ? 0
                : root.delivery-value == "replace" ? 1 : 2;
            options: [
                { value: "preview", label: @tr("Show a preview"), note: @tr("Nothing is replaced until you say so") },
                { value: "replace", label: @tr("Replace the selection"), note: @tr("The original goes to the clipboard first") },
                { value: "copy", label: @tr("Copy it"), note: @tr("The selection is left exactly as it was") },
            ];
            chosen(value) => { root.set-delivery(value); }
        }
    }

    FormRow {
        label: @tr("On selected text");
        hint: @tr("What Ctrl + Alt + F does with what it finds");
        MenuButton {
            compact: true;
            text: root.text-action;
            value: root.text-action-value;
            current-index: root.text-action-value == "adaptive" ? 0 : 1;
            options: [
                { value: "adaptive", label: @tr("Decide from the text"), note: @tr("Translates foreign text, offers layout candidates for the rest") },
                { value: "palette", label: @tr("Always ask"), note: @tr("Shows the palette every time, whatever the text looks like") },
            ];
            chosen(value) => { root.set-text-action(value); }
        }
    }

    FormRow {
        label: @tr("Preview blur");
        hint: @tr("The backdrop behind the preview");
        Stepper {
            value: root.blur-radius;
            minimum: 0;
            maximum: 8;
            changed(next) => { root.set-blur(next); }
        }
    }

    HorizontalLayout {
        height: 54px;
        alignment: start;
        RowAction {
            label: @tr("Open the translator");
            clicked => { root.open-translator(); }
        }
    }

}

// ── Hotkeys ──────────────────────────────────────────────
export component HotkeysPage inherits VerticalLayout {
    /// How far past the page's own right edge the rail sits.
    ///
    /// A scrollbar belongs at the edge of the window, not tucked against the
    /// end of the text: the shell knows how much padding stands between the two
    /// and passes it in, because a page cannot ask the window anything.
    in property <length> rail-overhang: 0px;
    in-out property <length> scroll-y: 0px;
    in-out property <length> scroll-content-height: 0px;
    out property <length> scroll-shown-height: list.visible-height;

    in property <[HotkeyRow]> rows;
    in property <string> summary;
    in property <bool> summary-signal: false;
    in property <int> capture-index: -1;
    in property <string> capture-label: "";
    callback toggle-row(int, bool);
    callback change-row(int);
    callback reset-row(int);
    callback cancel-capture();
    callback set-mode(string, string);

    spacing: 0px;

    ListHead {
        index: "08 / 08";
        title: @tr("Hotkeys");
        lede: @tr("Change a shortcut, then press its new key combination. Changes apply only after Windows accepts them.");
        claim: root.summary;
        claim-signal: root.summary-signal;
    }

    // The commands are a list, and a list belongs in a ListView: a page that
    // reports a taller minimum than its neighbours makes the window resize
    // itself as you walk through the navigation.
    // The list scrolls, so it says so. A list cut off at the bottom
    // edge with nothing on it reads as a list that ends there, which
    // is how rows below the fold go unread.
    Rectangle {
        vertical-stretch: 1;

        if root.capture-index >= 0 : Rectangle {
            z: 2;
            x: 0;
            y: 0;
            width: parent.width;
            height: 46px;
            background: Sheet.ink;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    text: @tr("PRESS SHORTCUT  ·  ") + root.capture-label + "  ·  ESC CANCELS";
                    color: Sheet.on-ink;
                    font-size: Sheet.label-size;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                RowAction {
                    label: @tr("Cancel");
                    clicked => { root.cancel-capture(); }
                }
            }
        }

        list := ListView {
            y: root.capture-index >= 0 ? 54px : 0px;
            width: 100%;
            height: parent.height - self.y;
            viewport-y <=> root.scroll-y;
            viewport-height <=> root.scroll-content-height;
            // The widget's own scrollbar appears only while the pointer is
            // over it, which is no use for saying there is more below, and it
            // is drawn in the widget style rather than this one. It also keeps
            // a strip of the list's width for itself whether it is showing or
            // not, which is what pushed the rail in off the window's edge.
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;

            for row[index] in root.rows : VerticalLayout {
                spacing: 0px;

                ListRow {
                    lead: row.keys;
                    title: row.name;
                    detail: row.detail;
                    tone: row.tone;
                    controls-width: 246px;

                    Toggle {
                        checked: row.enabled;
                        enabled: row.toggle-enabled;
                        on-label: @tr("On");
                        off-label: @tr("Off");
                        toggled(next) => { root.toggle-row(index, next); }
                    }

                    // Capture belongs to the row, so a registration failure can name
                    // the exact shortcut and still leave Change available as recovery.
                    RowAction {
                        label: @tr("Change");
                        enabled: row.locked-reason == "";
                        reason: row.locked-reason;
                        clicked => { root.change-row(index); }
                    }

                    RowAction {
                        label: @tr("Reset");
                        enabled: !row.is-default && row.locked-reason == "";
                        reason: row.is-default ? @tr("Already using the default") : row.locked-reason;
                        clicked => { root.reset-row(index); }
                    }
                }

                if row.mode != "" && row.enabled : HorizontalLayout {
                    height: 42px;
                    padding-left: 110px;
                    padding-bottom: 10px;
                    alignment: start;
                    spacing: 12px;
                    GroupLabel {
                        text: @tr("DOES");
                        vertical-alignment: center;
                    }
                    MenuButton {
                        compact: true;
                        text: row.mode-value;
                        value: row.mode-key;
                        current-index: row.mode-key == "adaptive" ? 0 : 1;
                        options: [
                            { value: "adaptive", label: @tr("Decide from the text"), note: @tr("Translates foreign text, offers layout candidates for the rest") },
                            { value: "palette", label: @tr("Always ask"), note: @tr("Shows the palette every time") },
                        ];
                        chosen(value) => { root.set-mode(row.mode, value); }
                    }
                }
            }

    }

        ScrollRail {
            x: parent.width + root.rail-overhang - 5px;
            y: 0;
            track: list.height;
            content: list.viewport-height;
            shown: list.height;
            offset: -list.viewport-y;
            scrolled(next) => { list.viewport-y = -next; }
        }
    }
}
