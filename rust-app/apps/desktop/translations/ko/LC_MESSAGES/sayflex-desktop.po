msgstr "{provider}의 키를 저장하는 중…"

msgid "That key cannot be used as a global shortcut."
msgstr "해당 키는 전역 단축키로 사용할 수 없습니다."

msgid "The endpoint must be HTTPS: the key and the audio both travel in this request."
msgstr "엔드포인트는 HTTPS여야 합니다. 이 요청에서는 키와 오디오가 모두 이동합니다."

msgid "The key could not be removed: {error}"
msgstr "키를 제거할 수 없습니다: {error}"

msgid "The key could not be sent to the worker: {error}"
msgstr "작업자에게 키를 보낼 수 없습니다: {error}"

msgid "The key for {provider} has been removed."
msgstr "{provider}의 키가 제거되었습니다."

msgid "The key for {provider} is stored."
msgstr "{provider}의 키가 저장됩니다."

msgid "The latest dictation was cancelled and cannot be inserted."
msgstr "최근 받아쓰기가 취소되어 삽입할 수 없습니다."

msgid "The microphone and transcription keep working; only the overlay is disabled."
msgstr "마이크와 녹음은 계속 작동합니다. 오버레이만 비활성화됩니다."

msgid "The pause/resume recovery shortcut must stay enabled."
msgstr "복구 일시 중지/재개 바로가기는 활성화된 상태로 유지되어야 합니다."

msgid "The spectrum wrapped into a ring"
msgstr "스펙트럼은 고리에 싸여 있다"

msgid "The translation order could not be applied: {error}"
msgstr "번역 순서를 적용할 수 없습니다: {error}"

msgid "The words as they are recognised"
msgstr "인식되는 단어"

msgid "Thirty-two bands, thirty-one times a second"
msgstr "32개의 밴드, 1초에 31번"

msgid "Use a letter, number, function key, Space, Tab, Enter, or arrow key."
msgstr "문자, 숫자, 기능 키, Space, Tab, Enter 또는 화살표 키를 사용하세요."

msgid "Visualizer updated. The next dictation uses the selected style."
msgstr "시각화 도구가 업데이트되었습니다. 다음 받아쓰기에서는 선택한 스타일을 사용합니다."

msgid "Warming up on {backend}. If it fails, the search moves to the next one down."
msgstr "{backend} 워밍업 중입니다. 실패하면 검색이 다음 아래로 이동합니다."

msgid "Writing Slate surface updated for the next dictation."
msgstr "다음 받아쓰기를 위해 쓰기 슬레이트 표면이 업데이트되었습니다."

msgid "Worker restarted automatically."
msgstr "작업 프로세스가 자동으로 다시 시작되었습니다."

msgid "Worker restart failed. See the diagnostic log for details."
msgstr "작업 프로세스를 다시 시작하지 못했습니다. 자세한 내용은 진단 로그를 확인하세요."

msgid "The latest dictation could not be inserted."
msgstr "최신 받아쓰기를 삽입하지 못했습니다."

msgid "No answer arrived from the worker, so whether the key was stored is not known yet. The row will show the stored state when the worker answers; sending again is safe."
msgstr "작업 프로세스가 응답하지 않아 키가 저장되었는지 아직 알 수 없습니다. 응답하면 행에 실제 저장 상태가 표시되며 다시 보내도 안전합니다."

msgid "{provider} did not confirm the key."
msgstr "{provider}에서 키를 확인하지 않았습니다."

msgid "The worker stopped before confirming the key. The row will show the stored state after recovery."
msgstr "키를 확인하기 전에 작업 프로세스가 중지되었습니다. 복구 후 행에 저장된 상태가 표시됩니다."

msgid "{provider} did not accept the key."
msgstr "{provider}에서 키를 수락하지 않았습니다."
