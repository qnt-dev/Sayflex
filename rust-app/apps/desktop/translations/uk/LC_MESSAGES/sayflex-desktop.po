msgstr "Помилка робочого процесу"

msgid "Worker mismatch"
msgstr "Версії процесів не збігаються"

msgid "Worker restart failed. See the diagnostic log for details."
msgstr "Не вдалося перезапустити робочий процес. Докладніше дивіться в журналі діагностики."

msgid "Worker restarted automatically."
msgstr "Робочий процес автоматично перезапущено."

msgid "Worker unavailable"
msgstr "Робочий процес недоступний"

msgid "Writing slate"
msgstr "Панель письма"

msgid "Writing Slate surface updated for the next dictation."
msgstr "Поверхню Slate для письма оновлено для наступного диктування."

msgid "Yes"
msgstr "Так"

msgid "{provider} rejected the API key. Check or replace it in Providers."
msgstr "{provider} відхилив API-ключ. Перевірте або замініть його в розділі «Провайдери»."

msgid "{provider} needs different settings. Check it in Providers."
msgstr "Для {provider} потрібні інші налаштування. Перевірте розділ «Провайдери»."

msgid "{provider} has no quota left."
msgstr "Квота {provider} вичерпана."

msgid "{provider} is temporarily rate limited."
msgstr "Тимчасово обмежено частоту запитів до {provider}."

msgid "{provider} did not answer in time."
msgstr "{provider} не відповів вчасно."

msgid "{provider} is unavailable."
msgstr "{provider} зараз недоступний."

msgid "{provider} does not support this translation request."
msgstr "{provider} не підтримує такий запит на переклад."

msgid "{provider} rejected this translation request."
msgstr "{provider} відхилив запит на переклад."

msgid "{provider} returned an empty translation."
msgstr "{provider} повернув порожній переклад."

msgid "Translation completed with {provider}."
msgstr "Переклад виконано через {provider}."

msgid "No translation provider is available. Enable a local model or a cloud provider in Settings."
msgstr "Немає доступного перекладача. Увімкніть локальну модель або хмарний сервіс у налаштуваннях."

msgid "The local translation model is not installed or ready. Choose a model in Settings."
msgstr "Локальну модель перекладу не встановлено або вона ще не готова. Виберіть модель у налаштуваннях."

msgid "Translation failed. Try again or check Providers."
msgstr "Не вдалося виконати переклад. Спробуйте ще раз або перевірте розділ «Провайдери»."

msgid "Quick translation"
msgstr "Швидкий переклад"

msgid "Welcome to SayFlex"
msgstr "Ласкаво просимо до SayFlex"

msgid "FIRST START"
msgstr "ПЕРШИЙ ЗАПУСК"

msgid "Your choice controls the download"
msgstr "Завантаження залежить від вашого вибору"

msgid "Set up local dictation"
msgstr "Налаштуйте локальне розпізнавання мовлення"

msgid "SayFlex can transcribe speech on this computer. The recommended model keeps audio on the device and can be removed later in Models."
msgstr "SayFlex може розпізнавати мовлення на цьому комп’ютері. Рекомендована модель не надсилає аудіо в хмару; її можна видалити пізніше в розділі «Моделі»."

msgid "Download the recommended local model"
msgstr "Завантажити рекомендовану локальну модель"

msgid "Download {} ({})"
msgstr "Завантажити {} ({})"

msgid "Starts only after you press Continue"
msgstr "Завантаження почнеться лише після натискання «Продовжити»"

msgid "No model will be downloaded; you can configure a cloud provider instead"
msgstr "Модель не буде завантажена; натомість можна налаштувати хмарний сервіс"

msgid "Nothing is downloaded before confirmation. You can change this choice later in Providers and Models."
msgstr "До підтвердження нічого не завантажується. Пізніше вибір можна змінити в розділах «Провайдери» та «Моделі»."

msgid "Closing this window leaves SayFlex unconfigured."
msgstr "Якщо закрити це вікно, початкове налаштування SayFlex не буде завершено."

msgid "Continue"
msgstr "Продовжити"

msgid "Support the developer"
msgstr "Підтримати розробника"

msgid "Translate (Ctrl+Enter)"
msgstr "Перекласти (Ctrl+Enter)"

msgid "Pulse matrix"
msgstr "Матриця імпульсів"

msgid "Dots surface in waves with your voice"
msgstr "Крапки з’являються хвилями в такт вашому голосу"

msgid "Cyan"
msgstr "Ціанова"

msgid "Graphite and silver"
msgstr "Графіт і срібло"

msgid "Red and amber"
msgstr "Червоно-бурштинова"

msgid "Pulse Matrix palette updated for the next dictation."
msgstr "Палітра «Матриці імпульсів» застосовуватиметься під час наступного диктування."

msgid "Scan or copy a public wallet address."
msgstr "Відскануйте QR-код або скопіюйте публічну адресу."

msgid "Only send assets on the network shown on the card."
msgstr "Надсилайте кошти лише через мережу, зазначену на картці."

msgid "Copy BNB Smart Chain address"
msgstr "Скопіювати адресу BNB Smart Chain"

msgid "Copy TRON address"
msgstr "Скопіювати адресу TRON"

msgid "Address copied"
msgstr "Адресу скопійовано"

msgid "Close"
msgstr "Закрити"

msgid "Screen capture is unavailable. Try again."
msgstr "Захоплення екрана недоступне. Спробуйте ще раз."

msgid "This content is protected and cannot be captured."
msgstr "Цей вміст захищено, тому його не можна захопити."

msgid "Select an area that contains text."
msgstr "Виділіть область, що містить текст."

msgid "No readable text was found in the selected area."
msgstr "У виділеній області не знайдено читабельного тексту."

msgid "The local screen-reading model is not installed. Install it in Models."
msgstr "Локальну модель розпізнавання тексту на екрані не встановлено. Установіть її в розділі «Моделі»."

msgid "This language is not available for local screen reading."
msgstr "Ця мова недоступна для локального розпізнавання тексту на екрані."

msgid "Screen text recognition stopped unexpectedly. Try again."
msgstr "Розпізнавання тексту на екрані несподівано зупинилося. Спробуйте ще раз."

msgid "Screen translation was cancelled."
msgstr "Переклад з екрана скасовано."
msgid "Resources"
msgstr "Ресурси"

msgid "Live resource use by function."
msgstr "Поточне використання ресурсів за функціями."

msgid "Unload"
msgstr "Вивантажити"

msgid "Free all memory"
msgstr "Звільнити всю пам’ять"

msgid "Not loaded"
msgstr "Не завантажено"

msgid "Working"
msgstr "Працює"

msgid "Releasing…"
msgstr "Вивантаження…"

msgid "Unloading only frees working memory. The selected models remain installed. The next time you use a function, SayFlex loads its model automatically and the function continues normally."
msgstr "Вивантаження лише звільняє робочу пам’ять. Вибрані моделі залишаються встановленими. Під час наступного використання функції SayFlex автоматично завантажить її модель, і функція працюватиме як зазвичай."
msgid "Russian and English · CPU-only · no GPU memory."
msgstr "Російська й англійська · лише CPU · без відеопам’яті."

msgid "FAST LANGUAGE PACKAGES"
msgstr "ШВИДКІ МОВНІ ПАКЕТИ"

msgid "CONTEXTUAL TRANSLATION MODELS"
msgstr "КОНТЕКСТНІ МОДЕЛІ ПЕРЕКЛАДУ"

msgid "Russian ↔ English"
msgstr "Російська ↔ англійська"

msgid "Small language package: fast, CPU-only, and no GPU memory."
msgstr "Невеликий мовний пакет: швидкий, працює лише на процесорі й не використовує відеопам’ять."

msgid "Contextual model: broader language coverage, with higher RAM and possible GPU use."
msgstr "Контекстна модель: більше мов, але вище споживання оперативної пам’яті та можливе використання відеокарти."

msgid "Download {model} ({size}) to translate this language pair."
msgstr "Завантажте {model} ({size}), щоб перекладати цю мовну пару."

msgid "Download model"
msgstr "Завантажити модель"
